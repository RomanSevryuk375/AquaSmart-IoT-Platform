{
    "Serilog": {
        "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Elasticsearch" ],
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning",
                "Microsoft.Hosting.Lifetime": "Information",
                "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
            }
        },
        "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId", "WithExceptionDetails" ],
        "Properties": {
            "Application": "AquaSmart.IdentityService"
        },
        "WriteTo": [
            {
                "Name": "Console"
            },
            {
                "Name": "Elasticsearch",
                "Args": {
                    "nodeUris": "http://elasticsearch:9200",
                    "indexFormat": "aquasmart-logs-{0:yyyy.MM.dd}",
                    "autoRegisterTemplate": true,
                    "numberOfShards": 2,
                    "numberOfReplicas": 1
                }
            }
        ]
    },
    "ConnectionStrings": {
        "IdentityDbContext": "Host=localhost;Port=5432;Database=identity_db;Username=",
        "Redis": "localhost:6379"
    },
    "TelegramBotOptions": {
        "Name": "Aquaaaaa_Smart_bot",
        "BotSecretKey": "super-secret-m2m-key-between-bot-and-identity-service"
    },
    "JwtOptions": {
        "SecretKey": "",
        "Issuer": "AquaSmart.Identity",
        "Audience": "AquaSmart.Gateway",
        "ExpiresHours": 12
    },
    "RabbitMqOptions": {
        "Host": "amqp://localhost:5672",
        "UserName": ""
    },
    "Outbox": {
        "IntervalSeconds": 1,
        "BatchSize": 50,
        "MaxRetries": 5,
        "RetentionDays": 7,
        "CleanupIntervalHours": 24
    }
}

