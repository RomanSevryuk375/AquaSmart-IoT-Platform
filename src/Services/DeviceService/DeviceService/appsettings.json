{
    "Serilog": {
        "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Elasticsearch" ],
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning",
                "Microsoft.Hosting.Lifetime": "Information",
                "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
            }
        },
        "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId", "WithExceptionDetails" ],
        "Properties": {
            "Application": "AquaSmart.DeviceService"
        },
        "WriteTo": [
            {
                "Name": "Console"
            },
            {
                "Name": "Elasticsearch",
                "Args": {
                    "nodeUris": "http://localhost:9200",
                    "indexFormat": "aquasmart-logs-{0:yyyy.MM.dd}",
                    "autoRegisterTemplate": true,
                    "numberOfShards": 2,
                    "numberOfReplicas": 1
                }
            }
        ]
    },
    "ElasticConfiguration": {
        "Uri": "http://localhost:9200"
    },
    "ConnectionStrings": {
        "DeviceDbContext": "Host=localhost;Port=5432;Database=device_db;Username=",
        "Redis": "localhost:6379"
    },
    "JwtOptions": {
        "SecretKey": "",
        "Issuer": "AquaSmart.Identity",
        "Audience": "AquaSmart.Gateway",
        "ExpiresHours": 12
    },
    "RabbitMqOptions": {
        "Host": "amqp://localhost:5672",
        "UserName": ""
    },
    "Outbox": {
        "IntervalSeconds": 1,
        "BatchSize": 50,
        "MaxRetries": 5,
        "RetentionDays": 7,
        "CleanupIntervalHours": 24
    },
    "DeviceSettings": {
        "CommandTtlMinutes": 10,
        "DefaultSendIntervalMs": 10000,
        "MaxConfigBatchSize": 50,
        "TokenHmacSecret": "dev-device-hmac-secret-key-must-be-32-chars-minimum"
    },
    "BackgroundJobs": {
        "OutboxProcessorIntervalSeconds": 1,
        "OfflineCheckerIntervalSeconds": 60,
        "DeleteCompletedCommandsIntervalHours": 3
    },
    "AllowedHosts": "*",
    "Kestrel": {
        "Endpoints": {
            "Http": {
                "Url": "http://+:8080",
                "Protocols": "Http1AndHttp2"
            }
        }
    }
}

