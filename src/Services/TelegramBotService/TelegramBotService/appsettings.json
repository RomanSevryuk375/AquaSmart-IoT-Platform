{
    "Serilog": {
        "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Elasticsearch" ],
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning",
                "Microsoft.Hosting.Lifetime": "Information",
                "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
            }
        },
        "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId", "WithExceptionDetails" ],
        "Properties": {
            "Application": "AquaSmart.IdentityService"
        },
        "WriteTo": [
            {
                "Name": "Console"
            },
            {
                "Name": "Elasticsearch",
                "Args": {
                    "nodeUris": "http://elasticsearch:9200",
                    "indexFormat": "aquasmart-logs-{0:yyyy.MM.dd}",
                    "autoRegisterTemplate": true,
                    "numberOfShards": 2,
                    "numberOfReplicas": 1
                }
            }
        ]
    },
    "TelegramBotOptions": {
        "Name": "Aquaaaaa_Smart_bot",
        "BotToken": "",
        "BotSecretKey": ""
    },
    "Services": {
        "IdentityUrl": "http://identity-api:8080",
        "GatewayUrl": "http://api-gateway:8080"
    },
    "ConnectionStrings": {
        "Redis": "redis:6379"
    },
    "AllowedHosts": "*"
}
