{
    "Serilog": {
        "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Elasticsearch" ],
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning",
                "Microsoft.Hosting.Lifetime": "Information",
                "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
            }
        },
        "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId", "WithExceptionDetails" ],
        "Properties": {
            "Application": "AquaSmart.TelemetryService"
        },
        "WriteTo": [
            { "Name": "Console" },
            {
                "Name": "Elasticsearch",
                "Args": {
                    "nodeUris": "http://elasticsearch:9200",
                    "indexFormat": "aquasmart-logs-{0:yyyy.MM.dd}",
                    "autoRegisterTemplate": true,
                    "numberOfShards": 2,
                    "numberOfReplicas": 1
                }
            }
        ]
    },
    "ElasticConfiguration": {
        "Uri": "http://elasticsearch:9200"
    },
    "GrpcConfiguration": {
        "DeviceServiceUrl": "http://device-api:50051"
    },
    "AllowedHosts": "*",
    "ConnectionStrings": {
        "TelemetryDbContext": "Host=localhost;Port=5432;Database=telemetry_db;Username=",
        "Redis": "localhost:6379"
    },
    "JwtOptions": {
        "SecretKey": "",
        "Issuer": "AquaSmart.Identity",
        "Audience": "AquaSmart.Gateway",
        "ExpiresHours": 12
    },
    "RabbitMqOptions": {
        "Host": "amqp://localhost:5672",
        "UserName": ""
    },
    "Outbox": {
        "IntervalSeconds": 1,
        "BatchSize": 50,
        "MaxRetries": 5,
        "RetentionDays": 7,
        "CleanupIntervalHours": 24
    },
    "TelemetrySettings": {
        "MaxLiveTimeForRawDataInHours": -24,
        "MaxLiveTimeForMinutesDataInDayes": -7,
        "MaxLiveTimeForHourseDataInDayes": -90
    }
}

