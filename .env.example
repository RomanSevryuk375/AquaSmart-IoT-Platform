# Database Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_HOST_AUTH_METHOD=trust

# Message Broker Credentials
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=your_rabbitmq_password_here

# MinIO / Object Storage Credentials
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=your_minio_password_here
MINIO_BUCKET_NAME=aquasmart-firmware-bucket
AWS_REGION=us-east-1

# JWT Authentication
JWT_SECRET_KEY=your_jwt_secret_key_must_be_at_least_32_characters_long
JWT_ISSUER=AquaSmart.Identity
JWT_AUDIENCE=AquaSmart.Gateway
JWT_EXPIRES_HOURS=12

# Notification Service Settings
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USERNAME=your_email_username_here
EMAIL_PASSWORD=your_email_password_here
EMAIL_FROM=noreply@example.com
# Device Service — M2M HMAC secret (must be 32+ chars, rotate on breach)
DeviceSettings__TokenHmacSecret=your_secret_key_here

# Telegram bot settings
TelegramBotOptions__BotSecretKey=your_telegram_options_bot_secret_key_here
TelegramBotOptions__BotToken=your_telegram_options_bot_token_here
