<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Figma Design Palette (Colors/Primary/*) -->
    <Color x:Key="Primary">#4152B0</Color>
    <Color x:Key="Primary50">#EDEFFB</Color>
    <Color x:Key="Primary100">#D9DFF7</Color>
    <Color x:Key="Primary200">#B9C4F0</Color>
    <Color x:Key="Primary500">#5364C7</Color>
    <Color x:Key="Primary600">#4152B0</Color>
    <Color x:Key="Primary700">#334193</Color>
    <Color x:Key="PrimaryDark">#2E3A7E</Color>
    <Color x:Key="PrimaryDarkText">#242424</Color>
    
    <!-- Figma Accent & Status Colors -->
    <Color x:Key="MascotBg">#DCE2F9</Color>
    <Color x:Key="MascotBadgeGreen">#7BA028</Color>
    <Color x:Key="AmberWarningBg">#FEF3D6</Color>
    <Color x:Key="AmberWarningText">#B45309</Color>
    <Color x:Key="AmberWarningBorder">#FDE68A</Color>
    <Color x:Key="SuccessBg">#E8F5E9</Color>
    <Color x:Key="SuccessText">#2E7D32</Color>
    <Color x:Key="ErrorRed">#E53935</Color>
    <Color x:Key="ErrorRedBg">#FDE8E8</Color>
    <Color x:Key="InputBorder">#E4E7F4</Color>
    
    <!-- Semantic Theme Colors (Support Light & Dark mode seamlessly) -->
    <Color x:Key="PageBgLight">#F6F7FC</Color>
    <Color x:Key="PageBgDark">#12131A</Color>
    <Color x:Key="PageWhiteBgLight">#FFFFFF</Color>
    <Color x:Key="PageWhiteBgDark">#161822</Color>

    <Color x:Key="CardBgLight">#FFFFFF</Color>
    <Color x:Key="CardBgDark">#1E202C</Color>
    <Color x:Key="CardSubtleBgLight">#F6F7FC</Color>
    <Color x:Key="CardSubtleBgDark">#252837</Color>

    <Color x:Key="CardBorderLight">#E4E7F4</Color>
    <Color x:Key="CardBorderDark">#2C2F42</Color>
    <Color x:Key="SeparatorLight">#F0F2F9</Color>
    <Color x:Key="SeparatorDark">#252838</Color>

    <Color x:Key="TextPrimaryLight">#141414</Color>
    <Color x:Key="TextPrimaryDark">#F4F5FB</Color>
    <Color x:Key="TextSecondaryLight">#6E6E6E</Color>
    <Color x:Key="TextSecondaryDark">#9FA3B8</Color>
    <Color x:Key="TextMutedLight">#8C93A8</Color>
    <Color x:Key="TextMutedDark">#7E839B</Color>

    <Color x:Key="InputBgLight">#FFFFFF</Color>
    <Color x:Key="InputBgDark">#222432</Color>
    <Color x:Key="InputBorderLight">#E4E7F4</Color>
    <Color x:Key="InputBorderDark">#32364B</Color>
    
    <Color x:Key="Secondary">#EDEFFB</Color>
    <Color x:Key="SecondaryDarkText">#4152B0</Color>
    <Color x:Key="Tertiary">#2E3A7E</Color>
    
    <Color x:Key="MidnightBlue">#2E3A7E</Color>
    <Color x:Key="Magenta">#4152B0</Color>

    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>
    <Color x:Key="OffBlack">#1F1F1F</Color>

    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="Primary50Brush" Color="{StaticResource Primary50}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="MidnightBlueBrush" Color="{StaticResource MidnightBlue}"/>
    <SolidColorBrush x:Key="MagentaBrush" Color="{StaticResource Magenta}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>