<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Mobile"
    xmlns:views="clr-namespace:Mobile.Views"
    xmlns:vm="clr-namespace:Mobile.ViewModels"
    xmlns:converters="clr-namespace:Mobile.Converters"
    xmlns:loc="clr-namespace:Mobile.Converters"
    x:DataType="vm:AppShellViewModel"
    Shell.FlyoutBehavior="Flyout"
    FlyoutBackgroundColor="{AppThemeBinding Light='#FFFFFF', Dark='#161824'}"
    FlyoutWidth="280"
    Shell.BackgroundColor="{AppThemeBinding Light='#FFFFFF', Dark='#161824'}"
    Shell.ForegroundColor="{AppThemeBinding Light='#141414', Dark='#F4F5FB'}"
    Shell.TitleColor="{AppThemeBinding Light='#141414', Dark='#F4F5FB'}"
    Shell.NavBarHasShadow="False"
    Shell.TabBarBackgroundColor="{AppThemeBinding Light='#FFFFFF', Dark='#161824'}"
    Shell.TabBarForegroundColor="#4152B0"
    Shell.TabBarUnselectedColor="{AppThemeBinding Light='#8C93A8', Dark='#73778F'}"
    Shell.TabBarTitleColor="#4152B0"
    Title="AquaSmart">

    <Shell.Resources>
        <ResourceDictionary>
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
        </ResourceDictionary>
    </Shell.Resources>

    <Shell.FlyoutHeader>
        <Grid BackgroundColor="#4152B0"
              Padding="24,40,24,24"
              RowDefinitions="Auto,Auto,Auto,Auto"
              RowSpacing="6">
            <Border StrokeThickness="2"
                    Stroke="#FFFFFF"
                    StrokeShape="RoundRectangle 28"
                    BackgroundColor="#2E3A7E"
                    HeightRequest="56"
                    WidthRequest="56"
                    HorizontalOptions="Start">
                <Grid>
                    <Image Source="{Binding UserAvatarPath}"
                           Aspect="AspectFill"
                           IsVisible="{Binding HasUserAvatar}"
                           HorizontalOptions="Fill"
                           VerticalOptions="Fill" />
                    <Label Text="{Binding UserInitials}"
                           IsVisible="{Binding HasUserAvatar, Converter={StaticResource InverseBoolConverter}}"
                           TextColor="#FFFFFF"
                           FontFamily="OpenSansSemibold"
                           FontSize="20"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Grid>
            </Border>

            <Label Grid.Row="1"
                   Text="{Binding UserName}"
                   TextColor="#FFFFFF"
                   FontFamily="OpenSansSemibold"
                   FontSize="18"
                   FontAttributes="Bold"
                   Margin="0,8,0,0" />

            <Label Grid.Row="2"
                   Text="{Binding UserEmail}"
                   TextColor="#D9DFF7"
                   FontSize="13" />

            <Border Grid.Row="3"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 8"
                    BackgroundColor="#5364C7"
                    Padding="10,3"
                    HorizontalOptions="Start"
                    Margin="0,4,0,0">
                <Label Text="{Binding UserRole}"
                       TextColor="#FFFFFF"
                       FontFamily="OpenSansSemibold"
                       FontSize="11" />
            </Border>
        </Grid>
    </Shell.FlyoutHeader>

    <Shell.FlyoutFooter>
        <VerticalStackLayout Padding="20,16" Spacing="10" BackgroundColor="{AppThemeBinding Light='#F6F7FC', Dark='#161824'}">
            <Button Text="{loc:Translate Profile_Logout}"
                    Command="{Binding LogoutCommand}"
                    TextColor="#D93829"
                    BackgroundColor="#FDEEEC"
                    CornerRadius="10"
                    HeightRequest="42"
                    FontFamily="OpenSansSemibold"
                    FontSize="13" />
            <Label Text="AquaSmart IoT Platform v1.0.0"
                   TextColor="#8C93A8"
                   FontSize="11"
                   HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </Shell.FlyoutFooter>

    <!-- Welcome / Splash Screen as Initial Route -->
    <FlyoutItem FlyoutItemIsVisible="False">
        <ShellContent
            Title="{loc:Translate Nav_Login}"
            ContentTemplate="{DataTemplate local:MainPage}"
            Route="MainPage" />
    </FlyoutItem>

    <!-- Main Bottom Tab Bar (Figma Navigation Bar) -->
    <TabBar Route="MainTabs">
        <Tab Title="{loc:Translate Nav_Home}" Icon="icon_home.png" Route="DashboardPage">
            <ShellContent Title="{loc:Translate Nav_Home}" ContentTemplate="{DataTemplate views:DashboardPage}" Route="DashboardPage" />
        </Tab>
        <Tab Title="{loc:Translate Nav_Tanks}" Icon="icon_box.png" Route="AquariumsPage">
            <ShellContent Title="{loc:Translate Nav_Tanks}" ContentTemplate="{DataTemplate views:AquariumsPage}" Route="AquariumsPage" />
        </Tab>
        <Tab Title="{loc:Translate Nav_Knowledge}" Icon="icon_book.png" Route="KnowledgeBasePage">
            <ShellContent Title="{loc:Translate Nav_Knowledge}" ContentTemplate="{DataTemplate views:KnowledgeBasePage}" Route="KnowledgeBasePage" />
        </Tab>
        <Tab Title="{loc:Translate Nav_Profile}" Icon="icon_user.png" Route="ProfilePage">
            <ShellContent Title="{loc:Translate Nav_Profile}" ContentTemplate="{DataTemplate views:ProfilePage}" Route="ProfilePage" />
        </Tab>
    </TabBar>
</Shell>
