<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Mobile.ViewModels"
             x:Class="Mobile.Views.ProfilePage"
             x:DataType="vm:ProfileViewModel"
             BackgroundColor="#F6F7FC"
             Title="Профиль пользователя">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="20,16,20,30">
            <!-- User Profile Header Card -->
            <Border x:Name="ProfileHeaderCard"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 20"
                    BackgroundColor="#4152B0"
                    Padding="24">
                <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                    <!-- Avatar circle -->
                    <Border StrokeThickness="3"
                            Stroke="#FFFFFF"
                            StrokeShape="RoundRectangle 40"
                            BackgroundColor="#2E3A7E"
                            HeightRequest="80"
                            WidthRequest="80"
                            HorizontalOptions="Center">
                        <Label Text="{Binding User.Initials}"
                               TextColor="#FFFFFF"
                               FontFamily="OpenSansSemibold"
                               FontSize="26"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>

                    <Label Text="{Binding User.FullName}"
                           TextColor="#FFFFFF"
                           FontFamily="OpenSansSemibold"
                           FontSize="20"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center" />

                    <Label Text="{Binding User.Email}"
                           TextColor="#D9DFF7"
                           FontSize="14"
                           HorizontalTextAlignment="Center" />

                    <Border StrokeThickness="0"
                            StrokeShape="RoundRectangle 12"
                            BackgroundColor="#5364C7"
                            Padding="12,4"
                            HorizontalOptions="Center">
                        <Label Text="{Binding User.Role}"
                               TextColor="#FFFFFF"
                               FontFamily="OpenSansSemibold"
                               FontSize="12" />
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- Settings / Actions Card -->
            <Border x:Name="SettingsCard"
                    StrokeThickness="1"
                    Stroke="#E4E7F4"
                    StrokeShape="RoundRectangle 16"
                    BackgroundColor="#FFFFFF"
                    Padding="16">
                <VerticalStackLayout Spacing="14">
                    <!-- Edit Profile Action -->
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" HeightRequest="44">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding EditProfileCommand}" />
                        </Grid.GestureRecognizers>
                        <Border Grid.Column="0" StrokeThickness="0" StrokeShape="RoundRectangle 10" BackgroundColor="#EDEFFB" WidthRequest="36" HeightRequest="36">
                            <Label Text="✏️" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label Text="Редактировать профиль" TextColor="#2E3A7E" FontFamily="OpenSansSemibold" FontSize="14" />
                            <Label Text="Изменить ФИО и персональные данные" TextColor="#8C93A8" FontSize="11" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" TextColor="#8C93A8" FontSize="20" VerticalOptions="Center" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="#F0F2F9" />

                    <!-- App Settings -->
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" HeightRequest="44">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ShowSettingsCommand}" />
                        </Grid.GestureRecognizers>
                        <Border Grid.Column="0" StrokeThickness="0" StrokeShape="RoundRectangle 10" BackgroundColor="#EDEFFB" WidthRequest="36" HeightRequest="36">
                            <Label Text="⚙️" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label Text="Настройки приложения" TextColor="#2E3A7E" FontFamily="OpenSansSemibold" FontSize="14" />
                            <Label Text="Тема, уведомления, интервал опроса" TextColor="#8C93A8" FontSize="11" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" TextColor="#8C93A8" FontSize="20" VerticalOptions="Center" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="#F0F2F9" />

                    <!-- Security -->
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" HeightRequest="44">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ShowSecurityCommand}" />
                        </Grid.GestureRecognizers>
                        <Border Grid.Column="0" StrokeThickness="0" StrokeShape="RoundRectangle 10" BackgroundColor="#EDEFFB" WidthRequest="36" HeightRequest="36">
                            <Label Text="🔒" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label Text="Безопасность" TextColor="#2E3A7E" FontFamily="OpenSansSemibold" FontSize="14" />
                            <Label Text="Пароль, 2FA и активные сессии" TextColor="#8C93A8" FontSize="11" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" TextColor="#8C93A8" FontSize="20" VerticalOptions="Center" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="#F0F2F9" />

                    <!-- Help & Support -->
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" HeightRequest="44">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ShowSupportCommand}" />
                        </Grid.GestureRecognizers>
                        <Border Grid.Column="0" StrokeThickness="0" StrokeShape="RoundRectangle 10" BackgroundColor="#EDEFFB" WidthRequest="36" HeightRequest="36">
                            <Label Text="💬" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label Text="Помощь и поддержка" TextColor="#2E3A7E" FontFamily="OpenSansSemibold" FontSize="14" />
                            <Label Text="FAQ, документация и связь с нами" TextColor="#8C93A8" FontSize="11" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" TextColor="#8C93A8" FontSize="20" VerticalOptions="Center" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="#F0F2F9" />

                    <!-- About App -->
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" HeightRequest="44">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ShowAboutCommand}" />
                        </Grid.GestureRecognizers>
                        <Border Grid.Column="0" StrokeThickness="0" StrokeShape="RoundRectangle 10" BackgroundColor="#EDEFFB" WidthRequest="36" HeightRequest="36">
                            <Label Text="ℹ️" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label Text="О платформе AquaSmart" TextColor="#2E3A7E" FontFamily="OpenSansSemibold" FontSize="14" />
                            <Label Text="Версия приложения и сведения" TextColor="#8C93A8" FontSize="11" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" TextColor="#8C93A8" FontSize="20" VerticalOptions="Center" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="#F0F2F9" />

                    <!-- Delete Account -->
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" HeightRequest="44">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding DeleteAccountCommand}" />
                        </Grid.GestureRecognizers>
                        <Border Grid.Column="0" StrokeThickness="0" StrokeShape="RoundRectangle 10" BackgroundColor="#FDEEEC" WidthRequest="36" HeightRequest="36">
                            <Label Text="🗑️" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label Text="Удаление аккаунта" TextColor="#D93829" FontFamily="OpenSansSemibold" FontSize="14" />
                            <Label Text="Безвозвратное удаление профиля" TextColor="#8C93A8" FontSize="11" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" TextColor="#8C93A8" FontSize="20" VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Logout Button -->
            <Button Text="Выйти из аккаунта"
                    Command="{Binding LogoutCommand}"
                    BackgroundColor="#FDEEEC"
                    TextColor="#D93829"
                    BorderColor="#FAD4CF"
                    BorderWidth="1"
                    CornerRadius="14"
                    HeightRequest="52"
                    FontFamily="OpenSansSemibold"
                    FontSize="15" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
