<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Mobile.ViewModels"
             x:Class="Mobile.Views.ProfilePage"
             x:DataType="vm:ProfileViewModel"
             BackgroundColor="{AppThemeBinding Light='#F6F7FC', Dark='#12131A'}"
             Shell.NavBarIsVisible="False"
             Title="Профиль">

    <Grid RowDefinitions="Auto,*" Padding="20,16,20,10">
        <!-- Top Header: Title & Action Icons matching Figma 434:8333 -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" Margin="0,4,0,16">
            <Label Grid.Column="0"
                   Text="Профиль"
                   TextColor="{AppThemeBinding Light='#141414', Dark='#F4F5FB'}"
                   FontFamily="OpenSansSemibold"
                   FontSize="22"
                   FontAttributes="Bold"
                   VerticalOptions="Center" />

            <!-- Edit Button (Pencil) -->
            <Border Grid.Column="1"
                    WidthRequest="38" HeightRequest="38"
                    StrokeShape="RoundRectangle 10"
                    BackgroundColor="{AppThemeBinding Light='#FFFFFF', Dark='#1E202C'}"
                    StrokeThickness="1"
                    Stroke="{AppThemeBinding Light='#E4E7F4', Dark='#2C2F42'}">
                <ImageButton Source="icon_edit.png"
                             Command="{Binding GoToEditProfileCommand}"
                             BackgroundColor="Transparent"
                             WidthRequest="18" HeightRequest="18"
                             Padding="0"
                             HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>

            <!-- Notifications Button (Bell) -->
            <Border Grid.Column="2"
                    WidthRequest="38" HeightRequest="38"
                    StrokeShape="RoundRectangle 10"
                    BackgroundColor="{AppThemeBinding Light='#FFFFFF', Dark='#1E202C'}"
                    StrokeThickness="1"
                    Stroke="{AppThemeBinding Light='#E4E7F4', Dark='#2C2F42'}">
                <ImageButton Source="icon_bell.png"
                             Command="{Binding OpenNotificationsCommand}"
                             BackgroundColor="Transparent"
                             WidthRequest="18" HeightRequest="18"
                             Padding="0"
                             HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
        </Grid>

        <!-- Main Scrollable Content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="18" Padding="0,0,0,24">
                <!-- User Profile Header Section matching Figma -->
                <VerticalStackLayout x:Name="ProfileHeaderCard"
                                     Spacing="8"
                                     HorizontalOptions="Center"
                                     Margin="0,4,0,8">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToEditProfileCommand}" />
                    </VerticalStackLayout.GestureRecognizers>

                    <!-- Circular Avatar (Tap to edit) -->
                    <Border StrokeThickness="0"
                            StrokeShape="RoundRectangle 42"
                            BackgroundColor="#DDE4F8"
                            HeightRequest="84"
                            WidthRequest="84"
                            HorizontalOptions="Center">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToChangeAvatarCommand}" />
                        </Border.GestureRecognizers>
                        <Grid>
                            <Image Source="{Binding User.AvatarPath}"
                                   Aspect="AspectFill"
                                   IsVisible="{Binding User.HasAvatar}"
                                   HorizontalOptions="Fill"
                                   VerticalOptions="Fill" />
                            <Label Text="{Binding User.Initials}"
                                   IsVisible="{Binding User.HasAvatar, Converter={StaticResource InverseBoolConverter}}"
                                   TextColor="#4152B0"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="28"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <!-- Nickname / Full Name (Tap to edit) -->
                    <Label Text="{Binding User.FullName}"
                           TextColor="{AppThemeBinding Light='#141414', Dark='#F4F5FB'}"
                           FontFamily="OpenSansSemibold"
                           FontSize="20"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToEditProfileCommand}" />
                        </Label.GestureRecognizers>
                    </Label>

                    <!-- Email (Tap to edit) -->
                    <Label Text="{Binding User.Email}"
                           TextColor="{AppThemeBinding Light='#6E6E6E', Dark='#9FA3B8'}"
                           FontSize="14"
                           HorizontalTextAlignment="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToEditProfileCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </VerticalStackLayout>

                <!-- Telegram Bot Integration Banner Card -->
                <Border StrokeThickness="1"
                        Stroke="{AppThemeBinding Light='#CDE5F6', Dark='#244158'}"
                        StrokeShape="RoundRectangle 20"
                        BackgroundColor="{AppThemeBinding Light='#FFFFFF', Dark='#1E202C'}"
                        Padding="16,14">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                        <Border Grid.Column="0"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="{AppThemeBinding Light='#E8F4FC', Dark='#1B2D3C'}"
                                WidthRequest="44" HeightRequest="44"
                                VerticalOptions="Center">
                            <Image Source="icon_telegram.png"
                                   WidthRequest="24" HeightRequest="24"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label Text="Telegram-бот"
                                   TextColor="{AppThemeBinding Light='#141414', Dark='#F4F5FB'}"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="15"
                                   FontAttributes="Bold" />
                            <Label Text="Уведомления об авариях и напоминания в чат"
                                   TextColor="{AppThemeBinding Light='#6E6E6E', Dark='#9FA3B8'}"
                                   FontSize="12"
                                   LineBreakMode="WordWrap" />
                        </VerticalStackLayout>

                        <Button Grid.Column="2"
                                Text="Войти"
                                Command="{Binding LinkTelegramCommand}"
                                BackgroundColor="#229ED9"
                                TextColor="#FFFFFF"
                                FontFamily="OpenSansSemibold"
                                FontSize="13"
                                CornerRadius="12"
                                HeightRequest="36"
                                Padding="14,0"
                                VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- Grouped Settings & Navigation Card matching Figma -->
                <Border x:Name="SettingsCard"
                        StrokeThickness="1"
                        Stroke="{AppThemeBinding Light='#E8EAF5', Dark='#2C2F42'}"
                        StrokeShape="RoundRectangle 20"
                        BackgroundColor="{AppThemeBinding Light='#FFFFFF', Dark='#1E202C'}"
                        Padding="16,6">
                    <VerticalStackLayout Spacing="0">
                        <!-- 1. Мои контроллеры -->
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" HeightRequest="52">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding GoToControllersCommand}" />
                            </Grid.GestureRecognizers>
                            <Image Grid.Column="0" Source="icon_cpu.png" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="Мои контроллеры" TextColor="{AppThemeBinding Light='#141414', Dark='#F4F5FB'}" FontFamily="OpenSansSemibold" FontSize="15" VerticalOptions="Center" />
                            <Image Grid.Column="2" Source="icon_chevron_right.png" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light='#F0F2F9', Dark='#26283B'}" />

                        <!-- 2. Настройки приложения -->
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" HeightRequest="52">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding GoToAppSettingsCommand}" />
                            </Grid.GestureRecognizers>
                            <Image Grid.Column="0" Source="icon_settings.png" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="Настройки приложения" TextColor="{AppThemeBinding Light='#141414', Dark='#F4F5FB'}" FontFamily="OpenSansSemibold" FontSize="15" VerticalOptions="Center" />
                            <Image Grid.Column="2" Source="icon_chevron_right.png" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light='#F0F2F9', Dark='#26283B'}" />

                        <!-- 3. Данные и история -->
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" HeightRequest="52">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding GoToDataHistoryCommand}" />
                            </Grid.GestureRecognizers>
                            <Image Grid.Column="0" Source="icon_chart.png" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="Данные и история" TextColor="{AppThemeBinding Light='#141414', Dark='#F4F5FB'}" FontFamily="OpenSansSemibold" FontSize="15" VerticalOptions="Center" />
                            <Image Grid.Column="2" Source="icon_chevron_right.png" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light='#F0F2F9', Dark='#26283B'}" />

                        <!-- 4. Безопасность -->
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" HeightRequest="52">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding GoToSecurityCommand}" />
                            </Grid.GestureRecognizers>
                            <Image Grid.Column="0" Source="icon_shield.png" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="Безопасность" TextColor="{AppThemeBinding Light='#141414', Dark='#F4F5FB'}" FontFamily="OpenSansSemibold" FontSize="15" VerticalOptions="Center" />
                            <Image Grid.Column="2" Source="icon_chevron_right.png" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light='#F0F2F9', Dark='#26283B'}" />

                        <!-- 5. Помощь и поддержка -->
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" HeightRequest="52">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding GoToHelpSupportCommand}" />
                            </Grid.GestureRecognizers>
                            <Image Grid.Column="0" Source="icon_help.png" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="Помощь и поддержка" TextColor="{AppThemeBinding Light='#141414', Dark='#F4F5FB'}" FontFamily="OpenSansSemibold" FontSize="15" VerticalOptions="Center" />
                            <Image Grid.Column="2" Source="icon_chevron_right.png" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light='#F0F2F9', Dark='#26283B'}" />

                        <!-- 6. О приложении -->
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" HeightRequest="52">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding GoToAboutAppCommand}" />
                            </Grid.GestureRecognizers>
                            <Image Grid.Column="0" Source="icon_info.png" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="О приложении" TextColor="{AppThemeBinding Light='#141414', Dark='#F4F5FB'}" FontFamily="OpenSansSemibold" FontSize="15" VerticalOptions="Center" />
                            <Image Grid.Column="2" Source="icon_chevron_right.png" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light='#F0F2F9', Dark='#26283B'}" />

                        <!-- 7. Выйти из приложения -->
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" HeightRequest="52">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding LogoutCommand}" />
                            </Grid.GestureRecognizers>
                            <Image Grid.Column="0" Source="icon_logout.png" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="Выйти из приложения" TextColor="{AppThemeBinding Light='#141414', Dark='#F4F5FB'}" FontFamily="OpenSansSemibold" FontSize="15" VerticalOptions="Center" />
                            <Image Grid.Column="2" Source="icon_chevron_right.png" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light='#F0F2F9', Dark='#26283B'}" />

                        <!-- 8. Удалить аккаунт (Red) -->
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" HeightRequest="52">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding GoToDeleteAccountCommand}" />
                            </Grid.GestureRecognizers>
                            <Image Grid.Column="0" Source="icon_trash.png" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="Удалить аккаунт" TextColor="#E53935" FontFamily="OpenSansSemibold" FontSize="15" VerticalOptions="Center" />
                            <Image Grid.Column="2" Source="icon_chevron_right.png" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
