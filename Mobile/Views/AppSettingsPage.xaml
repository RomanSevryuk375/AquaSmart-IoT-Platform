<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Mobile.ViewModels"
             xmlns:loc="clr-namespace:Mobile.Converters"
             x:Class="Mobile.Views.AppSettingsPage"
             x:DataType="vm:AppSettingsViewModel"
             BackgroundColor="{AppThemeBinding Light='#F6F7FC', Dark='#12131A'}"
             Shell.NavBarIsVisible="False"
             Title="{loc:Translate Settings_Title}">

    <Grid RowDefinitions="Auto,*" Padding="20,16,20,10">
        <!-- Top Bar: Back Button, Title, Bell matching Figma 760:12086 -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="0,4,0,16">
            <Border Grid.Column="0"
                    WidthRequest="38" HeightRequest="38"
                    StrokeShape="RoundRectangle 10"
                    BackgroundColor="{AppThemeBinding Light='#FFFFFF', Dark='#1E202C'}"
                    StrokeThickness="1"
                    Stroke="{AppThemeBinding Light='#E4E7F4', Dark='#2C2F42'}">
                <ImageButton Source="icon_chevron_left.png"
                             Command="{Binding GoBackCommand}"
                             BackgroundColor="Transparent"
                             WidthRequest="20" HeightRequest="20"
                             Padding="0"
                             HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>

            <Label Grid.Column="1"
                   Text="{loc:Translate Settings_Title}"
                   TextColor="{AppThemeBinding Light='#141414', Dark='#F4F5FB'}"
                   FontFamily="OpenSansSemibold"
                   FontSize="18"
                   FontAttributes="Bold"
                   VerticalOptions="Center" />

            <Border Grid.Column="2"
                    WidthRequest="38" HeightRequest="38"
                    StrokeShape="RoundRectangle 10"
                    BackgroundColor="{AppThemeBinding Light='#FFFFFF', Dark='#1E202C'}"
                    StrokeThickness="1"
                    Stroke="{AppThemeBinding Light='#E4E7F4', Dark='#2C2F42'}">
                <ImageButton Source="icon_bell.png"
                             Command="{Binding OpenNotificationsCommand}"
                             BackgroundColor="Transparent"
                             WidthRequest="18" HeightRequest="18"
                             Padding="0"
                             HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
        </Grid>

        <!-- Scrollable Settings Sections -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="20" Padding="0,0,0,24">
                <!-- 1. Внешний вид -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="{loc:Translate Settings_Appearance}"
                           TextColor="{AppThemeBinding Light='#141414', Dark='#F4F5FB'}"
                           FontFamily="OpenSansSemibold"
                           FontSize="16"
                           FontAttributes="Bold" />

                    <Border StrokeThickness="1"
                            Stroke="{AppThemeBinding Light='#E8EAF5', Dark='#2C2F42'}"
                            StrokeShape="RoundRectangle 16"
                            BackgroundColor="{AppThemeBinding Light='#FFFFFF', Dark='#1E202C'}"
                            Padding="16,6">
                        <VerticalStackLayout Spacing="0">
                            <!-- Тема интерфейса -->
                            <Grid ColumnDefinitions="*,Auto" HeightRequest="56">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ChooseThemeCommand}" />
                                </Grid.GestureRecognizers>
                                <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                                    <Label Text="{loc:Translate Settings_Theme}" TextColor="{AppThemeBinding Light='#141414', Dark='#F4F5FB'}" FontFamily="OpenSansSemibold" FontSize="15" />
                                    <Label Text="{Binding CurrentTheme}" TextColor="{AppThemeBinding Light='#6E6E6E', Dark='#9FA3B8'}" FontSize="13" />
                                </VerticalStackLayout>
                                <Image Grid.Column="1" Source="icon_chevron_right.png" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                            </Grid>

                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light='#F0F2F9', Dark='#26283B'}" />

                            <!-- Язык приложения -->
                            <Grid ColumnDefinitions="*,Auto" HeightRequest="56">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ChooseLanguageCommand}" />
                                </Grid.GestureRecognizers>
                                <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                                    <Label Text="{loc:Translate Settings_Language}" TextColor="{AppThemeBinding Light='#141414', Dark='#F4F5FB'}" FontFamily="OpenSansSemibold" FontSize="15" />
                                    <Label Text="{Binding CurrentLanguage}" TextColor="{AppThemeBinding Light='#6E6E6E', Dark='#9FA3B8'}" FontSize="13" />
                                </VerticalStackLayout>
                                <Image Grid.Column="1" Source="icon_chevron_right.png" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- 2. Уведомления -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="{loc:Translate Settings_Notifications}"
                           TextColor="{AppThemeBinding Light='#141414', Dark='#F4F5FB'}"
                           FontFamily="OpenSansSemibold"
                           FontSize="16"
                           FontAttributes="Bold" />

                    <Border StrokeThickness="1"
                            Stroke="{AppThemeBinding Light='#E8EAF5', Dark='#2C2F42'}"
                            StrokeShape="RoundRectangle 16"
                            BackgroundColor="{AppThemeBinding Light='#FFFFFF', Dark='#1E202C'}"
                            Padding="16,6">
                        <VerticalStackLayout Spacing="0">
                            <!-- Аварийные сигналы -->
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="0,10">
                                <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                                    <Label Text="{loc:Translate Settings_EmergencyAlerts}" TextColor="{AppThemeBinding Light='#141414', Dark='#F4F5FB'}" FontFamily="OpenSansSemibold" FontSize="15" />
                                    <Label Text="{loc:Translate Settings_EmergencyAlertsSub}"
                                           TextColor="{AppThemeBinding Light='#6E6E6E', Dark='#9FA3B8'}" FontSize="12" LineBreakMode="WordWrap" />
                                </VerticalStackLayout>
                                <Switch Grid.Column="1"
                                        IsToggled="{Binding EmergencyAlerts}"
                                        OnColor="#4152B0"
                                        VerticalOptions="Center" />
                            </Grid>

                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light='#F0F2F9', Dark='#26283B'}" />

                            <!-- Потеря связи с платой -->
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="0,10">
                                <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                                    <Label Text="{loc:Translate Settings_ConnectionLoss}" TextColor="{AppThemeBinding Light='#141414', Dark='#F4F5FB'}" FontFamily="OpenSansSemibold" FontSize="15" />
                                    <Label Text="{loc:Translate Settings_ConnectionLossSub}"
                                           TextColor="{AppThemeBinding Light='#6E6E6E', Dark='#9FA3B8'}" FontSize="12" LineBreakMode="WordWrap" />
                                </VerticalStackLayout>
                                <Switch Grid.Column="1"
                                        IsToggled="{Binding ConnectionLossAlerts}"
                                        OnColor="#4152B0"
                                        VerticalOptions="Center" />
                            </Grid>

                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light='#F0F2F9', Dark='#26283B'}" />

                            <!-- Запуск сценариев -->
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="0,10">
                                <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                                    <Label Text="{loc:Translate Settings_ScenarioAlerts}" TextColor="{AppThemeBinding Light='#141414', Dark='#F4F5FB'}" FontFamily="OpenSansSemibold" FontSize="15" />
                                    <Label Text="{loc:Translate Settings_ScenarioAlertsSub}"
                                           TextColor="{AppThemeBinding Light='#6E6E6E', Dark='#9FA3B8'}" FontSize="12" LineBreakMode="WordWrap" />
                                </VerticalStackLayout>
                                <Switch Grid.Column="1"
                                        IsToggled="{Binding ScenarioAlerts}"
                                        OnColor="#4152B0"
                                        VerticalOptions="Center" />
                            </Grid>

                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light='#F0F2F9', Dark='#26283B'}" />

                            <!-- Оповещения в Telegram -->
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12" Padding="0,10">
                                <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                                    <Label Text="{loc:Translate Settings_TelegramAlerts}" TextColor="{AppThemeBinding Light='#141414', Dark='#F4F5FB'}" FontFamily="OpenSansSemibold" FontSize="15" />
                                    <Label Text="{loc:Translate Settings_TelegramAlertsSub}"
                                           TextColor="{AppThemeBinding Light='#6E6E6E', Dark='#9FA3B8'}" FontSize="12" LineBreakMode="WordWrap" />
                                </VerticalStackLayout>
                                <Button Grid.Column="1"
                                        Text="{loc:Translate Settings_TelegramBotBtn}"
                                        Command="{Binding LinkTelegramCommand}"
                                        BackgroundColor="#E8F4FC"
                                        TextColor="#229ED9"
                                        FontFamily="OpenSansSemibold"
                                        FontSize="12"
                                        CornerRadius="10"
                                        HeightRequest="32"
                                        Padding="10,0"
                                        VerticalOptions="Center" />
                                <Switch Grid.Column="2"
                                        IsToggled="{Binding TelegramAlerts}"
                                        OnColor="#4152B0"
                                        VerticalOptions="Center" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- 3. Данные -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="{loc:Translate Settings_Data}"
                           TextColor="{AppThemeBinding Light='#141414', Dark='#F4F5FB'}"
                           FontFamily="OpenSansSemibold"
                           FontSize="16"
                           FontAttributes="Bold" />

                    <Border StrokeThickness="1"
                            Stroke="{AppThemeBinding Light='#E8EAF5', Dark='#2C2F42'}"
                            StrokeShape="RoundRectangle 16"
                            BackgroundColor="{AppThemeBinding Light='#FFFFFF', Dark='#1E202C'}"
                            Padding="16,6">
                        <VerticalStackLayout Spacing="0">
                            <!-- Обновление экранов -->
                            <Grid ColumnDefinitions="*,Auto" HeightRequest="56">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ChooseRefreshIntervalCommand}" />
                                </Grid.GestureRecognizers>
                                <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                                    <Label Text="{loc:Translate Settings_RefreshInterval}" TextColor="{AppThemeBinding Light='#141414', Dark='#F4F5FB'}" FontFamily="OpenSansSemibold" FontSize="15" />
                                    <Label Text="{Binding RefreshInterval}" TextColor="{AppThemeBinding Light='#6E6E6E', Dark='#9FA3B8'}" FontSize="13" />
                                </VerticalStackLayout>
                                <Image Grid.Column="1" Source="icon_chevron_right.png" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                            </Grid>

                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light='#F0F2F9', Dark='#26283B'}" />

                            <!-- Экономия трафика (Wi-Fi) -->
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" HeightRequest="52">
                                <Label Text="{loc:Translate Settings_TrafficSaving}" TextColor="{AppThemeBinding Light='#141414', Dark='#F4F5FB'}" FontFamily="OpenSansSemibold" FontSize="15" VerticalOptions="Center" />
                                <Switch Grid.Column="1"
                                        IsToggled="{Binding TrafficSaving}"
                                        OnColor="#4152B0"
                                        VerticalOptions="Center" />
                            </Grid>

                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light='#F0F2F9', Dark='#26283B'}" />

                            <!-- Локальный кэш и очистка -->
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" HeightRequest="56">
                                <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                                    <Label Text="{loc:Translate Settings_LocalCache}" TextColor="{AppThemeBinding Light='#141414', Dark='#F4F5FB'}" FontFamily="OpenSansSemibold" FontSize="15" />
                                    <Label Text="{Binding CacheSize}" TextColor="{AppThemeBinding Light='#6E6E6E', Dark='#9FA3B8'}" FontSize="13" />
                                </VerticalStackLayout>
                                <Button Grid.Column="1"
                                        Text="{loc:Translate Settings_Clear}"
                                        Command="{Binding ClearCacheCommand}"
                                        BackgroundColor="#FEECEB"
                                        TextColor="#E53935"
                                        FontFamily="OpenSansSemibold"
                                        FontSize="12"
                                        CornerRadius="8"
                                        HeightRequest="34"
                                        Padding="12,0"
                                        VerticalOptions="Center" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
