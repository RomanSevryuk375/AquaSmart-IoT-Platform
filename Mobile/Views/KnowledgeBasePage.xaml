<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Mobile.ViewModels"
             xmlns:models="clr-namespace:Mobile.Models"
             x:Class="Mobile.Views.KnowledgeBasePage"
             x:DataType="vm:KnowledgeBaseViewModel"
             BackgroundColor="#F6F7FC"
             Title="База знаний">

    <Grid RowDefinitions="Auto,*" Padding="20,16,20,10">
        <!-- Search bar -->
        <Border Grid.Row="0"
                StrokeThickness="1"
                Stroke="#E4E7F4"
                StrokeShape="RoundRectangle 14"
                BackgroundColor="#FFFFFF"
                HeightRequest="50"
                Padding="14,0"
                Margin="0,0,0,16">
            <Grid ColumnDefinitions="*,Auto">
                <Entry Grid.Column="0"
                       Text="{Binding SearchQuery}"
                       Placeholder="Поиск рекомендаций, норм и видов..."
                       PlaceholderColor="#8C93A8"
                       TextColor="#2E3A7E"
                       ReturnCommand="{Binding SearchCommand}"
                       VerticalOptions="Center" />

                <Button Grid.Column="1"
                        Text="Найти"
                        Command="{Binding SearchCommand}"
                        BackgroundColor="#4152B0"
                        TextColor="#FFFFFF"
                        CornerRadius="10"
                        HeightRequest="36"
                        Padding="14,0"
                        FontSize="13"
                        FontFamily="OpenSansSemibold"
                        VerticalOptions="Center" />
            </Grid>
        </Border>

        <!-- Articles List -->
        <RefreshView Grid.Row="1"
                     IsRefreshing="{Binding IsBusy}"
                     Command="{Binding SearchCommand}">
            <CollectionView ItemsSource="{Binding Articles}"
                            SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:KnowledgeArticleModel">
                        <Border StrokeThickness="1"
                                Stroke="#E4E7F4"
                                StrokeShape="RoundRectangle 16"
                                BackgroundColor="#FFFFFF"
                                Padding="16">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:KnowledgeBaseViewModel}}, Path=SelectArticleCommand}"
                                                      CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>

                            <VerticalStackLayout Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Grid.Column="0"
                                           Text="{Binding Title}"
                                           TextColor="#2E3A7E"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           LineBreakMode="WordWrap" />

                                    <Border Grid.Column="1"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 8"
                                            BackgroundColor="#EDEFFB"
                                            Padding="8,4"
                                            VerticalOptions="Start">
                                        <Label Text="{Binding Category}"
                                               TextColor="#4152B0"
                                               FontFamily="OpenSansSemibold"
                                               FontSize="11" />
                                    </Border>
                                </Grid>

                                <Label Text="{Binding Summary}"
                                       TextColor="#6A738A"
                                       FontSize="13"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="3" />

                                <Label Text="Подробнее →"
                                       TextColor="#4152B0"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="12"
                                       Margin="0,4,0,0" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
