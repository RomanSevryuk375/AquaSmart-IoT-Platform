<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Mobile.ViewModels"
             xmlns:models="clr-namespace:Mobile.Models"
             x:Class="Mobile.Views.OnboardingPage"
             x:DataType="vm:OnboardingViewModel"
             BackgroundColor="#FFFFFF"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto" Padding="24,40,24,32">
        <!-- Top bar: Skip button -->
        <HorizontalStackLayout Grid.Row="0" HorizontalOptions="End">
            <Button Text="Пропустить"
                    Command="{Binding SkipCommand}"
                    TextColor="#4152B0"
                    BackgroundColor="Transparent"
                    FontFamily="OpenSansSemibold"
                    FontSize="14"
                    Padding="10,6" />
        </HorizontalStackLayout>

        <!-- Center: Carousel of Slides -->
        <CarouselView x:Name="Carousel"
                      Grid.Row="1"
                      ItemsSource="{Binding Slides}"
                      Position="{Binding CurrentPosition, Mode=TwoWay}"
                      IsSwipeEnabled="True"
                      IndicatorView="Indicator">
            <CarouselView.ItemTemplate>
                <DataTemplate x:DataType="models:OnboardingSlideModel">
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="24" Padding="16">
                        <!-- Emoji/Icon badge card -->
                        <Border WidthRequest="120"
                                HeightRequest="120"
                                StrokeShape="RoundRectangle 60"
                                BackgroundColor="#EDEFFB"
                                StrokeThickness="0"
                                HorizontalOptions="Center">
                            <Label Text="{Binding IconEmoji}"
                                   FontSize="54"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>

                        <Label Text="{Binding Title}"
                               TextColor="#141414"
                               FontFamily="OpenSansSemibold"
                               FontSize="24"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center" />

                        <Label Text="{Binding Description}"
                               TextColor="#6E6E6E"
                               FontFamily="OpenSansRegular"
                               FontSize="16"
                               LineHeight="1.3"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CarouselView.ItemTemplate>
        </CarouselView>

        <!-- Bottom: Indicator dots and Next/Finish button -->
        <VerticalStackLayout Grid.Row="2" x:Name="BottomContainer" Spacing="24">
            <IndicatorView x:Name="Indicator"
                           HorizontalOptions="Center"
                           IndicatorColor="#D9DFF7"
                           SelectedIndicatorColor="#4152B0"
                           IndicatorSize="8" />

            <Button x:Name="NextButton"
                    Text="Продолжить"
                    Command="{Binding NextOrFinishCommand}"
                    BackgroundColor="#4152B0"
                    TextColor="#FFFFFF"
                    FontFamily="OpenSansSemibold"
                    FontSize="16"
                    CornerRadius="12"
                    HeightRequest="52">
                <Button.Shadow>
                    <Shadow Brush="#334152B0" Offset="0,4" Radius="8" Opacity="0.8" />
                </Button.Shadow>
            </Button>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
