<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Mobile.ViewModels"
             xmlns:models="clr-namespace:Mobile.Models"
             xmlns:controls="clr-namespace:Mobile.Views.Controls"
             xmlns:dto="clr-namespace:Mobile.Services.Dto.Notification"
             x:Class="Mobile.Views.NotificationsPage"
             x:DataType="vm:NotificationsViewModel"
             BackgroundColor="{AppThemeBinding Light='#FFFFFF', Dark='#12131A'}"
             Shell.NavBarIsVisible="False"
             Title="Уведомления">

    <Grid RowDefinitions="Auto,Auto,*" Padding="20,16,20,16">

        <!-- Top Navigation Bar: Back Arrow, Title, Mark All Read -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="0,4,0,16">
            <!-- Back Button -->
            <Border Grid.Column="0"
                    WidthRequest="38" HeightRequest="38"
                    StrokeShape="RoundRectangle 10"
                    BackgroundColor="{AppThemeBinding Light='#F6F7FC', Dark='#1E202C'}"
                    StrokeThickness="0"
                    VerticalOptions="Center">
                <ImageButton Source="{AppThemeBinding Light='icon_arrow_left.png', Dark='icon_arrow_left_white.png'}"
                             Command="{Binding GoBackCommand}"
                             BackgroundColor="Transparent"
                             WidthRequest="20" HeightRequest="20"
                             Padding="0"
                             HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>

            <!-- Page Title -->
            <Label Grid.Column="1"
                   Text="Уведомления"
                   TextColor="{AppThemeBinding Light='#141414', Dark='#F4F5FB'}"
                   FontFamily="OpenSansSemibold"
                   FontSize="18"
                   FontAttributes="Bold"
                   VerticalOptions="Center" />

            <!-- Mark All Read / Clear Action -->
            <Button Grid.Column="2"
                    Text="Прочитать все"
                    Command="{Binding MarkAllAsReadCommand}"
                    TextColor="#4152B0"
                    BackgroundColor="Transparent"
                    FontFamily="OpenSansSemibold"
                    FontSize="12"
                    Padding="4,0"
                    VerticalOptions="Center"
                    IsVisible="{Binding HasNotifications}" />
        </Grid>

        <!-- Filter Chips: Все / Непрочитанные / Важные / Задачи -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*" ColumnSpacing="6" Margin="0,0,0,16">
            <!-- Chip 1: Все -->
            <Border Grid.Column="0"
                    StrokeShape="RoundRectangle 10"
                    StrokeThickness="0"
                    HeightRequest="36"
                    BackgroundColor="{Binding IsAllFilterSelected, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#4152B0|#F6F7FC'}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SelectFilterCommand}" CommandParameter="Все" />
                </Border.GestureRecognizers>
                <Label Text="Все"
                       TextColor="{Binding IsAllFilterSelected, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#FFFFFF|#6E6E6E'}"
                       FontFamily="OpenSansSemibold"
                       FontSize="12"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Border>

            <!-- Chip 2: Непрочитанные -->
            <Border Grid.Column="1"
                    StrokeShape="RoundRectangle 10"
                    StrokeThickness="0"
                    HeightRequest="36"
                    BackgroundColor="{Binding IsUnreadFilterSelected, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#4152B0|#F6F7FC'}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SelectFilterCommand}" CommandParameter="Непрочитанные" />
                </Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="4" HorizontalOptions="Center" VerticalOptions="Center">
                    <Label Text="Новые"
                           TextColor="{Binding IsUnreadFilterSelected, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#FFFFFF|#6E6E6E'}"
                           FontFamily="OpenSansSemibold"
                           FontSize="12"
                           VerticalOptions="Center" />
                    <Border StrokeShape="RoundRectangle 8"
                            StrokeThickness="0"
                            Padding="4,1"
                            IsVisible="{Binding UnreadCount, Converter={StaticResource GreaterThanZeroConverter}}"
                            BackgroundColor="{Binding IsUnreadFilterSelected, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#FFFFFF|#4152B0'}">
                        <Label Text="{Binding UnreadCount}"
                               TextColor="{Binding IsUnreadFilterSelected, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#4152B0|#FFFFFF'}"
                               FontFamily="OpenSansSemibold"
                               FontSize="10"
                               VerticalOptions="Center" />
                    </Border>
                </HorizontalStackLayout>
            </Border>

            <!-- Chip 3: Важные -->
            <Border Grid.Column="2"
                    StrokeShape="RoundRectangle 10"
                    StrokeThickness="0"
                    HeightRequest="36"
                    BackgroundColor="{Binding IsImportantFilterSelected, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#4152B0|#F6F7FC'}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SelectFilterCommand}" CommandParameter="Важные" />
                </Border.GestureRecognizers>
                <Label Text="Важные"
                       TextColor="{Binding IsImportantFilterSelected, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#FFFFFF|#6E6E6E'}"
                       FontFamily="OpenSansSemibold"
                       FontSize="12"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Border>

            <!-- Chip 4: Задачи / Напоминания -->
            <Border Grid.Column="3"
                    StrokeShape="RoundRectangle 10"
                    StrokeThickness="0"
                    HeightRequest="36"
                    BackgroundColor="{Binding IsRemindersFilterSelected, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#4152B0|#F6F7FC'}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SelectFilterCommand}" CommandParameter="Напоминания" />
                </Border.GestureRecognizers>
                <Label Text="Задачи"
                       TextColor="{Binding IsRemindersFilterSelected, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#FFFFFF|#6E6E6E'}"
                       FontFamily="OpenSansSemibold"
                       FontSize="12"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Border>
        </Grid>

        <!-- Main Content Area: Notifications List or Reminders Area -->
        <Grid Grid.Row="2">
            <!-- Notifications View (Visible when NOT in Reminders tab) -->
            <Grid IsVisible="{Binding IsRemindersFilterSelected, Converter={StaticResource InvertedBoolConverter}}">
                <!-- Empty State -->
                <VerticalStackLayout IsVisible="{Binding HasNoNotifications}"
                                     Spacing="16"
                                     VerticalOptions="Center"
                                     HorizontalOptions="Fill"
                                     Padding="16,0">
                    <controls:FishMascotCard HeightOverride="180" BadgeText="🔔" BadgeColor="#4152B0" />
                    <Label Text="Нет новых уведомлений"
                           TextColor="#141414"
                           FontFamily="OpenSansSemibold"
                           FontSize="18"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center" />
                    <Label Text="Все системы аквариумов и контроллеров работают в штатном режиме. Новые оповещения будут появляться здесь."
                           TextColor="#6E6E6E"
                           FontSize="13"
                           LineHeight="1.3"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <!-- Notifications CollectionView -->
                <RefreshView IsRefreshing="{Binding IsBusy}" Command="{Binding LoadNotificationsCommand}">
                    <CollectionView ItemsSource="{Binding Notifications}"
                                    IsVisible="{Binding HasNotifications}"
                                    SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:NotificationModel">
                                <Border StrokeShape="RoundRectangle 14"
                                        StrokeThickness="1"
                                        Stroke="{Binding CardBorderColor}"
                                        BackgroundColor="{Binding CardBackgroundColor}"
                                        Padding="14,12"
                                        Margin="0,0,0,10">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:NotificationsViewModel}}, Path=MarkAsReadCommand}"
                                                              CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
                                        <!-- Header Row: Level Badge & Time / Dot -->
                                        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="6" VerticalOptions="Center">
                                            <!-- Level Pill -->
                                            <Border Grid.Column="0"
                                                    StrokeShape="RoundRectangle 6"
                                                    StrokeThickness="0"
                                                    BackgroundColor="{Binding LevelBadgeBgColor}"
                                                    Padding="8,2">
                                                <Label Text="{Binding LevelBadgeText}"
                                                       TextColor="{Binding LevelBadgeTextColor}"
                                                       FontFamily="OpenSansSemibold"
                                                       FontSize="11" />
                                            </Border>

                                            <!-- Relative Time -->
                                            <Label Grid.Column="2"
                                                   Text="{Binding TimeAgo}"
                                                   TextColor="#8C93A8"
                                                   FontSize="11"
                                                   VerticalOptions="Center" />

                                            <!-- Unread Dot Indicator -->
                                            <BoxView Grid.Column="3"
                                                     WidthRequest="7" HeightRequest="7"
                                                     CornerRadius="3.5"
                                                     Color="#4152B0"
                                                     IsVisible="{Binding HasUnreadDot}"
                                                     VerticalOptions="Center"
                                                     Margin="4,0,0,0" />
                                        </Grid>

                                        <!-- Message Body -->
                                        <Label Grid.Row="1"
                                               Text="{Binding Message}"
                                               TextColor="#141414"
                                               FontFamily="OpenSansRegular"
                                               FontSize="13"
                                               LineHeight="1.3" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </RefreshView>
            </Grid>

            <!-- Reminders View (Visible when in Reminders tab) -->
            <Grid IsVisible="{Binding IsRemindersFilterSelected}" RowDefinitions="Auto,*">
                <!-- Action Header: Add reminder button -->
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12" VerticalOptions="Center">
                    <Label Grid.Column="0"
                           Text="Задачи и напоминания"
                           TextColor="#141414"
                           FontFamily="OpenSansSemibold"
                           FontSize="15"
                           VerticalOptions="Center" />
                    <Button Grid.Column="1"
                            Text="+ Добавить"
                            BackgroundColor="#4152B0"
                            TextColor="#FFFFFF"
                            FontFamily="OpenSansSemibold"
                            FontSize="12"
                            HeightRequest="36"
                            CornerRadius="8"
                            Padding="12,0"
                            Command="{Binding AddReminderCommand}" />
                </Grid>

                <!-- Reminders Content Area -->
                <Grid Grid.Row="1">
                    <!-- Empty State for Reminders -->
                    <VerticalStackLayout IsVisible="{Binding HasNoReminders}"
                                         Spacing="16"
                                         VerticalOptions="Center"
                                         HorizontalOptions="Fill"
                                         Padding="16,0">
                        <controls:FishMascotCard HeightOverride="180" BadgeText="📋" BadgeColor="#4152B0" />
                        <Label Text="Нет активных задач"
                               TextColor="#141414"
                               FontFamily="OpenSansSemibold"
                               FontSize="18"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center" />
                        <Label Text="Запланируйте периодические процедуры ухода: подмену воды, тесты параметров, чистку фильтра или внесение удобрений."
                               TextColor="#6E6E6E"
                               FontSize="13"
                               LineHeight="1.3"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>

                    <!-- Reminders CollectionView -->
                    <RefreshView IsRefreshing="{Binding IsBusy}" Command="{Binding LoadRemindersCommand}">
                        <CollectionView ItemsSource="{Binding Reminders}"
                                        IsVisible="{Binding HasReminders}"
                                        SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="dto:ReminderDto">
                                    <Border StrokeShape="RoundRectangle 14"
                                            StrokeThickness="1"
                                            Stroke="#E0E3EE"
                                            BackgroundColor="#FFFFFF"
                                            Padding="14,12"
                                            Margin="0,0,0,10">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                                            <!-- Info Left Column -->
                                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                                <Label Text="{Binding TaskName}"
                                                       TextColor="#141414"
                                                       FontFamily="OpenSansSemibold"
                                                       FontSize="14" />
                                                <Label Text="{Binding IntervalDays, StringFormat='Повторять каждые {0} дн.'}"
                                                       TextColor="#8C93A8"
                                                       FontSize="11" />
                                                <HorizontalStackLayout Spacing="6" Margin="0,4,0,0">
                                                    <Border StrokeShape="RoundRectangle 6"
                                                            StrokeThickness="0"
                                                            BackgroundColor="#F0F2FB"
                                                            Padding="6,2">
                                                        <Label Text="{Binding StatusText}"
                                                               TextColor="{Binding StatusColor}"
                                                               FontFamily="OpenSansSemibold"
                                                               FontSize="10" />
                                                    </Border>
                                                </HorizontalStackLayout>
                                            </VerticalStackLayout>

                                            <!-- Actions Right Column -->
                                            <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                                <Button Text="✓ Выполнить"
                                                        BackgroundColor="#4152B0"
                                                        TextColor="#FFFFFF"
                                                        FontFamily="OpenSansSemibold"
                                                        FontSize="11"
                                                        HeightRequest="34"
                                                        CornerRadius="8"
                                                        Padding="10,0"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:NotificationsViewModel}}, Path=CompleteReminderCommand}"
                                                        CommandParameter="{Binding .}" />
                                                <Button Text="✕"
                                                        BackgroundColor="#FEECEB"
                                                        TextColor="#E53935"
                                                        FontFamily="OpenSansSemibold"
                                                        FontSize="12"
                                                        HeightRequest="34"
                                                        WidthRequest="34"
                                                        CornerRadius="8"
                                                        Padding="0"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:NotificationsViewModel}}, Path=DeleteReminderCommand}"
                                                        CommandParameter="{Binding .}" />
                                            </HorizontalStackLayout>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </RefreshView>
                </Grid>
            </Grid>
        </Grid>

    </Grid>
</ContentPage>
