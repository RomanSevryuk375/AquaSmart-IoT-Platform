<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Mobile.ViewModels"
             x:Class="Mobile.Views.SecuritySettingsPage"
             x:DataType="vm:SecuritySettingsViewModel"
             BackgroundColor="{AppThemeBinding Light='#F6F7FC', Dark='#12131A'}"
             Shell.NavBarIsVisible="False"
             Title="Безопасность">

    <Grid RowDefinitions="Auto,*" Padding="20,16,20,10">
        <!-- Top Bar: Back Button, Title, Bell matching Figma 781:12659 -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="0,4,0,16">
            <Border Grid.Column="0"
                    WidthRequest="38" HeightRequest="38"
                    StrokeShape="RoundRectangle 10"
                    BackgroundColor="{AppThemeBinding Light='#FFFFFF', Dark='#1E202C'}"
                    StrokeThickness="1"
                    Stroke="{AppThemeBinding Light='#E4E7F4', Dark='#2C2F42'}">
                <ImageButton Source="icon_chevron_left.png"
                             Command="{Binding GoBackCommand}"
                             BackgroundColor="Transparent"
                             WidthRequest="20" HeightRequest="20"
                             Padding="0"
                             HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>

            <Label Grid.Column="1"
                   Text="Безопасность"
                   TextColor="{AppThemeBinding Light='#141414', Dark='#F4F5FB'}"
                   FontFamily="OpenSansSemibold"
                   FontSize="18"
                   FontAttributes="Bold"
                   VerticalOptions="Center" />

            <Border Grid.Column="2"
                    WidthRequest="38" HeightRequest="38"
                    StrokeShape="RoundRectangle 10"
                    BackgroundColor="{AppThemeBinding Light='#FFFFFF', Dark='#1E202C'}"
                    StrokeThickness="1"
                    Stroke="{AppThemeBinding Light='#E4E7F4', Dark='#2C2F42'}">
                <ImageButton Source="icon_bell.png"
                             Command="{Binding OpenNotificationsCommand}"
                             BackgroundColor="Transparent"
                             WidthRequest="18" HeightRequest="18"
                             Padding="0"
                             HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
        </Grid>

        <!-- Scrollable Security Sections -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="20" Padding="0,0,0,24">
                <!-- 1. Вход в приложение -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Вход в приложение"
                           TextColor="{AppThemeBinding Light='#141414', Dark='#F4F5FB'}"
                           FontFamily="OpenSansSemibold"
                           FontSize="16"
                           FontAttributes="Bold" />

                    <Border StrokeThickness="1"
                            Stroke="{AppThemeBinding Light='#E8EAF5', Dark='#2C2F42'}"
                            StrokeShape="RoundRectangle 16"
                            BackgroundColor="{AppThemeBinding Light='#FFFFFF', Dark='#1E202C'}"
                            Padding="16,6">
                        <VerticalStackLayout Spacing="0">
                            <!-- Использовать Face ID -->
                            <Grid ColumnDefinitions="*,Auto" HeightRequest="52">
                                <Label Text="Использовать Face ID" TextColor="{AppThemeBinding Light='#141414', Dark='#F4F5FB'}" FontFamily="OpenSansSemibold" FontSize="15" VerticalOptions="Center" />
                                <Switch Grid.Column="1"
                                        IsToggled="{Binding UseFaceId}"
                                        OnColor="#4152B0"
                                        VerticalOptions="Center" />
                            </Grid>

                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light='#F0F2F9', Dark='#26283B'}" />

                            <!-- Код-пароль (ПИН) -->
                            <Grid ColumnDefinitions="*,Auto" HeightRequest="52">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ChangePinCommand}" />
                                </Grid.GestureRecognizers>
                                <Label Text="Код-пароль (ПИН)" TextColor="{AppThemeBinding Light='#141414', Dark='#F4F5FB'}" FontFamily="OpenSansSemibold" FontSize="15" VerticalOptions="Center" />
                                <Image Grid.Column="1" Source="icon_chevron_right.png" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                            </Grid>

                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light='#F0F2F9', Dark='#26283B'}" />

                            <!-- Автоблокировка -->
                            <Grid ColumnDefinitions="*,Auto" HeightRequest="56">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ChooseAutoLockCommand}" />
                                </Grid.GestureRecognizers>
                                <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                                    <Label Text="Автоблокировка" TextColor="{AppThemeBinding Light='#141414', Dark='#F4F5FB'}" FontFamily="OpenSansSemibold" FontSize="15" />
                                    <Label Text="{Binding AutoLockDuration}" TextColor="{AppThemeBinding Light='#6E6E6E', Dark='#9FA3B8'}" FontSize="13" />
                                </VerticalStackLayout>
                                <Image Grid.Column="1" Source="icon_chevron_right.png" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- 2. Аккаунт -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Аккаунт"
                           TextColor="{AppThemeBinding Light='#141414', Dark='#F4F5FB'}"
                           FontFamily="OpenSansSemibold"
                           FontSize="16"
                           FontAttributes="Bold" />

                    <Border StrokeThickness="1"
                            Stroke="{AppThemeBinding Light='#E8EAF5', Dark='#2C2F42'}"
                            StrokeShape="RoundRectangle 16"
                            BackgroundColor="{AppThemeBinding Light='#FFFFFF', Dark='#1E202C'}"
                            Padding="16,6">
                        <VerticalStackLayout Spacing="0">
                            <!-- Изменить пароль -->
                            <Grid ColumnDefinitions="*,Auto" HeightRequest="52">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ChangePasswordCommand}" />
                                </Grid.GestureRecognizers>
                                <Label Text="Изменить пароль" TextColor="{AppThemeBinding Light='#141414', Dark='#F4F5FB'}" FontFamily="OpenSansSemibold" FontSize="15" VerticalOptions="Center" />
                                <Image Grid.Column="1" Source="icon_chevron_right.png" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                            </Grid>

                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light='#F0F2F9', Dark='#26283B'}" />

                            <!-- Двухфакторный вход (2FA) -->
                            <Grid ColumnDefinitions="*,Auto" HeightRequest="52">
                                <Label Text="Двухфакторный вход (2FA)" TextColor="{AppThemeBinding Light='#141414', Dark='#F4F5FB'}" FontFamily="OpenSansSemibold" FontSize="15" VerticalOptions="Center" />
                                <Switch Grid.Column="1"
                                        IsToggled="{Binding TwoFactorEnabled}"
                                        OnColor="#4152B0"
                                        VerticalOptions="Center" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- 3. Управление -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Управление"
                           TextColor="{AppThemeBinding Light='#141414', Dark='#F4F5FB'}"
                           FontFamily="OpenSansSemibold"
                           FontSize="16"
                           FontAttributes="Bold" />

                    <Border StrokeThickness="1"
                            Stroke="{AppThemeBinding Light='#E8EAF5', Dark='#2C2F42'}"
                            StrokeShape="RoundRectangle 16"
                            BackgroundColor="{AppThemeBinding Light='#FFFFFF', Dark='#1E202C'}"
                            Padding="16,6">
                        <Grid ColumnDefinitions="*,Auto" HeightRequest="52">
                            <Label Text="Запрос PIN при пуске реле" TextColor="{AppThemeBinding Light='#141414', Dark='#F4F5FB'}" FontFamily="OpenSansSemibold" FontSize="15" VerticalOptions="Center" />
                            <Switch Grid.Column="1"
                                    IsToggled="{Binding PinForRelay}"
                                    OnColor="#4152B0"
                                    VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
