<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Mobile.ViewModels"
             xmlns:models="clr-namespace:Mobile.Models"
             xmlns:loc="clr-namespace:Mobile.Converters"
             x:Class="Mobile.Views.AquariumsPage"
             x:DataType="vm:AquariumsViewModel"
             BackgroundColor="{AppThemeBinding Light='#FFFFFF', Dark='#12131A'}"
             Shell.NavBarIsVisible="False"
             Title="{loc:Translate Nav_Tanks}">

    <Grid RowDefinitions="Auto,*,Auto" Padding="20,24,20,20">
        <!-- Top Header: Title & Action Icons (Figma: 0. Емкости) -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12" Margin="0,4,0,16">
            <Label Grid.Column="0"
                   Text="{loc:Translate Tanks_Title}"
                   TextColor="{AppThemeBinding Light='#141414', Dark='#F4F5FB'}"
                   FontFamily="OpenSansSemibold"
                   FontSize="22"
                   FontAttributes="Bold"
                   VerticalOptions="Center" />

            <!-- Add Button (+) -->
            <Border Grid.Column="1"
                    WidthRequest="38" HeightRequest="38"
                    StrokeShape="RoundRectangle 10"
                    BackgroundColor="{AppThemeBinding Light='#F6F7FC', Dark='#1E202C'}"
                    StrokeThickness="0">
                <ImageButton Source="{AppThemeBinding Light='icon_plus.png', Dark='icon_plus_white.png'}"
                             Command="{Binding AddAquariumCommand}"
                             BackgroundColor="Transparent"
                             WidthRequest="20" HeightRequest="20"
                             Padding="0"
                             HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>

            <!-- Notifications Button (Bell) -->
            <Border Grid.Column="2"
                    WidthRequest="38" HeightRequest="38"
                    StrokeShape="RoundRectangle 10"
                    BackgroundColor="{AppThemeBinding Light='#F6F7FC', Dark='#1E202C'}"
                    StrokeThickness="0">
                <ImageButton Source="{AppThemeBinding Light='icon_bell.png', Dark='icon_bell_white.png'}"
                             Command="{Binding OpenNotificationsCommand}"
                             BackgroundColor="Transparent"
                             WidthRequest="20" HeightRequest="20"
                             Padding="0"
                             HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
        </Grid>

        <!-- Main Scrollable List of Tank Cards (CardContainer variants) -->
        <ScrollView Grid.Row="1" x:Name="ListScroll">
            <VerticalStackLayout Spacing="14" Margin="0,0,0,16">
                <!-- Empty State -->
                <Border IsVisible="{Binding HasNoAquariums}"
                        StrokeThickness="1"
                        Stroke="{AppThemeBinding Light='#E1E4F2', Dark='#2C2F42'}"
                        StrokeShape="RoundRectangle 16"
                        BackgroundColor="{AppThemeBinding Light='#FFFFFF', Dark='#1E202C'}"
                        Padding="28"
                        Margin="0,20,0,0">
                    <VerticalStackLayout Spacing="16" HorizontalOptions="Center">
                        <Border WidthRequest="80" HeightRequest="80"
                                StrokeShape="RoundRectangle 40"
                                BackgroundColor="{AppThemeBinding Light='#EDEFFB', Dark='#2A2D3E'}"
                                StrokeThickness="0"
                                HorizontalOptions="Center">
                            <Label Text="🐟" FontSize="36" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>

                        <Label Text="{loc:Translate Tanks_EmptyTitle}"
                               TextColor="{AppThemeBinding Light='#141414', Dark='#F4F5FB'}"
                               FontFamily="OpenSansSemibold"
                               FontSize="18"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center" />

                        <Label Text="{loc:Translate Tanks_EmptyDesc}"
                               TextColor="{AppThemeBinding Light='#6E6E6E', Dark='#9FA3B8'}"
                               FontSize="14"
                               HorizontalTextAlignment="Center" />

                        <Button Text="{loc:Translate Tanks_AddFirst}"
                                Command="{Binding AddAquariumCommand}"
                                BackgroundColor="#4152B0"
                                TextColor="#FFFFFF"
                                CornerRadius="12"
                                HeightRequest="48"
                                Padding="20,0"
                                FontFamily="OpenSansSemibold"
                                FontSize="14"
                                Margin="0,8,0,0" />
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Aquariums}"
                                     IsVisible="{Binding HasAquariums}"
                                     Spacing="14">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:AquariumModel">
                            <!-- CardContainer with Theme Color -->
                            <Border StrokeThickness="1"
                                    Stroke="{AppThemeBinding Light='#E4E7F4', Dark='#2C2F42'}"
                                    StrokeShape="RoundRectangle 16"
                                    BackgroundColor="{AppThemeBinding Light='#FFFFFF', Dark='#1E202C'}"
                                    Padding="18,16">
                                <Border.Shadow>
                                    <Shadow Brush="#0A000000" Offset="0,4" Radius="8" Opacity="0.5" />
                                </Border.Shadow>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AquariumsViewModel}}, Path=SelectAquariumCommand}"
                                                          CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>

                                <VerticalStackLayout Spacing="10">
                                    <!-- Top Row: Icon + Name and Temperature -->
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                        <Border Grid.Column="0"
                                                WidthRequest="36" HeightRequest="36"
                                                StrokeShape="RoundRectangle 8"
                                                BackgroundColor="{Binding CardThemeColor}"
                                                StrokeThickness="0">
                                            <Label Text="{Binding Icon}" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>
                                        <Label Grid.Column="1"
                                               Text="{Binding Name}"
                                               TextColor="{AppThemeBinding Light='#141414', Dark='#F4F5FB'}"
                                               FontFamily="OpenSansSemibold"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               VerticalOptions="Center" />
                                        <Label Grid.Column="2"
                                               Text="{Binding TemperatureDisplay}"
                                               TextColor="{AppThemeBinding Light='#141414', Dark='#F4F5FB'}"
                                               FontFamily="OpenSansSemibold"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               VerticalOptions="Center" />
                                    </Grid>

                                    <!-- Subtitle: Tank type, Volume, Controller -->
                                    <Label TextColor="{AppThemeBinding Light='#6E6E6E', Dark='#9FA3B8'}" FontSize="12">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding TankTypeSubtitle}" />
                                                <Span Text=" • " />
                                                <Span Text="{Binding ControllerName}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>

                                    <!-- Status Badge Pill -->
                                    <HorizontalStackLayout Spacing="6" Margin="0,4,0,0">
                                        <BoxView WidthRequest="8" HeightRequest="8"
                                                 CornerRadius="4"
                                                 Color="{Binding StatusDotColor}"
                                                 VerticalOptions="Center" />
                                        <Label Text="{Binding StatusSummary}"
                                               TextColor="{Binding StatusDotColor}"
                                               FontFamily="OpenSansSemibold"
                                               FontSize="12"
                                               VerticalOptions="Center" />
                                    </HorizontalStackLayout>

                                    <!-- Bottom Device Counts: Dat. / Relays -->
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                        <Label Grid.Column="0" TextColor="{AppThemeBinding Light='#8C93A8', Dark='#7E839B'}" FontSize="12">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding SensorsCount}" />
                                                    <Span Text=" • " />
                                                    <Span Text="{Binding RelaysCount}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                        <Label Grid.Column="1" Text="{loc:Translate Tanks_Details}" TextColor="#4152B0" FontFamily="OpenSansSemibold" FontSize="12" VerticalOptions="Center" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Bottom Action Button: Add Aquarium -->
        <Button Grid.Row="2"
                x:Name="AddButton"
                Text="{loc:Translate Tanks_AddFirst}"
                Command="{Binding AddAquariumCommand}"
                BackgroundColor="#4152B0"
                TextColor="#FFFFFF"
                FontFamily="OpenSansSemibold"
                FontSize="15"
                CornerRadius="12"
                HeightRequest="48"
                Margin="0,8,0,0">
            <Button.Shadow>
                <Shadow Brush="#254152B0" Offset="0,4" Radius="8" Opacity="0.6" />
            </Button.Shadow>
        </Button>
    </Grid>
</ContentPage>
