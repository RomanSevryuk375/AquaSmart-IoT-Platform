<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Mobile.ViewModels"
             xmlns:models="clr-namespace:Mobile.Models"
             x:Class="Mobile.Views.AquariumsPage"
             x:DataType="vm:AquariumsViewModel"
             BackgroundColor="#F6F7FC"
             Title="Ёмкости">

    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0" x:Name="ListScroll">
            <VerticalStackLayout Padding="20,16,20,32" Spacing="16">
                <Label Text="Список подключенных ёмкостей"
                       TextColor="#6E6E6E"
                       FontSize="14" />

                <CollectionView ItemsSource="{Binding Aquariums}" SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="14" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:AquariumModel">
                            <Border StrokeThickness="1"
                                    Stroke="#E1E4F2"
                                    StrokeShape="RoundRectangle 16"
                                    BackgroundColor="#FFFFFF"
                                    Padding="18">
                                <Border.Shadow>
                                    <Shadow Brush="#10000000" Offset="0,4" Radius="8" Opacity="0.5" />
                                </Border.Shadow>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AquariumsViewModel}}, Path=SelectAquariumCommand}"
                                                          CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>

                                <VerticalStackLayout Spacing="12">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label Text="{Binding Name}" TextColor="#141414" FontFamily="OpenSansSemibold" FontSize="18" FontAttributes="Bold" />
                                            <Label Text="{Binding SpeciesInfo}" TextColor="#6E6E6E" FontSize="13" />
                                        </VerticalStackLayout>
                                        <Border Grid.Column="1" BackgroundColor="#EDEFFB" StrokeShape="RoundRectangle 8" Padding="8,4" StrokeThickness="0">
                                            <Label Text="{Binding WaterTypeDisplay}" TextColor="#4152B0" FontSize="12" FontFamily="OpenSansSemibold" />
                                        </Border>
                                    </Grid>

                                    <!-- Grid metrics -->
                                    <Grid ColumnDefinitions="*,*,*,*" Margin="0,4,0,0">
                                        <VerticalStackLayout Grid.Column="0">
                                            <Label Text="Объём" TextColor="#919191" FontSize="11" />
                                            <Label Text="{Binding VolumeLiters, StringFormat='{0} л'}" TextColor="#141414" FontFamily="OpenSansSemibold" FontSize="14" />
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1">
                                            <Label Text="Температура" TextColor="#919191" FontSize="11" />
                                            <Label Text="{Binding Temperature, StringFormat='{0:F1}°C'}" TextColor="#4152B0" FontFamily="OpenSansSemibold" FontSize="14" />
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="2">
                                            <Label Text="pH" TextColor="#919191" FontSize="11" />
                                            <Label Text="{Binding Ph, StringFormat='{0:F1}'}" TextColor="#4152B0" FontFamily="OpenSansSemibold" FontSize="14" />
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="3">
                                            <Label Text="Датчики" TextColor="#919191" FontSize="11" />
                                            <Label Text="{Binding SensorsCount, StringFormat='{0} шт'}" TextColor="#141414" FontFamily="OpenSansSemibold" FontSize="14" />
                                        </VerticalStackLayout>
                                    </Grid>

                                    <BoxView HeightRequest="1" Color="#EDEFFB" />

                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Grid.Column="0" Text="{Binding StatusText}" TextColor="{Binding StatusColor}" FontSize="13" FontFamily="OpenSansSemibold" VerticalOptions="Center" />
                                        <Label Grid.Column="1" Text="Подробнее →" TextColor="#4152B0" FontSize="13" FontFamily="OpenSansSemibold" VerticalOptions="Center" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Floating Action Button: Add Aquarium -->
        <Button Grid.Row="1"
                x:Name="AddButton"
                Text="+ Добавить новую ёмкость"
                Command="{Binding AddAquariumCommand}"
                BackgroundColor="#4152B0"
                TextColor="#FFFFFF"
                FontFamily="OpenSansSemibold"
                FontSize="16"
                CornerRadius="14"
                HeightRequest="52"
                Margin="20,12,20,20">
            <Button.Shadow>
                <Shadow Brush="#404152B0" Offset="0,4" Radius="10" Opacity="0.9" />
            </Button.Shadow>
        </Button>
    </Grid>
</ContentPage>
