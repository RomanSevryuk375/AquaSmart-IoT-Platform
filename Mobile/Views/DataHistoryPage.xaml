<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Mobile.ViewModels"
             x:Class="Mobile.Views.DataHistoryPage"
             x:DataType="vm:DataHistoryViewModel"
             BackgroundColor="#F6F7FC"
             Shell.NavBarIsVisible="False"
             Title="Данные и история">

    <Grid RowDefinitions="Auto,*" Padding="20,16,20,10">
        <!-- Top Bar: Back Button, Title, Bell matching Figma 781:12808 -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="0,4,0,16">
            <Border Grid.Column="0"
                    WidthRequest="38" HeightRequest="38"
                    StrokeShape="RoundRectangle 10"
                    BackgroundColor="#FFFFFF"
                    StrokeThickness="1"
                    Stroke="#E4E7F4">
                <ImageButton Source="icon_chevron_left.png"
                             Command="{Binding GoBackCommand}"
                             BackgroundColor="Transparent"
                             WidthRequest="20" HeightRequest="20"
                             Padding="0"
                             HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>

            <Label Grid.Column="1"
                   Text="Данные и история"
                   TextColor="#141414"
                   FontFamily="OpenSansSemibold"
                   FontSize="18"
                   FontAttributes="Bold"
                   VerticalOptions="Center" />

            <Border Grid.Column="2"
                    WidthRequest="38" HeightRequest="38"
                    StrokeShape="RoundRectangle 10"
                    BackgroundColor="#FFFFFF"
                    StrokeThickness="1"
                    Stroke="#E4E7F4">
                <ImageButton Source="icon_bell.png"
                             Command="{Binding OpenNotificationsCommand}"
                             BackgroundColor="Transparent"
                             WidthRequest="18" HeightRequest="18"
                             Padding="0"
                             HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
        </Grid>

        <!-- Scrollable Content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="20" Padding="0,0,0,24">
                <!-- 1. Архив показаний -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Архив показаний"
                           TextColor="#141414"
                           FontFamily="OpenSansSemibold"
                           FontSize="16"
                           FontAttributes="Bold" />

                    <Border StrokeThickness="1"
                            Stroke="#E8EAF5"
                            StrokeShape="RoundRectangle 16"
                            BackgroundColor="#FFFFFF"
                            Padding="16,6">
                        <VerticalStackLayout Spacing="0">
                            <!-- Хранить историю -->
                            <Grid ColumnDefinitions="*,Auto" HeightRequest="56">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ChooseHistoryDurationCommand}" />
                                </Grid.GestureRecognizers>
                                <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                                    <Label Text="Хранить историю" TextColor="#141414" FontFamily="OpenSansSemibold" FontSize="15" />
                                    <Label Text="{Binding HistoryDuration}" TextColor="#6E6E6E" FontSize="13" />
                                </VerticalStackLayout>
                                <Image Grid.Column="1" Source="icon_chevron_right.png" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                            </Grid>

                            <BoxView HeightRequest="1" Color="#F0F2F9" />

                            <!-- Очистить кэш графиков -->
                            <Grid ColumnDefinitions="*,Auto" HeightRequest="56">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ClearCacheCommand}" />
                                </Grid.GestureRecognizers>
                                <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                                    <Label Text="Очистить кэш графиков" TextColor="#141414" FontFamily="OpenSansSemibold" FontSize="15" />
                                    <Label Text="{Binding CacheSize}" TextColor="#6E6E6E" FontSize="13" />
                                </VerticalStackLayout>
                                <Image Grid.Column="1" Source="icon_chevron_right.png" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- 2. Отчеты -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Отчеты"
                           TextColor="#141414"
                           FontFamily="OpenSansSemibold"
                           FontSize="16"
                           FontAttributes="Bold" />

                    <Border StrokeThickness="1"
                            Stroke="#E8EAF5"
                            StrokeShape="RoundRectangle 16"
                            BackgroundColor="#FFFFFF"
                            Padding="16,6">
                        <Grid ColumnDefinitions="*,Auto" HeightRequest="52">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ExportCsvCommand}" />
                            </Grid.GestureRecognizers>
                            <Label Text="Экспорт в Excel (CSV)" TextColor="#141414" FontFamily="OpenSansSemibold" FontSize="15" VerticalOptions="Center" />
                            <Image Grid.Column="1" Source="icon_chevron_right.png" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- 3. Резервное копирование -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Резервное копирование"
                           TextColor="#141414"
                           FontFamily="OpenSansSemibold"
                           FontSize="16"
                           FontAttributes="Bold" />

                    <Border StrokeThickness="1"
                            Stroke="#E8EAF5"
                            StrokeShape="RoundRectangle 16"
                            BackgroundColor="#FFFFFF"
                            Padding="16,6">
                        <VerticalStackLayout Spacing="0">
                            <!-- Автобэкап в облако -->
                            <Grid ColumnDefinitions="*,Auto" HeightRequest="52">
                                <Label Text="Автобэкап в облако" TextColor="#141414" FontFamily="OpenSansSemibold" FontSize="15" VerticalOptions="Center" />
                                <Switch Grid.Column="1"
                                        IsToggled="{Binding CloudBackup}"
                                        OnColor="#4152B0"
                                        VerticalOptions="Center" />
                            </Grid>

                            <BoxView HeightRequest="1" Color="#F0F2F9" />

                            <!-- Создать копию настроек -->
                            <Grid ColumnDefinitions="*,Auto" HeightRequest="52">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding CreateBackupCommand}" />
                                </Grid.GestureRecognizers>
                                <Label Text="Создать копию настроек" TextColor="#141414" FontFamily="OpenSansSemibold" FontSize="15" VerticalOptions="Center" />
                                <Image Grid.Column="1" Source="icon_chevron_right.png" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                            </Grid>

                            <BoxView HeightRequest="1" Color="#F0F2F9" />

                            <!-- Восстановить из бэкапа -->
                            <Grid ColumnDefinitions="*,Auto" HeightRequest="52">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding RestoreBackupCommand}" />
                                </Grid.GestureRecognizers>
                                <Label Text="Восстановить из бэкапа" TextColor="#141414" FontFamily="OpenSansSemibold" FontSize="15" VerticalOptions="Center" />
                                <Image Grid.Column="1" Source="icon_chevron_right.png" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
