<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Mobile.ViewModels"
             x:Class="Mobile.Views.ArticleDetailsPage"
             x:DataType="vm:ArticleDetailsViewModel"
             BackgroundColor="{AppThemeBinding Light='#FFFFFF', Dark='#12131A'}"
             Shell.NavBarIsVisible="False"
             Title="Статья">

    <Grid RowDefinitions="Auto,*" Padding="20,16,20,10">
        <!-- Top Bar matching Figma: <  Статья: [Категория] -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="0,4,0,16">
            <Border Grid.Column="0"
                    WidthRequest="38" HeightRequest="38"
                    StrokeShape="RoundRectangle 10"
                    BackgroundColor="{AppThemeBinding Light='#F6F7FC', Dark='#1E202C'}"
                    StrokeThickness="0">
                <ImageButton Source="{AppThemeBinding Light='icon_chevron_left.png', Dark='icon_chevron_left_white.png'}"
                             Command="{Binding GoBackCommand}"
                             BackgroundColor="Transparent"
                             WidthRequest="20" HeightRequest="20"
                             Padding="0"
                             HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>

            <HorizontalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                <Label Text="Статья: "
                       TextColor="{AppThemeBinding Light='#141414', Dark='#FFFFFF'}"
                       FontFamily="OpenSansSemibold"
                       FontSize="18"
                       FontAttributes="Bold" />
                <Label Text="{Binding Article.Category}"
                       TextColor="{AppThemeBinding Light='#141414', Dark='#FFFFFF'}"
                       FontFamily="OpenSansSemibold"
                       FontSize="18"
                       FontAttributes="Bold" />
            </HorizontalStackLayout>
        </Grid>

        <!-- Article Content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="14" Padding="0,0,0,30">
                <!-- Article Title -->
                <Label Text="{Binding Article.Title}"
                       TextColor="{AppThemeBinding Light='#141414', Dark='#FFFFFF'}"
                       FontFamily="OpenSansSemibold"
                       FontSize="22"
                       FontAttributes="Bold"
                       LineBreakMode="WordWrap"
                       Margin="0,4,0,8" />

                <!-- Subtitle 1 -->
                <Label Text="{Binding Article.Subtitle1}"
                       IsVisible="{Binding Article.Subtitle1, Converter={StaticResource StringIsNotNullOrEmptyConverter}}"
                       TextColor="{AppThemeBinding Light='#141414', Dark='#FFFFFF'}"
                       FontFamily="OpenSansSemibold"
                       FontSize="16"
                       FontAttributes="Bold" />

                <!-- Paragraph 1 -->
                <Label Text="{Binding Article.Paragraph1}"
                       IsVisible="{Binding Article.Paragraph1, Converter={StaticResource StringIsNotNullOrEmptyConverter}}"
                       TextColor="{AppThemeBinding Light='#2E2E2E', Dark='#D0D3E2'}"
                       FontSize="14"
                       LineHeight="1.3"
                       LineBreakMode="WordWrap" />

                <!-- Subtitle 2 -->
                <Label Text="{Binding Article.Subtitle2}"
                       IsVisible="{Binding Article.Subtitle2, Converter={StaticResource StringIsNotNullOrEmptyConverter}}"
                       TextColor="{AppThemeBinding Light='#141414', Dark='#FFFFFF'}"
                       FontFamily="OpenSansSemibold"
                       FontSize="16"
                       FontAttributes="Bold"
                       Margin="0,8,0,0" />

                <!-- Paragraph 2 -->
                <Label Text="{Binding Article.Paragraph2}"
                       IsVisible="{Binding Article.Paragraph2, Converter={StaticResource StringIsNotNullOrEmptyConverter}}"
                       TextColor="{AppThemeBinding Light='#2E2E2E', Dark='#D0D3E2'}"
                       FontSize="14"
                       LineHeight="1.3"
                       LineBreakMode="WordWrap" />

                <!-- Tip Callout Box (Green) -->
                <Border IsVisible="{Binding Article.CalloutTip, Converter={StaticResource StringIsNotNullOrEmptyConverter}}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 12"
                        BackgroundColor="{AppThemeBinding Light='#D4EED8', Dark='#1D3B2A'}"
                        Padding="16,14"
                        Margin="0,6,0,6">
                    <Label Text="{Binding Article.CalloutTip}"
                           TextColor="{AppThemeBinding Light='#1B5E20', Dark='#81C784'}"
                           FontFamily="OpenSansSemibold"
                           FontSize="13"
                           LineHeight="1.2"
                           LineBreakMode="WordWrap" />
                </Border>

                <!-- Subtitle 3 -->
                <Label Text="{Binding Article.Subtitle3}"
                       IsVisible="{Binding Article.Subtitle3, Converter={StaticResource StringIsNotNullOrEmptyConverter}}"
                       TextColor="{AppThemeBinding Light='#141414', Dark='#FFFFFF'}"
                       FontFamily="OpenSansSemibold"
                       FontSize="16"
                       FontAttributes="Bold"
                       Margin="0,8,0,0" />

                <!-- Paragraph 3 -->
                <Label Text="{Binding Article.Paragraph3}"
                       IsVisible="{Binding Article.Paragraph3, Converter={StaticResource StringIsNotNullOrEmptyConverter}}"
                       TextColor="{AppThemeBinding Light='#2E2E2E', Dark='#D0D3E2'}"
                       FontSize="14"
                       LineHeight="1.3"
                       LineBreakMode="WordWrap" />

                <!-- Warning Callout Box (Yellow/Amber) -->
                <Border IsVisible="{Binding Article.CalloutWarning, Converter={StaticResource StringIsNotNullOrEmptyConverter}}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 12"
                        BackgroundColor="{AppThemeBinding Light='#FBEACB', Dark='#3D3017'}"
                        Padding="16,14"
                        Margin="0,6,0,6">
                    <Label Text="{Binding Article.CalloutWarning}"
                           TextColor="{AppThemeBinding Light='#8D5B00', Dark='#FFD54F'}"
                           FontFamily="OpenSansSemibold"
                           FontSize="13"
                           LineHeight="1.2"
                           LineBreakMode="WordWrap" />
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
