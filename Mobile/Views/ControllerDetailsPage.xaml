<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Mobile.ViewModels"
             xmlns:controls="clr-namespace:Mobile.Views.Controls"
             x:Class="Mobile.Views.ControllerDetailsPage"
             x:DataType="vm:ControllerDetailsViewModel"
             BackgroundColor="#FFFFFF"
             Shell.NavBarIsVisible="False"
             Title="{Binding Name, FallbackValue='Контроллер'}">

    <Grid>
        <!-- Main Form Content -->
        <Grid RowDefinitions="Auto,*,Auto" Padding="20,16,20,20">
            <!-- Top Bar: Back Arrow, Title & Subtitle -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="0,4,0,16">
                <Border Grid.Column="0"
                        WidthRequest="38" HeightRequest="38"
                        StrokeShape="RoundRectangle 10"
                        BackgroundColor="#F6F7FC"
                        StrokeThickness="0"
                        VerticalOptions="Center">
                    <ImageButton Source="icon_arrow_left.png"
                                 Command="{Binding GoBackCommand}"
                                 BackgroundColor="Transparent"
                                 WidthRequest="20" HeightRequest="20"
                                 Padding="0"
                                 HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>

                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                    <Label Text="{Binding Name}"
                           TextColor="#141414"
                           FontFamily="OpenSansSemibold"
                           FontSize="18"
                           FontAttributes="Bold" />
                    <HorizontalStackLayout Spacing="6">
                        <Label Text="{Binding MacAddress}" TextColor="#8C93A8" FontSize="12" />
                        <Label Text="•" TextColor="#8C93A8" FontSize="12" />
                        <Label Text="В сети" TextColor="#4CAF50" FontFamily="OpenSansSemibold" FontSize="12" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Grid>

            <!-- Scrollable Form Fields -->
            <ScrollView Grid.Row="1">
                <VerticalStackLayout Spacing="16" Padding="0,0,0,20">
                    <!-- 1. Код контроллера -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Код контроллера" TextColor="#141414" FontFamily="OpenSansSemibold" FontSize="14" />
                        <Border StrokeThickness="1" Stroke="#E4E7F4" StrokeShape="RoundRectangle 12" BackgroundColor="#FFFFFF" HeightRequest="50" Padding="14,0">
                            <Entry Text="{Binding ControllerCode}"
                                   TextColor="#141414"
                                   VerticalOptions="Center" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- 2. Название контроллера -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Название контроллера" TextColor="#141414" FontFamily="OpenSansSemibold" FontSize="14" />
                        <Border StrokeThickness="1" Stroke="#E4E7F4" StrokeShape="RoundRectangle 12" BackgroundColor="#FFFFFF" HeightRequest="50" Padding="14,0">
                            <Entry Text="{Binding Name}"
                                   TextColor="#141414"
                                   VerticalOptions="Center" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- 3. MAC-адрес контроллера -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="MAC-адрес контроллера" TextColor="#141414" FontFamily="OpenSansSemibold" FontSize="14" />
                        <Border StrokeThickness="1" Stroke="#E4E7F4" StrokeShape="RoundRectangle 12" BackgroundColor="#FFFFFF" HeightRequest="50" Padding="14,0">
                            <Entry Text="{Binding MacAddress}"
                                   TextColor="#141414"
                                   VerticalOptions="Center" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- 4. Включен (Состояние контроллера) -->
                    <Border StrokeThickness="1"
                            Stroke="#E4E7F4"
                            StrokeShape="RoundRectangle 14"
                            BackgroundColor="#FFFFFF"
                            Padding="16,12"
                            Margin="0,4,0,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                                <Label Text="Включен" TextColor="#141414" FontFamily="OpenSansSemibold" FontSize="15" />
                                <Label Text="Состояние контроллера" TextColor="#8C93A8" FontSize="12" />
                            </VerticalStackLayout>

                            <Switch Grid.Column="1"
                                    IsToggled="{Binding IsEnabled}"
                                    OnColor="#4152B0"
                                    ThumbColor="#FFFFFF"
                                    VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </ScrollView>

            <!-- Action Buttons matching Figma -->
            <VerticalStackLayout Grid.Row="2" Spacing="10">
                <Button Text="Сохранить изменения"
                        Command="{Binding SaveCommand}"
                        BackgroundColor="#4152B0"
                        TextColor="#FFFFFF"
                        CornerRadius="14"
                        HeightRequest="52"
                        FontFamily="OpenSansSemibold"
                        FontSize="15" />

                <Button Text="Удалить контроллер"
                        Command="{Binding PromptDeleteCommand}"
                        BackgroundColor="Transparent"
                        TextColor="#D93829"
                        FontFamily="OpenSansSemibold"
                        FontSize="14"
                        HeightRequest="44" />
            </VerticalStackLayout>
        </Grid>

        <!-- Delete Confirmation Overlay (Figma: Удаление контроллера) -->
        <Grid BackgroundColor="#80000000" IsVisible="{Binding IsDeleteDialogVisible}">
            <Border VerticalOptions="End"
                    StrokeShape="RoundRectangle 24 24 0 0"
                    BackgroundColor="#FFFFFF"
                    StrokeThickness="0"
                    Padding="24,24,24,32">
                <VerticalStackLayout Spacing="18">
                    <!-- Fish Mascot with Question Badge -->
                    <controls:FishMascotCard HeightOverride="200" BadgeText="?" BadgeColor="#7BA028" />

                    <!-- Titles -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Вы уверены, что хотите&#10;удалить контроллер?"
                               TextColor="#141414"
                               FontFamily="OpenSansSemibold"
                               FontSize="20"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center" />
                        <Label Text="Все данные контроллера будут удалены"
                               TextColor="#6E6E6E"
                               FontSize="14"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>

                    <!-- Buttons -->
                    <VerticalStackLayout Spacing="10" Margin="0,6,0,0">
                        <Button Text="Да, удалить"
                                Command="{Binding ConfirmDeleteCommand}"
                                BackgroundColor="#B72B2B"
                                TextColor="#FFFFFF"
                                CornerRadius="14"
                                HeightRequest="50"
                                FontFamily="OpenSansSemibold"
                                FontSize="15" />

                        <Button Text="Нет, отменить"
                                Command="{Binding CancelDeleteCommand}"
                                BackgroundColor="#FFFFFF"
                                BorderColor="#E4E7F4"
                                BorderWidth="1"
                                TextColor="#4152B0"
                                CornerRadius="14"
                                HeightRequest="50"
                                FontFamily="OpenSansSemibold"
                                FontSize="15" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
