<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Mobile.ViewModels"
             xmlns:controls="clr-namespace:Mobile.Views.Controls"
             x:Class="Mobile.Views.ControllerDetailsPage"
             x:DataType="vm:ControllerDetailsViewModel"
             BackgroundColor="{AppThemeBinding Light='#FFFFFF', Dark='#12131A'}"
             Shell.NavBarIsVisible="False"
             Title="{Binding Name, FallbackValue='Контроллер'}">

    <Grid>
        <!-- Main Form Content -->
        <Grid RowDefinitions="Auto,*,Auto" Padding="20,16,20,20">
            <!-- Top Bar: Back Arrow, Title & Subtitle -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="0,4,0,16">
                <Border Grid.Column="0"
                        WidthRequest="38" HeightRequest="38"
                        StrokeShape="RoundRectangle 10"
                        BackgroundColor="{AppThemeBinding Light='#F6F7FC', Dark='#1E202C'}"
                        StrokeThickness="0"
                        VerticalOptions="Center">
                    <ImageButton Source="{AppThemeBinding Light='icon_arrow_left.png', Dark='icon_arrow_left_white.png'}"
                                 Command="{Binding GoBackCommand}"
                                 BackgroundColor="Transparent"
                                 WidthRequest="20" HeightRequest="20"
                                 Padding="0"
                                 HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>

                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                    <Label Text="{Binding Name}"
                           TextColor="{AppThemeBinding Light='#141414', Dark='#FFFFFF'}"
                           FontFamily="OpenSansSemibold"
                           FontSize="18"
                           FontAttributes="Bold" />
                    <HorizontalStackLayout Spacing="6">
                        <Label Text="{Binding MacAddress}" TextColor="{AppThemeBinding Light='#8C93A8', Dark='#73778F'}" FontSize="12" />
                        <Label Text="•" TextColor="{AppThemeBinding Light='#8C93A8', Dark='#73778F'}" FontSize="12" />
                        <Label Text="В сети" TextColor="#4CAF50" FontFamily="OpenSansSemibold" FontSize="12" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Grid>

            <!-- Scrollable Form Fields -->
            <ScrollView Grid.Row="1">
                <VerticalStackLayout Spacing="16" Padding="0,0,0,20">
                    <!-- 1. Код контроллера -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Код контроллера" TextColor="{AppThemeBinding Light='#141414', Dark='#FFFFFF'}" FontFamily="OpenSansSemibold" FontSize="14" />
                        <Border StrokeThickness="1" Stroke="{AppThemeBinding Light='#E4E7F4', Dark='#2E3346'}" StrokeShape="RoundRectangle 12" BackgroundColor="{AppThemeBinding Light='#FFFFFF', Dark='#1E202C'}" HeightRequest="50" Padding="14,0">
                            <Entry Text="{Binding ControllerCode}"
                                   Placeholder="AQ-ESP32-9842"
                                   PlaceholderColor="{AppThemeBinding Light='#8C93A8', Dark='#73778F'}"
                                   TextColor="{AppThemeBinding Light='#141414', Dark='#FFFFFF'}"
                                   VerticalOptions="Center" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- 2. Название контроллера -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Название контроллера" TextColor="{AppThemeBinding Light='#141414', Dark='#FFFFFF'}" FontFamily="OpenSansSemibold" FontSize="14" />
                        <Border StrokeThickness="1" Stroke="{AppThemeBinding Light='#E4E7F4', Dark='#2E3346'}" StrokeShape="RoundRectangle 12" BackgroundColor="{AppThemeBinding Light='#FFFFFF', Dark='#1E202C'}" HeightRequest="50" Padding="14,0">
                            <Entry Text="{Binding Name}"
                                   Placeholder="Например, Контроллер №123"
                                   PlaceholderColor="{AppThemeBinding Light='#8C93A8', Dark='#73778F'}"
                                   TextColor="{AppThemeBinding Light='#141414', Dark='#FFFFFF'}"
                                   VerticalOptions="Center" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- 3. MAC-адрес контроллера -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="MAC-адрес контроллера" TextColor="{AppThemeBinding Light='#141414', Dark='#FFFFFF'}" FontFamily="OpenSansSemibold" FontSize="14" />
                        <Border StrokeThickness="1" Stroke="{AppThemeBinding Light='#E4E7F4', Dark='#2E3346'}" StrokeShape="RoundRectangle 12" BackgroundColor="{AppThemeBinding Light='#FFFFFF', Dark='#1E202C'}" HeightRequest="50" Padding="14,0">
                            <Entry Text="{Binding MacAddress}"
                                   Placeholder="00:1A:2B:3C:4D:5E"
                                   PlaceholderColor="{AppThemeBinding Light='#8C93A8', Dark='#73778F'}"
                                   TextColor="{AppThemeBinding Light='#141414', Dark='#FFFFFF'}"
                                   VerticalOptions="Center" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- 4. Включен (Состояние контроллера) -->
                    <Border StrokeThickness="1"
                            Stroke="{AppThemeBinding Light='#E4E7F4', Dark='#2E3346'}"
                            StrokeShape="RoundRectangle 14"
                            BackgroundColor="{AppThemeBinding Light='#FFFFFF', Dark='#1E202C'}"
                            Padding="16,12"
                            Margin="0,4,0,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                                <Label Text="Включен" TextColor="{AppThemeBinding Light='#141414', Dark='#FFFFFF'}" FontFamily="OpenSansSemibold" FontSize="15" />
                                <Label Text="Состояние контроллера" TextColor="{AppThemeBinding Light='#8C93A8', Dark='#73778F'}" FontSize="12" />
                            </VerticalStackLayout>

                            <Switch Grid.Column="1"
                                    IsToggled="{Binding IsEnabled}"
                                    OnColor="#4152B0"
                                    ThumbColor="#FFFFFF"
                                    VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <!-- 5. Прошивка и OTA обновления -->
                    <Border StrokeThickness="1"
                            Stroke="{AppThemeBinding Light='#E4E7F4', Dark='#2E3346'}"
                            StrokeShape="RoundRectangle 14"
                            BackgroundColor="{AppThemeBinding Light='#FFFFFF', Dark='#1E202C'}"
                            Padding="16,14"
                            Margin="0,4,0,0">
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Прошивка контроллера (OTA)" TextColor="{AppThemeBinding Light='#141414', Dark='#FFFFFF'}" FontFamily="OpenSansSemibold" FontSize="15" />
                                    <Label Text="{Binding FirmwareVersion, StringFormat='Текущая версия: {0}'}" TextColor="{AppThemeBinding Light='#8C93A8', Dark='#73778F'}" FontSize="12" />
                                </VerticalStackLayout>
                                <Border Grid.Column="1"
                                        StrokeShape="RoundRectangle 8"
                                        StrokeThickness="0"
                                        BackgroundColor="{AppThemeBinding Light='#F0F2FB', Dark='#161824'}"
                                        Padding="8,4"
                                        VerticalOptions="Center">
                                    <Label Text="{Binding OtaStatusText}"
                                           TextColor="{Binding OtaStatusColor}"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="11" />
                                </Border>
                            </Grid>

                            <Button Text="Проверить обновления"
                                    Command="{Binding CheckOtaUpdateCommand}"
                                    IsEnabled="{Binding IsCheckingOta, Converter={StaticResource InvertedBoolConverter}}"
                                    BackgroundColor="{AppThemeBinding Light='#F6F7FC', Dark='#161824'}"
                                    TextColor="{AppThemeBinding Light='#4152B0', Dark='#738AFF'}"
                                    FontFamily="OpenSansSemibold"
                                    FontSize="13"
                                    HeightRequest="42"
                                    CornerRadius="10" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </ScrollView>

            <!-- Action Buttons matching Figma -->
            <VerticalStackLayout Grid.Row="2" Spacing="10">
                <Button Text="Сохранить изменения"
                        Command="{Binding SaveCommand}"
                        BackgroundColor="#4152B0"
                        TextColor="#FFFFFF"
                        CornerRadius="14"
                        HeightRequest="52"
                        FontFamily="OpenSansSemibold"
                        FontSize="15" />

                <Button Text="Удалить контроллер"
                        Command="{Binding PromptDeleteCommand}"
                        BackgroundColor="Transparent"
                        TextColor="#D93829"
                        FontFamily="OpenSansSemibold"
                        FontSize="14"
                        HeightRequest="44" />
            </VerticalStackLayout>
        </Grid>

        <!-- Delete Confirmation Overlay (Figma: Удаление контроллера) -->
        <Grid BackgroundColor="#80000000" IsVisible="{Binding IsDeleteDialogVisible}">
            <Border VerticalOptions="End"
                    StrokeShape="RoundRectangle 24 24 0 0"
                    BackgroundColor="{AppThemeBinding Light='#FFFFFF', Dark='#1E202C'}"
                    StrokeThickness="0"
                    Padding="24,24,24,32">
                <VerticalStackLayout Spacing="18">
                    <!-- Fish Mascot with Question Badge -->
                    <controls:FishMascotCard HeightOverride="200" BadgeText="?" BadgeColor="#7BA028" />

                    <!-- Titles -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Вы уверены, что хотите&#10;удалить контроллер?"
                               TextColor="{AppThemeBinding Light='#141414', Dark='#FFFFFF'}"
                               FontFamily="OpenSansSemibold"
                               FontSize="20"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center" />
                        <Label Text="Все данные контроллера будут удалены"
                               TextColor="{AppThemeBinding Light='#6E6E6E', Dark='#A0A4B8'}"
                               FontSize="14"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>

                    <!-- Buttons -->
                    <VerticalStackLayout Spacing="10" Margin="0,6,0,0">
                        <Button Text="Да, удалить"
                                Command="{Binding ConfirmDeleteCommand}"
                                BackgroundColor="#B72B2B"
                                TextColor="#FFFFFF"
                                CornerRadius="14"
                                HeightRequest="50"
                                FontFamily="OpenSansSemibold"
                                FontSize="15" />

                        <Button Text="Нет, отменить"
                                Command="{Binding CancelDeleteCommand}"
                                BackgroundColor="{AppThemeBinding Light='#FFFFFF', Dark='#161824'}"
                                BorderColor="{AppThemeBinding Light='#E4E7F4', Dark='#2E3346'}"
                                BorderWidth="1"
                                TextColor="{AppThemeBinding Light='#4152B0', Dark='#738AFF'}"
                                CornerRadius="14"
                                HeightRequest="50"
                                FontFamily="OpenSansSemibold"
                                FontSize="15" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
