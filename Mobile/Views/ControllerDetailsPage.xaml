<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Mobile.ViewModels"
             x:Class="Mobile.Views.ControllerDetailsPage"
             x:DataType="vm:ControllerDetailsViewModel"
             BackgroundColor="#F6F7FC"
             Title="{Binding Controller.Name, FallbackValue='Контроллер'}">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="20,16,20,30">
            <!-- Header Card -->
            <Border x:Name="HeaderCard"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 16"
                    BackgroundColor="#4152B0"
                    Padding="20">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="{Binding Controller.Name}" TextColor="#FFFFFF" FontFamily="OpenSansSemibold" FontSize="20" FontAttributes="Bold" />
                        <Border Grid.Column="1" BackgroundColor="{Binding Controller.StatusBadgeBg}" StrokeShape="RoundRectangle 8" Padding="8,4" StrokeThickness="0">
                            <Label Text="{Binding Controller.StatusText}" TextColor="{Binding Controller.StatusColor}" FontSize="12" FontFamily="OpenSansSemibold" />
                        </Border>
                    </Grid>

                    <Label Text="{Binding Controller.ModelType}" TextColor="#EDEFFB" FontSize="14" />
                </VerticalStackLayout>
            </Border>

            <!-- Technical Details Card -->
            <Border x:Name="DetailsCard"
                    StrokeThickness="1"
                    Stroke="#E4E7F4"
                    StrokeShape="RoundRectangle 16"
                    BackgroundColor="#FFFFFF"
                    Padding="20">
                <VerticalStackLayout Spacing="16">
                    <Label Text="Сведения об устройстве" TextColor="#141414" FontFamily="OpenSansSemibold" FontSize="16" FontAttributes="Bold" />

                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="14">
                        <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="2">
                            <Label Text="IP-адрес" TextColor="#919191" FontSize="12" />
                            <Label Text="{Binding Controller.IpAddress}" TextColor="#141414" FontFamily="OpenSansSemibold" FontSize="14" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="2">
                            <Label Text="MAC-адрес" TextColor="#919191" FontSize="12" />
                            <Label Text="{Binding Controller.MacAddress}" TextColor="#141414" FontFamily="OpenSansSemibold" FontSize="14" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="2">
                            <Label Text="Версия прошивки" TextColor="#919191" FontSize="12" />
                            <Label Text="{Binding Controller.FirmwareVersion}" TextColor="#4152B0" FontFamily="OpenSansSemibold" FontSize="14" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="2">
                            <Label Text="Привязанная ёмкость" TextColor="#919191" FontSize="12" />
                            <Label Text="{Binding Controller.AttachedAquariumName}" TextColor="#141414" FontFamily="OpenSansSemibold" FontSize="14" />
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Actions Card -->
            <Border x:Name="ActionsCard"
                    StrokeThickness="1"
                    Stroke="#E4E7F4"
                    StrokeShape="RoundRectangle 16"
                    BackgroundColor="#FFFFFF"
                    Padding="16">
                <VerticalStackLayout Spacing="12">
                    <Button Text="🔄 Перезагрузить контроллер"
                            Command="{Binding RebootCommand}"
                            BackgroundColor="#EDEFFB"
                            TextColor="#4152B0"
                            CornerRadius="12"
                            HeightRequest="48"
                            FontFamily="OpenSansSemibold"
                            FontSize="14" />

                    <Button Text="🗑️ Удалить контроллер"
                            Command="{Binding DeleteCommand}"
                            BackgroundColor="#FDEEEC"
                            TextColor="#D93829"
                            CornerRadius="12"
                            HeightRequest="48"
                            FontFamily="OpenSansSemibold"
                            FontSize="14" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
