<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Mobile.ViewModels"
             x:Class="Mobile.Views.LoginPage"
             x:DataType="vm:LoginViewModel"
             BackgroundColor="#FFFFFF"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <Grid RowDefinitions="Auto,*,Auto" Padding="24,32,24,32" MinimumHeightRequest="600">
            <!-- Header Section -->
            <VerticalStackLayout Grid.Row="0" x:Name="HeaderContainer" Spacing="16">
                <!-- Back button -->
                <ImageButton Source="dotnet_bot.png"
                             IsVisible="False" />
                <Button Text="← Назад"
                        Command="{Binding GoBackCommand}"
                        TextColor="#4152B0"
                        BackgroundColor="Transparent"
                        HorizontalOptions="Start"
                        FontFamily="OpenSansSemibold"
                        Padding="0" />

                <Label Text="Авторизация"
                       TextColor="#141414"
                       FontFamily="OpenSansSemibold"
                       FontSize="28"
                       FontAttributes="Bold" />

                <Label Text="Войдите, чтобы управлять вашими аквасистемами и датчиками"
                       TextColor="#6E6E6E"
                       FontFamily="OpenSansRegular"
                       FontSize="15" />
            </VerticalStackLayout>

            <!-- Form Section -->
            <VerticalStackLayout Grid.Row="1" x:Name="FormContainer" Spacing="20" Margin="0,32,0,24">
                <!-- Email / Login -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Email или Логин"
                           TextColor="#404040"
                           FontFamily="OpenSansSemibold"
                           FontSize="14" />
                    <Border Stroke="#D9DFF7"
                            StrokeThickness="1.5"
                            StrokeShape="RoundRectangle 12"
                            BackgroundColor="#F8F9FE"
                            Padding="14,2">
                        <Entry Text="{Binding EmailOrLogin, Mode=TwoWay}"
                               Placeholder="name@example.com"
                               PlaceholderColor="#919191"
                               TextColor="#141414"
                               Keyboard="Email"
                               HeightRequest="48"
                               FontFamily="OpenSansRegular" />
                    </Border>
                </VerticalStackLayout>

                <!-- Password -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Пароль"
                           TextColor="#404040"
                           FontFamily="OpenSansSemibold"
                           FontSize="14" />
                    <Border Stroke="#D9DFF7"
                            StrokeThickness="1.5"
                            StrokeShape="RoundRectangle 12"
                            BackgroundColor="#F8F9FE"
                            Padding="14,2">
                        <Grid ColumnDefinitions="*,Auto">
                            <Entry Grid.Column="0"
                                   Text="{Binding Password, Mode=TwoWay}"
                                   Placeholder="Введите пароль"
                                   PlaceholderColor="#919191"
                                   TextColor="#141414"
                                   IsPassword="{Binding IsPasswordHidden}"
                                   HeightRequest="48"
                                   FontFamily="OpenSansRegular" />
                            <Button Grid.Column="1"
                                    Text="👁"
                                    Command="{Binding TogglePasswordCommand}"
                                    BackgroundColor="Transparent"
                                    TextColor="#4152B0"
                                    FontSize="16"
                                    WidthRequest="44"
                                    HeightRequest="44"
                                    Padding="0" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- Forgot Password Link -->
                <HorizontalStackLayout HorizontalOptions="End">
                    <Button Text="Забыли пароль?"
                            Command="{Binding GoToForgotPasswordCommand}"
                            TextColor="#4152B0"
                            BackgroundColor="Transparent"
                            FontFamily="OpenSansSemibold"
                            FontSize="13"
                            Padding="0" />
                </HorizontalStackLayout>

                <!-- Login Button -->
                <Button Text="Войти"
                        Command="{Binding LoginCommand}"
                        BackgroundColor="#4152B0"
                        TextColor="#FFFFFF"
                        FontFamily="OpenSansSemibold"
                        FontSize="16"
                        CornerRadius="12"
                        HeightRequest="52"
                        Margin="0,8,0,0">
                    <Button.Shadow>
                        <Shadow Brush="#334152B0" Offset="0,4" Radius="8" Opacity="0.8" />
                    </Button.Shadow>
                </Button>

                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   Color="#4152B0"
                                   HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- Bottom Register Link -->
            <HorizontalStackLayout Grid.Row="2" HorizontalOptions="Center" Spacing="4">
                <Label Text="Нет аккаунта?"
                       TextColor="#6E6E6E"
                       VerticalOptions="Center"
                       FontFamily="OpenSansRegular"
                       FontSize="14" />
                <Button Text="Зарегистрироваться"
                        Command="{Binding GoToRegistrationCommand}"
                        TextColor="#4152B0"
                        BackgroundColor="Transparent"
                        FontFamily="OpenSansSemibold"
                        FontSize="14"
                        Padding="0" />
            </HorizontalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>
