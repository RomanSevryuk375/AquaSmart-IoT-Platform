<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Mobile.ViewModels"
             xmlns:controls="clr-namespace:Mobile.Views.Controls"
             x:Class="Mobile.Views.LoginPage"
             x:DataType="vm:LoginViewModel"
             BackgroundColor="#FFFFFF"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <Grid RowDefinitions="Auto,*,Auto" Padding="20,28,20,24">
            <!-- Header Section with Mascot Banner -->
            <VerticalStackLayout Grid.Row="0" x:Name="HeaderContainer" Spacing="16">
                <!-- Fish Mascot Card with "hi" badge -->
                <controls:FishMascotCard HeightOverride="160"
                                         BadgeText="hi"
                                         BadgeColor="#7BA028" />

                <!-- Welcome Title -->
                <HorizontalStackLayout Spacing="4" Margin="0,4,0,0">
                    <Label Text="Добро пожаловать в "
                           TextColor="#141414"
                           FontFamily="OpenSansSemibold"
                           FontSize="22"
                           FontAttributes="Bold" />
                    <Label Text="SmartAqua"
                           TextColor="#4152B0"
                           FontFamily="OpenSansSemibold"
                           FontSize="22"
                           FontAttributes="Bold" />
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <!-- Form Section -->
            <VerticalStackLayout Grid.Row="1" x:Name="FormContainer" Spacing="16" Margin="0,20,0,20">
                <!-- Login / Phone / Email -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Логин"
                           TextColor="#333333"
                           FontFamily="OpenSansSemibold"
                           FontSize="13" />
                    <Border Stroke="#E4E7F4"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10"
                            BackgroundColor="#FFFFFF"
                            Padding="14,0"
                            HeightRequest="48">
                        <Entry Text="{Binding EmailOrLogin, Mode=TwoWay}"
                               Placeholder="Введите вашу почту или телефон"
                               PlaceholderColor="#8C93A8"
                               TextColor="#141414"
                               HeightRequest="48"
                               VerticalOptions="Center"
                               FontFamily="OpenSansRegular"
                               FontSize="14" />
                    </Border>
                </VerticalStackLayout>

                <!-- Password -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Пароль"
                           TextColor="#333333"
                           FontFamily="OpenSansSemibold"
                           FontSize="13" />
                    <Border Stroke="#E4E7F4"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10"
                            BackgroundColor="#FFFFFF"
                            Padding="14,0"
                            HeightRequest="48">
                        <Grid ColumnDefinitions="*,Auto">
                            <Entry Grid.Column="0"
                                   Text="{Binding Password, Mode=TwoWay}"
                                   Placeholder="Введите ваш пароль"
                                   PlaceholderColor="#8C93A8"
                                   TextColor="#141414"
                                   IsPassword="{Binding IsPasswordHidden}"
                                   HeightRequest="48"
                                   VerticalOptions="Center"
                                   FontFamily="OpenSansRegular"
                                   FontSize="14" />
                            <ImageButton Grid.Column="1"
                                         Source="icon_eye.png"
                                         Command="{Binding TogglePasswordCommand}"
                                         BackgroundColor="Transparent"
                                         WidthRequest="22"
                                         HeightRequest="22"
                                         Padding="0"
                                         VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- Error Message (Figma error state) -->
                <Label Text="{Binding ErrorMessage}"
                       IsVisible="{Binding HasError}"
                       TextColor="#E53935"
                       FontFamily="OpenSansRegular"
                       FontSize="12"
                       Margin="0,-6,0,0" />

                <!-- Forgot Password Link (Left-aligned as in Figma) -->
                <HorizontalStackLayout HorizontalOptions="Start">
                    <Button Text="Забыли пароль?"
                            Command="{Binding GoToForgotPasswordCommand}"
                            TextColor="#4152B0"
                            BackgroundColor="Transparent"
                            FontFamily="OpenSansSemibold"
                            FontSize="13"
                            Padding="0" />
                </HorizontalStackLayout>

                <!-- Login Button -->
                <Button Text="Войти"
                        Command="{Binding LoginCommand}"
                        BackgroundColor="#4152B0"
                        TextColor="#FFFFFF"
                        FontFamily="OpenSansSemibold"
                        FontSize="15"
                        CornerRadius="12"
                        HeightRequest="48"
                        Margin="0,8,0,0">
                    <Button.Shadow>
                        <Shadow Brush="#254152B0" Offset="0,4" Radius="8" Opacity="0.6" />
                    </Button.Shadow>
                </Button>

                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   Color="#4152B0"
                                   HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- Bottom Register Link -->
            <HorizontalStackLayout Grid.Row="2" HorizontalOptions="Center" Spacing="4">
                <Label Text="Еще не зарегистрированы?"
                       TextColor="#6E6E6E"
                       VerticalOptions="Center"
                       FontFamily="OpenSansRegular"
                       FontSize="13" />
                <Button Text="Зарегистрироваться"
                        Command="{Binding GoToRegistrationCommand}"
                        TextColor="#4152B0"
                        BackgroundColor="Transparent"
                        FontFamily="OpenSansSemibold"
                        FontSize="13"
                        Padding="0" />
            </HorizontalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>
