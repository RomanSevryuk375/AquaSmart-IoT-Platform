<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Mobile.ViewModels"
             xmlns:controls="clr-namespace:Mobile.Views.Controls"
             x:Class="Mobile.Views.ForgotPasswordPage"
             x:DataType="vm:ForgotPasswordViewModel"
             BackgroundColor="#FFFFFF"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <Grid RowDefinitions="Auto,*,Auto" Padding="20,24,20,24">
            <!-- Header Section with Mascot Banner -->
            <VerticalStackLayout Grid.Row="0" x:Name="HeaderContainer" Spacing="16">
                <!-- Fish Mascot Card: "..." badge for steps 1-3, checkmark for step 4 -->
                <controls:FishMascotCard HeightOverride="140"
                                         BadgeText="{Binding BadgeText}"
                                         BadgeColor="#7BA028" />

                <!-- Step 1 & Step 3 Title: Восстановление пароля -->
                <VerticalStackLayout Spacing="4" IsVisible="{Binding IsStep1}">
                    <Label Text="Восстановление пароля"
                           TextColor="#141414"
                           FontFamily="OpenSansSemibold"
                           FontSize="22"
                           FontAttributes="Bold" />
                    <Label Text="Укажите номер телефона или почту, на которые был зарегистрирован аккаунт, мы вышлем вам код подтверждения"
                           TextColor="#6E6E6E"
                           FontFamily="OpenSansRegular"
                           FontSize="13"
                           LineHeight="1.3" />
                </VerticalStackLayout>

                <!-- Step 2 Title: Введите код подтверждения -->
                <VerticalStackLayout Spacing="4" IsVisible="{Binding IsStep2}">
                    <Label Text="Введите код подтверждения"
                           TextColor="#141414"
                           FontFamily="OpenSansSemibold"
                           FontSize="22"
                           FontAttributes="Bold" />
                    <Label Text="5-значный код был отправлен на указанный контактный номер"
                           TextColor="#6E6E6E"
                           FontFamily="OpenSansRegular"
                           FontSize="13"
                           LineHeight="1.3" />
                </VerticalStackLayout>

                <!-- Step 3 Title: Новый пароль -->
                <VerticalStackLayout Spacing="4" IsVisible="{Binding IsStep3}">
                    <Label Text="Восстановление пароля"
                           TextColor="#141414"
                           FontFamily="OpenSansSemibold"
                           FontSize="22"
                           FontAttributes="Bold" />
                    <Label Text="Придумайте новый пароль"
                           TextColor="#6E6E6E"
                           FontFamily="OpenSansRegular"
                           FontSize="13" />
                </VerticalStackLayout>

                <!-- Step 4 Title: Успех -->
                <VerticalStackLayout Spacing="4" IsVisible="{Binding IsStep4}" HorizontalOptions="Center">
                    <Label Text="Ваш пароль успешно восстановлен"
                           TextColor="#141414"
                           FontFamily="OpenSansSemibold"
                           FontSize="20"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center" />
                    <Label Text="Перейдите на страницу авторизации для входа в ваш аккаунт"
                           TextColor="#6E6E6E"
                           FontFamily="OpenSansRegular"
                           FontSize="13"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- Form Body Section -->
            <VerticalStackLayout Grid.Row="1" x:Name="FormContainer" Spacing="16" Margin="0,16,0,16">
                <!-- STEP 1: Phone / Email -->
                <VerticalStackLayout Spacing="16" IsVisible="{Binding IsStep1}">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Телефон/Почта" TextColor="#333333" FontFamily="OpenSansSemibold" FontSize="13" />
                        <Border Stroke="#E4E7F4" StrokeThickness="1" StrokeShape="RoundRectangle 10" BackgroundColor="#FFFFFF" Padding="14,0" HeightRequest="48">
                            <Entry Text="{Binding EmailOrPhone, Mode=TwoWay}" Placeholder="Введите вашу почту или телефон" PlaceholderColor="#8C93A8" TextColor="#141414" VerticalOptions="Center" FontSize="14" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Error message -->
                    <Label Text="{Binding ErrorMessage}" IsVisible="{Binding ErrorMessage, Converter={StaticResource StringIsNotNullOrEmptyConverter}}" TextColor="#E53935" FontSize="12" />

                    <!-- Primary: Send code -->
                    <Button Text="Выслать код подтверждения"
                            Command="{Binding SendCodeCommand}"
                            BackgroundColor="#4152B0"
                            TextColor="#FFFFFF"
                            FontFamily="OpenSansSemibold"
                            FontSize="15"
                            CornerRadius="12"
                            HeightRequest="48"
                            Margin="0,8,0,0" />

                    <!-- Secondary: Back to login -->
                    <Button Text="Вернуться к авторизации"
                            Command="{Binding GoToLoginCommand}"
                            BackgroundColor="Transparent"
                            BorderColor="#4152B0"
                            BorderWidth="1.5"
                            TextColor="#4152B0"
                            FontFamily="OpenSansSemibold"
                            FontSize="14"
                            CornerRadius="12"
                            HeightRequest="48" />
                </VerticalStackLayout>

                <!-- STEP 2: PIN Code digits -->
                <VerticalStackLayout Spacing="20" IsVisible="{Binding IsStep2}">
                    <!-- 4 PIN Digit boxes -->
                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12" Margin="12,8">
                        <Border Grid.Column="0" HeightRequest="54" StrokeShape="RoundRectangle 10" Stroke="#4152B0" StrokeThickness="1.5" BackgroundColor="#FFFFFF">
                            <Label Text="7" TextColor="#141414" FontFamily="OpenSansSemibold" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Border Grid.Column="1" HeightRequest="54" StrokeShape="RoundRectangle 10" Stroke="#E4E7F4" StrokeThickness="1" BackgroundColor="#FFFFFF">
                            <Label Text="7" TextColor="#141414" FontFamily="OpenSansSemibold" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Border Grid.Column="2" HeightRequest="54" StrokeShape="RoundRectangle 10" Stroke="#E4E7F4" StrokeThickness="1" BackgroundColor="#FFFFFF">
                            <Label Text="7" TextColor="#141414" FontFamily="OpenSansSemibold" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Border Grid.Column="3" HeightRequest="54" StrokeShape="RoundRectangle 10" Stroke="#E4E7F4" StrokeThickness="1" BackgroundColor="#FFFFFF">
                            <Label Text="7" TextColor="#141414" FontFamily="OpenSansSemibold" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                    </Grid>

                    <Button Text="Продолжить"
                            Command="{Binding VerifyCodeCommand}"
                            BackgroundColor="#4152B0"
                            TextColor="#FFFFFF"
                            FontFamily="OpenSansSemibold"
                            FontSize="15"
                            CornerRadius="12"
                            HeightRequest="48" />

                    <Button Text="Отправить код повторно"
                            Command="{Binding SendCodeCommand}"
                            BackgroundColor="Transparent"
                            BorderColor="#4152B0"
                            BorderWidth="1.5"
                            TextColor="#4152B0"
                            FontFamily="OpenSansSemibold"
                            FontSize="14"
                            CornerRadius="12"
                            HeightRequest="48" />
                </VerticalStackLayout>

                <!-- STEP 3: New password -->
                <VerticalStackLayout Spacing="16" IsVisible="{Binding IsStep3}">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Пароль" TextColor="#333333" FontFamily="OpenSansSemibold" FontSize="13" />
                        <Border Stroke="#E4E7F4" StrokeThickness="1" StrokeShape="RoundRectangle 10" BackgroundColor="#FFFFFF" Padding="14,0" HeightRequest="48">
                            <Entry Text="{Binding NewPassword, Mode=TwoWay}" Placeholder="Придумайте новый пароль" IsPassword="True" TextColor="#141414" VerticalOptions="Center" FontSize="14" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Повторите пароль" TextColor="#333333" FontFamily="OpenSansSemibold" FontSize="13" />
                        <Border Stroke="#E4E7F4" StrokeThickness="1" StrokeShape="RoundRectangle 10" BackgroundColor="#FFFFFF" Padding="14,0" HeightRequest="48">
                            <Entry Text="{Binding ConfirmNewPassword, Mode=TwoWay}" Placeholder="Повторите пароль" IsPassword="True" TextColor="#141414" VerticalOptions="Center" FontSize="14" />
                        </Border>
                    </VerticalStackLayout>

                    <Label Text="{Binding ErrorMessage}" IsVisible="{Binding ErrorMessage, Converter={StaticResource StringIsNotNullOrEmptyConverter}}" TextColor="#E53935" FontSize="12" />

                    <Button Text="Подтвердить"
                            Command="{Binding ResetPasswordCommand}"
                            BackgroundColor="#4152B0"
                            TextColor="#FFFFFF"
                            FontFamily="OpenSansSemibold"
                            FontSize="15"
                            CornerRadius="12"
                            HeightRequest="48"
                            Margin="0,8,0,0" />
                </VerticalStackLayout>

                <!-- STEP 4: Success CTA -->
                <VerticalStackLayout Spacing="16" IsVisible="{Binding IsStep4}" Margin="0,12,0,0">
                    <Button Text="Войти"
                            Command="{Binding GoToLoginCommand}"
                            BackgroundColor="#4152B0"
                            TextColor="#FFFFFF"
                            FontFamily="OpenSansSemibold"
                            FontSize="15"
                            CornerRadius="12"
                            HeightRequest="48" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>
