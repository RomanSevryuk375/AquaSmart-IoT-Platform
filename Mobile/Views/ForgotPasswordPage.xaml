<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Mobile.ViewModels"
             x:Class="Mobile.Views.ForgotPasswordPage"
             x:DataType="vm:ForgotPasswordViewModel"
             BackgroundColor="#FFFFFF"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="24,32,24,32" Spacing="20">
            <Button Text="← Назад"
                    Command="{Binding GoBackCommand}"
                    TextColor="#4152B0"
                    BackgroundColor="Transparent"
                    HorizontalOptions="Start"
                    FontFamily="OpenSansSemibold"
                    Padding="0" />

            <Label Text="Восстановление доступа"
                   TextColor="#141414"
                   FontFamily="OpenSansSemibold"
                   FontSize="28"
                   FontAttributes="Bold" />

            <Label Text="Введите контактные данные, привязанные к вашей учетной записи"
                   TextColor="#6E6E6E"
                   FontFamily="OpenSansRegular"
                   FontSize="15" />

            <!-- Step 1: Request Code -->
            <VerticalStackLayout Spacing="16" Margin="0,16,0,0">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Email или Телефон" TextColor="#404040" FontFamily="OpenSansSemibold" FontSize="14" />
                    <Border Stroke="#D9DFF7" StrokeThickness="1.5" StrokeShape="RoundRectangle 12" BackgroundColor="#F8F9FE" Padding="14,2">
                        <Entry Text="{Binding EmailOrPhone, Mode=TwoWay}" Placeholder="example@mail.com" TextColor="#141414" HeightRequest="48" />
                    </Border>
                </VerticalStackLayout>

                <Button Text="Отправить проверочный код"
                        Command="{Binding SendCodeCommand}"
                        BackgroundColor="#4152B0"
                        TextColor="#FFFFFF"
                        FontFamily="OpenSansSemibold"
                        FontSize="16"
                        CornerRadius="12"
                        HeightRequest="52">
                    <Button.Shadow>
                        <Shadow Brush="#334152B0" Offset="0,4" Radius="8" Opacity="0.8" />
                    </Button.Shadow>
                </Button>
            </VerticalStackLayout>

            <!-- Step 2: Code & New Password -->
            <VerticalStackLayout Spacing="16" Margin="0,16,0,0">
                <BoxView HeightRequest="1" Color="#EDEFFB" Margin="0,8" />

                <Label Text="Введите код и новый пароль"
                       TextColor="#141414"
                       FontFamily="OpenSansSemibold"
                       FontSize="18" />

                <VerticalStackLayout Spacing="6">
                    <Label Text="Код из сообщения" TextColor="#404040" FontFamily="OpenSansSemibold" FontSize="14" />
                    <Border Stroke="#D9DFF7" StrokeThickness="1.5" StrokeShape="RoundRectangle 12" BackgroundColor="#F8F9FE" Padding="14,2">
                        <Entry Text="{Binding Code, Mode=TwoWay}" Placeholder="Например: 123456" TextColor="#141414" Keyboard="Numeric" HeightRequest="48" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <Label Text="Новый пароль" TextColor="#404040" FontFamily="OpenSansSemibold" FontSize="14" />
                    <Border Stroke="#D9DFF7" StrokeThickness="1.5" StrokeShape="RoundRectangle 12" BackgroundColor="#F8F9FE" Padding="14,2">
                        <Entry Text="{Binding NewPassword, Mode=TwoWay}" Placeholder="Введите новый пароль" TextColor="#141414" IsPassword="True" HeightRequest="48" />
                    </Border>
                </VerticalStackLayout>

                <Button Text="Сохранить новый пароль"
                        Command="{Binding ResetPasswordCommand}"
                        BackgroundColor="#334193"
                        TextColor="#FFFFFF"
                        FontFamily="OpenSansSemibold"
                        FontSize="16"
                        CornerRadius="12"
                        HeightRequest="52">
                    <Button.Shadow>
                        <Shadow Brush="#33334193" Offset="0,4" Radius="8" Opacity="0.8" />
                    </Button.Shadow>
                </Button>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
