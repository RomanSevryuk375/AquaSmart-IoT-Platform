<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Mobile.ViewModels"
             xmlns:controls="clr-namespace:Mobile.Views.Controls"
             xmlns:loc="clr-namespace:Mobile.Converters"
             x:Class="Mobile.Views.ForgotPasswordPage"
             x:DataType="vm:ForgotPasswordViewModel"
             BackgroundColor="#FFFFFF"
             Shell.NavBarIsVisible="False"
             Title="{loc:Translate Forgot_Title}">

    <ScrollView>
        <Grid RowDefinitions="Auto,*,Auto" Padding="20,24,20,24">
            <!-- Header Section with Mascot Banner -->
            <VerticalStackLayout Grid.Row="0" x:Name="HeaderContainer" Spacing="16">
                <!-- Fish Mascot Card: "..." badge for steps 1-3, checkmark for step 4 -->
                <controls:FishMascotCard HeightOverride="140"
                                         BadgeText="{Binding BadgeText}"
                                         BadgeColor="#7BA028" />

                <!-- Step 1 & Step 3 Title: Восстановление пароля -->
                <VerticalStackLayout Spacing="4" IsVisible="{Binding IsStep1}">
                    <Label Text="{loc:Translate Forgot_Title}"
                           TextColor="#141414"
                           FontFamily="OpenSansSemibold"
                           FontSize="22"
                           FontAttributes="Bold" />
                    <Label Text="{loc:Translate Forgot_Step1Desc}"
                           TextColor="#6E6E6E"
                           FontFamily="OpenSansRegular"
                           FontSize="13"
                           LineHeight="1.3" />
                </VerticalStackLayout>

                <!-- Step 2 Title: Введите код подтверждения -->
                <VerticalStackLayout Spacing="4" IsVisible="{Binding IsStep2}">
                    <Label Text="{loc:Translate Forgot_Step2Title}"
                           TextColor="#141414"
                           FontFamily="OpenSansSemibold"
                           FontSize="22"
                           FontAttributes="Bold" />
                    <Label Text="{loc:Translate Forgot_Step2Desc}"
                           TextColor="#6E6E6E"
                           FontFamily="OpenSansRegular"
                           FontSize="13"
                           LineHeight="1.3" />
                </VerticalStackLayout>

                <!-- Step 3 Title: Новый пароль -->
                <VerticalStackLayout Spacing="4" IsVisible="{Binding IsStep3}">
                    <Label Text="{loc:Translate Forgot_Title}"
                           TextColor="#141414"
                           FontFamily="OpenSansSemibold"
                           FontSize="22"
                           FontAttributes="Bold" />
                    <Label Text="{loc:Translate Forgot_Step3Desc}"
                           TextColor="#6E6E6E"
                           FontFamily="OpenSansRegular"
                           FontSize="13" />
                </VerticalStackLayout>

                <!-- Step 4 Title: Успех -->
                <VerticalStackLayout Spacing="4" IsVisible="{Binding IsStep4}" HorizontalOptions="Center">
                    <Label Text="{loc:Translate Forgot_SuccessTitle}"
                           TextColor="#141414"
                           FontFamily="OpenSansSemibold"
                           FontSize="20"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center" />
                    <Label Text="{loc:Translate Forgot_SuccessDesc}"
                           TextColor="#6E6E6E"
                           FontFamily="OpenSansRegular"
                           FontSize="13"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- Form Body Section -->
            <VerticalStackLayout Grid.Row="1" x:Name="FormContainer" Spacing="16" Margin="0,16,0,16">
                <!-- STEP 1: Phone / Email -->
                <VerticalStackLayout Spacing="16" IsVisible="{Binding IsStep1}">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="{loc:Translate Forgot_PhoneOrEmail}" TextColor="#333333" FontFamily="OpenSansSemibold" FontSize="13" />
                        <Border Stroke="#E4E7F4" StrokeThickness="1" StrokeShape="RoundRectangle 10" BackgroundColor="#FFFFFF" Padding="14,0" HeightRequest="48">
                            <Entry Text="{Binding EmailOrPhone, Mode=TwoWay}" Placeholder="{loc:Translate Forgot_PhoneOrEmailPlaceholder}" PlaceholderColor="#8C93A8" TextColor="#141414" VerticalOptions="Center" FontSize="14" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Error message -->
                    <Label Text="{Binding ErrorMessage}" IsVisible="{Binding ErrorMessage, Converter={StaticResource StringIsNotNullOrEmptyConverter}}" TextColor="#E53935" FontSize="12" />

                    <!-- Primary: Send code -->
                    <Button Text="{loc:Translate Forgot_SendCode}"
                            Command="{Binding SendCodeCommand}"
                            BackgroundColor="#4152B0"
                            TextColor="#FFFFFF"
                            FontFamily="OpenSansSemibold"
                            FontSize="15"
                            CornerRadius="12"
                            HeightRequest="48"
                            Margin="0,8,0,0" />

                    <!-- Secondary: Back to login -->
                    <Button Text="{loc:Translate Forgot_BackToLogin}"
                            Command="{Binding GoToLoginCommand}"
                            BackgroundColor="Transparent"
                            BorderColor="#4152B0"
                            BorderWidth="1.5"
                            TextColor="#4152B0"
                            FontFamily="OpenSansSemibold"
                            FontSize="14"
                            CornerRadius="12"
                            HeightRequest="48" />
                </VerticalStackLayout>

                <!-- STEP 2: PIN Code digits -->
                <VerticalStackLayout Spacing="20" IsVisible="{Binding IsStep2}">
                    <!-- 4 PIN Digit boxes -->
                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12" Margin="12,8">
                        <Border Grid.Column="0" HeightRequest="54" StrokeShape="RoundRectangle 10" Stroke="#4152B0" StrokeThickness="1.5" BackgroundColor="#FFFFFF">
                            <Label Text="7" TextColor="#141414" FontFamily="OpenSansSemibold" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Border Grid.Column="1" HeightRequest="54" StrokeShape="RoundRectangle 10" Stroke="#E4E7F4" StrokeThickness="1" BackgroundColor="#FFFFFF">
                            <Label Text="7" TextColor="#141414" FontFamily="OpenSansSemibold" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Border Grid.Column="2" HeightRequest="54" StrokeShape="RoundRectangle 10" Stroke="#E4E7F4" StrokeThickness="1" BackgroundColor="#FFFFFF">
                            <Label Text="7" TextColor="#141414" FontFamily="OpenSansSemibold" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Border Grid.Column="3" HeightRequest="54" StrokeShape="RoundRectangle 10" Stroke="#E4E7F4" StrokeThickness="1" BackgroundColor="#FFFFFF">
                            <Label Text="7" TextColor="#141414" FontFamily="OpenSansSemibold" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                    </Grid>

                    <Button Text="{loc:Translate Common_Continue}"
                            Command="{Binding VerifyCodeCommand}"
                            BackgroundColor="#4152B0"
                            TextColor="#FFFFFF"
                            FontFamily="OpenSansSemibold"
                            FontSize="15"
                            CornerRadius="12"
                            HeightRequest="48" />

                    <Button Text="{loc:Translate Forgot_ResendCode}"
                            Command="{Binding SendCodeCommand}"
                            BackgroundColor="Transparent"
                            BorderColor="#4152B0"
                            BorderWidth="1.5"
                            TextColor="#4152B0"
                            FontFamily="OpenSansSemibold"
                            FontSize="14"
                            CornerRadius="12"
                            HeightRequest="48" />
                </VerticalStackLayout>

                <!-- STEP 3: New password -->
                <VerticalStackLayout Spacing="16" IsVisible="{Binding IsStep3}">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="{loc:Translate Auth_PasswordTitle}" TextColor="#333333" FontFamily="OpenSansSemibold" FontSize="13" />
                        <Border Stroke="#E4E7F4" StrokeThickness="1" StrokeShape="RoundRectangle 10" BackgroundColor="#FFFFFF" Padding="14,0" HeightRequest="48">
                            <Grid ColumnDefinitions="*,Auto">
                                <Entry Grid.Column="0" Text="{Binding NewPassword, Mode=TwoWay}" Placeholder="{loc:Translate Forgot_NewPassword}" PlaceholderColor="#8C93A8" IsPassword="{Binding IsPasswordHidden}" TextColor="#141414" VerticalOptions="Center" FontSize="14" />
                                <ImageButton Grid.Column="1" Source="{Binding PasswordEyeIcon}" Command="{Binding TogglePasswordCommand}" BackgroundColor="Transparent" WidthRequest="24" HeightRequest="24" Padding="0" VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="{loc:Translate Auth_ConfirmPassword}" TextColor="#333333" FontFamily="OpenSansSemibold" FontSize="13" />
                        <Border Stroke="#E4E7F4" StrokeThickness="1" StrokeShape="RoundRectangle 10" BackgroundColor="#FFFFFF" Padding="14,0" HeightRequest="48">
                            <Grid ColumnDefinitions="*,Auto">
                                <Entry Grid.Column="0" Text="{Binding ConfirmNewPassword, Mode=TwoWay}" Placeholder="{loc:Translate Auth_ConfirmPasswordPlaceholder}" PlaceholderColor="#8C93A8" IsPassword="{Binding IsConfirmPasswordHidden}" TextColor="#141414" VerticalOptions="Center" FontSize="14" />
                                <ImageButton Grid.Column="1" Source="{Binding ConfirmPasswordEyeIcon}" Command="{Binding ToggleConfirmPasswordCommand}" BackgroundColor="Transparent" WidthRequest="24" HeightRequest="24" Padding="0" VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <Label Text="{Binding ErrorMessage}" IsVisible="{Binding ErrorMessage, Converter={StaticResource StringIsNotNullOrEmptyConverter}}" TextColor="#E53935" FontSize="12" />

                    <Button Text="{loc:Translate Forgot_Confirm}"
                            Command="{Binding ResetPasswordCommand}"
                            BackgroundColor="#4152B0"
                            TextColor="#FFFFFF"
                            FontFamily="OpenSansSemibold"
                            FontSize="15"
                            CornerRadius="12"
                            HeightRequest="48"
                            Margin="0,8,0,0" />
                </VerticalStackLayout>

                <!-- STEP 4: Success CTA -->
                <VerticalStackLayout Spacing="16" IsVisible="{Binding IsStep4}" Margin="0,12,0,0">
                    <Button Text="{loc:Translate Auth_SignIn}"
                            Command="{Binding GoToLoginCommand}"
                            BackgroundColor="#4152B0"
                            TextColor="#FFFFFF"
                            FontFamily="OpenSansSemibold"
                            FontSize="15"
                            CornerRadius="12"
                            HeightRequest="48" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>
