<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Mobile.ViewModels"
             x:Class="Mobile.Views.AddScenarioPage"
             x:DataType="vm:AddScenarioViewModel"
             BackgroundColor="#F6F7FC"
             Title="Новый сценарий">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="20,16,20,30">
            <!-- Header Banner -->
            <Border x:Name="HeaderCard"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 16"
                    BackgroundColor="#4152B0"
                    Padding="20">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Автоматизация и сценарии"
                           TextColor="#FFFFFF"
                           FontFamily="OpenSansSemibold"
                           FontSize="20"
                           FontAttributes="Bold" />
                    <Label Text="Создайте интеллектуальное правило реакции на изменения показателей воды"
                           TextColor="#EDEFFB"
                           FontSize="13" />
                </VerticalStackLayout>
            </Border>

            <!-- Form Card -->
            <Border x:Name="FormCard"
                    StrokeThickness="1"
                    Stroke="#E4E7F4"
                    StrokeShape="RoundRectangle 16"
                    BackgroundColor="#FFFFFF"
                    Padding="20">
                <VerticalStackLayout Spacing="16">
                    <!-- Scenario Name -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Название сценария *" TextColor="#2E3A7E" FontFamily="OpenSansSemibold" FontSize="13" />
                        <Border StrokeThickness="1" Stroke="#E4E7F4" StrokeShape="RoundRectangle 12" BackgroundColor="#F6F7FC" HeightRequest="48" Padding="12,0">
                            <Entry Text="{Binding ScenarioName}"
                                   Placeholder="Например, Поддержание тепла при падении t°"
                                   PlaceholderColor="#8C93A8"
                                   TextColor="#2E3A7E"
                                   VerticalOptions="Center" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Condition -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Условие срабатывания (Триггер) *" TextColor="#2E3A7E" FontFamily="OpenSansSemibold" FontSize="13" />
                        <Border StrokeThickness="1" Stroke="#E4E7F4" StrokeShape="RoundRectangle 12" BackgroundColor="#F6F7FC" HeightRequest="48" Padding="12,0">
                            <Entry Text="{Binding Condition}"
                                   Placeholder="Если Температура &lt; 24.5°C"
                                   PlaceholderColor="#8C93A8"
                                   TextColor="#2E3A7E"
                                   VerticalOptions="Center" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Action -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Действие исполнительного механизма *" TextColor="#2E3A7E" FontFamily="OpenSansSemibold" FontSize="13" />
                        <Border StrokeThickness="1" Stroke="#E4E7F4" StrokeShape="RoundRectangle 12" BackgroundColor="#F6F7FC" HeightRequest="48" Padding="12,0">
                            <Entry Text="{Binding Action}"
                                   Placeholder="Включить Нагреватель на 15 минут"
                                   PlaceholderColor="#8C93A8"
                                   TextColor="#2E3A7E"
                                   VerticalOptions="Center" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Frequency / Mode -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Периодичность проверки" TextColor="#2E3A7E" FontFamily="OpenSansSemibold" FontSize="13" />
                        <Border StrokeThickness="1" Stroke="#E4E7F4" StrokeShape="RoundRectangle 12" BackgroundColor="#F6F7FC" HeightRequest="48" Padding="12,0">
                            <Entry Text="{Binding Frequency}"
                                   Placeholder="Постоянно (по триггеру) или Ежедневно"
                                   PlaceholderColor="#8C93A8"
                                   TextColor="#2E3A7E"
                                   VerticalOptions="Center" />
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Action Buttons -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button Grid.Column="0"
                        Text="Отмена"
                        Command="{Binding CancelCommand}"
                        BackgroundColor="#FFFFFF"
                        TextColor="#6A738A"
                        BorderColor="#E4E7F4"
                        BorderWidth="1"
                        CornerRadius="14"
                        HeightRequest="52"
                        FontFamily="OpenSansSemibold"
                        FontSize="15" />

                <Button Grid.Column="1"
                        Text="Сохранить"
                        Command="{Binding SaveCommand}"
                        BackgroundColor="#4152B0"
                        TextColor="#FFFFFF"
                        CornerRadius="14"
                        HeightRequest="52"
                        FontFamily="OpenSansSemibold"
                        FontSize="15" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
