<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Mobile.ViewModels"
             xmlns:models="clr-namespace:Mobile.Models"
             x:Class="Mobile.Views.ControllersPage"
             x:DataType="vm:ControllersViewModel"
             BackgroundColor="#F6F7FC"
             Title="Контроллеры">

    <Grid RowDefinitions="*,Auto" Padding="20,16,20,20">
        <!-- Main Content Area -->
        <ScrollView Grid.Row="0" x:Name="ContentScroll">
            <VerticalStackLayout Spacing="16">
                <!-- Header Description -->
                <Label Text="Аппаратные контроллеры и хабы AquaSmart"
                       TextColor="#6E6E6E"
                       FontSize="14" />

                <!-- Empty State (Figma: Контроллеры. Контроллеров нет) -->
                <Border IsVisible="{Binding HasNoControllers}"
                        StrokeThickness="1"
                        Stroke="#E1E4F2"
                        StrokeShape="RoundRectangle 16"
                        BackgroundColor="#FFFFFF"
                        Padding="28"
                        Margin="0,20,0,0">
                    <VerticalStackLayout Spacing="16" HorizontalOptions="Center">
                        <Border WidthRequest="80" HeightRequest="80"
                                StrokeShape="RoundRectangle 40"
                                BackgroundColor="#EDEFFB"
                                StrokeThickness="0"
                                HorizontalOptions="Center">
                            <Label Text="📟" FontSize="36" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>

                        <Label Text="Контроллеров пока нет"
                               TextColor="#141414"
                               FontFamily="OpenSansSemibold"
                               FontSize="18"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center" />

                        <Label Text="Подключите микроконтроллер ESP32 или AquaHub для сбора телеметрии и автоматизации оборудования."
                               TextColor="#6E6E6E"
                               FontSize="14"
                               HorizontalTextAlignment="Center" />

                        <Button Text="+ Подключить контроллер"
                                Command="{Binding AddControllerCommand}"
                                BackgroundColor="#4152B0"
                                TextColor="#FFFFFF"
                                CornerRadius="12"
                                HeightRequest="48"
                                Padding="20,0"
                                FontFamily="OpenSansSemibold"
                                FontSize="14"
                                Margin="0,8,0,0" />
                    </VerticalStackLayout>
                </Border>

                <!-- Non-Empty List (Figma: Контроллеры) -->
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Controllers}"
                                     IsVisible="{Binding HasControllers}"
                                     Spacing="12">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:ControllerModel">
                            <Border StrokeThickness="1"
                                    Stroke="#E1E4F2"
                                    StrokeShape="RoundRectangle 16"
                                    BackgroundColor="#FFFFFF"
                                    Padding="18">
                                <Border.Shadow>
                                    <Shadow Brush="#10000000" Offset="0,4" Radius="8" Opacity="0.5" />
                                </Border.Shadow>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ControllersViewModel}}, Path=SelectControllerCommand}"
                                                          CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>

                                <VerticalStackLayout Spacing="10">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label Text="{Binding Name}" TextColor="#141414" FontFamily="OpenSansSemibold" FontSize="16" FontAttributes="Bold" />
                                            <Label Text="{Binding ModelType}" TextColor="#6E6E6E" FontSize="13" />
                                        </VerticalStackLayout>
                                        <Border Grid.Column="1" BackgroundColor="{Binding StatusBadgeBg}" StrokeShape="RoundRectangle 8" Padding="8,4" StrokeThickness="0">
                                            <Label Text="{Binding StatusText}" TextColor="{Binding StatusColor}" FontSize="11" FontFamily="OpenSansSemibold" />
                                        </Border>
                                    </Grid>

                                    <BoxView HeightRequest="1" Color="#F0F2F9" />

                                    <Grid ColumnDefinitions="*,*">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label Text="Привязка" TextColor="#919191" FontSize="11" />
                                            <Label Text="{Binding AttachedAquariumName}" TextColor="#4152B0" FontFamily="OpenSansSemibold" FontSize="13" />
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                            <Label Text="IP-адрес / Прошивка" TextColor="#919191" FontSize="11" />
                                            <Label Text="{Binding IpAddress}" TextColor="#141414" FontSize="13" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Floating Add Controller Button -->
        <Button Grid.Row="1"
                x:Name="AddButton"
                Text="+ Добавить контроллер"
                Command="{Binding AddControllerCommand}"
                BackgroundColor="#4152B0"
                TextColor="#FFFFFF"
                FontFamily="OpenSansSemibold"
                FontSize="16"
                CornerRadius="14"
                HeightRequest="52"
                Margin="0,12,0,10">
            <Button.Shadow>
                <Shadow Brush="#404152B0" Offset="0,4" Radius="10" Opacity="0.9" />
            </Button.Shadow>
        </Button>
    </Grid>
</ContentPage>
