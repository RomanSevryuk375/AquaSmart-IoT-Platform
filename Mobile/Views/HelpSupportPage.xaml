<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Mobile.ViewModels"
             xmlns:loc="clr-namespace:Mobile.Converters"
             x:Class="Mobile.Views.HelpSupportPage"
             x:DataType="vm:HelpSupportViewModel"
             BackgroundColor="{AppThemeBinding Light='#F6F7FC', Dark='#12131A'}"
             Shell.NavBarIsVisible="False"
             Title="{loc:Translate Profile_HelpSupport}">

    <Grid RowDefinitions="Auto,*" Padding="20,16,20,10">
        <!-- Top Bar: Back Button, Title, Bell matching Figma 781:12970 -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="0,4,0,16">
            <Border Grid.Column="0"
                    WidthRequest="38" HeightRequest="38"
                    StrokeShape="RoundRectangle 10"
                    BackgroundColor="{AppThemeBinding Light='#FFFFFF', Dark='#1E202C'}"
                    StrokeThickness="1"
                    Stroke="{AppThemeBinding Light='#E4E7F4', Dark='#2C2F42'}">
                <ImageButton Source="{AppThemeBinding Light='icon_chevron_left.png', Dark='icon_chevron_left_white.png'}"
                             Command="{Binding GoBackCommand}"
                             BackgroundColor="Transparent"
                             WidthRequest="20" HeightRequest="20"
                             Padding="0"
                             HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>

            <Label Grid.Column="1"
                   Text="{loc:Translate Profile_HelpSupport}"
                   TextColor="{AppThemeBinding Light='#141414', Dark='#F4F5FB'}"
                   FontFamily="OpenSansSemibold"
                   FontSize="18"
                   FontAttributes="Bold"
                   VerticalOptions="Center" />

            <Border Grid.Column="2"
                    WidthRequest="38" HeightRequest="38"
                    StrokeShape="RoundRectangle 10"
                    BackgroundColor="{AppThemeBinding Light='#FFFFFF', Dark='#1E202C'}"
                    StrokeThickness="1"
                    Stroke="{AppThemeBinding Light='#E4E7F4', Dark='#2C2F42'}">
                <ImageButton Source="{AppThemeBinding Light='icon_bell.png', Dark='icon_bell_white.png'}"
                             Command="{Binding OpenNotificationsCommand}"
                             BackgroundColor="Transparent"
                             WidthRequest="18" HeightRequest="18"
                             Padding="0"
                             HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
        </Grid>

        <!-- Scrollable Content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="20" Padding="0,0,0,24">
                <!-- 1. База знаний -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="База знаний и инструкции"
                           TextColor="{AppThemeBinding Light='#141414', Dark='#F4F5FB'}"
                           FontFamily="OpenSansSemibold"
                           FontSize="16"
                           FontAttributes="Bold" />

                    <Border StrokeThickness="1"
                            Stroke="{AppThemeBinding Light='#E8EAF5', Dark='#2C2F42'}"
                            StrokeShape="RoundRectangle 16"
                            BackgroundColor="{AppThemeBinding Light='#FFFFFF', Dark='#1E202C'}"
                            Padding="16,6">
                        <VerticalStackLayout Spacing="0">
                            <!-- FAQ -->
                            <Grid ColumnDefinitions="*,Auto" HeightRequest="52">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenFaqCommand}" />
                                </Grid.GestureRecognizers>
                                <Label Text="Часто задаваемые вопросы (FAQ)" TextColor="{AppThemeBinding Light='#141414', Dark='#F4F5FB'}" FontFamily="OpenSansSemibold" FontSize="15" VerticalOptions="Center" />
                                <Image Grid.Column="1" Source="{AppThemeBinding Light='icon_chevron_right.png', Dark='icon_chevron_right_white.png'}" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                            </Grid>

                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light='#F0F2F9', Dark='#26283B'}" />

                            <!-- Руководство -->
                            <Grid ColumnDefinitions="*,Auto" HeightRequest="52">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenUserGuideCommand}" />
                                </Grid.GestureRecognizers>
                                <Label Text="Руководство пользователя" TextColor="{AppThemeBinding Light='#141414', Dark='#F4F5FB'}" FontFamily="OpenSansSemibold" FontSize="15" VerticalOptions="Center" />
                                <Image Grid.Column="1" Source="{AppThemeBinding Light='icon_chevron_right.png', Dark='icon_chevron_right_white.png'}" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- 2. Связаться с поддержкой -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Связаться с поддержкой"
                           TextColor="{AppThemeBinding Light='#141414', Dark='#F4F5FB'}"
                           FontFamily="OpenSansSemibold"
                           FontSize="16"
                           FontAttributes="Bold" />

                    <Border StrokeThickness="1"
                            Stroke="{AppThemeBinding Light='#E8EAF5', Dark='#2C2F42'}"
                            StrokeShape="RoundRectangle 16"
                            BackgroundColor="{AppThemeBinding Light='#FFFFFF', Dark='#1E202C'}"
                            Padding="16,6">
                        <VerticalStackLayout Spacing="0">
                            <!-- Telegram -->
                            <Grid ColumnDefinitions="*,Auto" HeightRequest="52">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenTelegramCommand}" />
                                </Grid.GestureRecognizers>
                                <Label Text="Чат в Telegram" TextColor="{AppThemeBinding Light='#141414', Dark='#F4F5FB'}" FontFamily="OpenSansSemibold" FontSize="15" VerticalOptions="Center" />
                                <Image Grid.Column="1" Source="{AppThemeBinding Light='icon_chevron_right.png', Dark='icon_chevron_right_white.png'}" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                            </Grid>

                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light='#F0F2F9', Dark='#26283B'}" />

                            <!-- Написать в приложении -->
                            <Grid ColumnDefinitions="*,Auto" HeightRequest="52">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding WriteInAppCommand}" />
                                </Grid.GestureRecognizers>
                                <Label Text="Написать в приложении" TextColor="{AppThemeBinding Light='#141414', Dark='#F4F5FB'}" FontFamily="OpenSansSemibold" FontSize="15" VerticalOptions="Center" />
                                <Image Grid.Column="1" Source="{AppThemeBinding Light='icon_chevron_right.png', Dark='icon_chevron_right_white.png'}" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                            </Grid>

                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light='#F0F2F9', Dark='#26283B'}" />

                            <!-- Email -->
                            <Grid ColumnDefinitions="*,Auto" HeightRequest="52">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SendEmailCommand}" />
                                </Grid.GestureRecognizers>
                                <Label Text="Написать на Email" TextColor="{AppThemeBinding Light='#141414', Dark='#F4F5FB'}" FontFamily="OpenSansSemibold" FontSize="15" VerticalOptions="Center" />
                                <Image Grid.Column="1" Source="{AppThemeBinding Light='icon_chevron_right.png', Dark='icon_chevron_right_white.png'}" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- 3. Диагностика -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Диагностика"
                           TextColor="{AppThemeBinding Light='#141414', Dark='#F4F5FB'}"
                           FontFamily="OpenSansSemibold"
                           FontSize="16"
                           FontAttributes="Bold" />

                    <Border StrokeThickness="1"
                            Stroke="{AppThemeBinding Light='#E8EAF5', Dark='#2C2F42'}"
                            StrokeShape="RoundRectangle 16"
                            BackgroundColor="{AppThemeBinding Light='#FFFFFF', Dark='#1E202C'}"
                            Padding="16,6">
                        <VerticalStackLayout Spacing="0">
                            <!-- Ошибка -->
                            <Grid ColumnDefinitions="*,Auto" HeightRequest="52">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ReportBugCommand}" />
                                </Grid.GestureRecognizers>
                                <Label Text="Сообщить о технической ошибке" TextColor="{AppThemeBinding Light='#141414', Dark='#F4F5FB'}" FontFamily="OpenSansSemibold" FontSize="15" VerticalOptions="Center" />
                                <Image Grid.Column="1" Source="{AppThemeBinding Light='icon_chevron_right.png', Dark='icon_chevron_right_white.png'}" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                            </Grid>

                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light='#F0F2F9', Dark='#26283B'}" />

                            <!-- Логи -->
                            <Grid ColumnDefinitions="*,Auto" HeightRequest="52">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ShareLogsCommand}" />
                                </Grid.GestureRecognizers>
                                <Label Text="Поделиться логами системы" TextColor="{AppThemeBinding Light='#141414', Dark='#F4F5FB'}" FontFamily="OpenSansSemibold" FontSize="15" VerticalOptions="Center" />
                                <Image Grid.Column="1" Source="{AppThemeBinding Light='icon_chevron_right.png', Dark='icon_chevron_right_white.png'}" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
