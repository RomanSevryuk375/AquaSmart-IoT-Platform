<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Mobile.ViewModels"
             xmlns:models="clr-namespace:Mobile.Models"
             x:Class="Mobile.Views.AquariumDetailsPage"
             x:DataType="vm:AquariumDetailsViewModel"
             BackgroundColor="#F6F7FC"
             Title="{Binding Aquarium.Name, FallbackValue='Детали ёмкости'}">

    <Grid RowDefinitions="Auto,Auto,*" Padding="20,16,20,20">
        <!-- Aquarium Header Card -->
        <Border Grid.Row="0"
                x:Name="HeaderCard"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 16"
                BackgroundColor="#4152B0"
                Padding="18">
            <VerticalStackLayout Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Text="{Binding Aquarium.Name}" TextColor="#FFFFFF" FontFamily="OpenSansSemibold" FontSize="20" FontAttributes="Bold" />
                    <Label Grid.Column="1" Text="{Binding Aquarium.WaterTypeDisplay}" TextColor="#D9DFF7" FontSize="13" />
                </Grid>

                <Label Text="{Binding Aquarium.SpeciesInfo}" TextColor="#EDEFFB" FontSize="13" />

                <Grid ColumnDefinitions="*,*,*" Margin="0,8,0,0">
                    <VerticalStackLayout Grid.Column="0">
                        <Label Text="Объём" TextColor="#D9DFF7" FontSize="11" />
                        <Label Text="{Binding Aquarium.VolumeLiters, StringFormat='{0} л'}" TextColor="#FFFFFF" FontFamily="OpenSansSemibold" FontSize="16" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1">
                        <Label Text="Габариты" TextColor="#D9DFF7" FontSize="11" />
                        <Label Text="{Binding Aquarium.Dimensions}" TextColor="#FFFFFF" FontFamily="OpenSansSemibold" FontSize="14" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="2">
                        <Label Text="Статус" TextColor="#D9DFF7" FontSize="11" />
                        <Label Text="В норме" TextColor="#66BB6A" FontFamily="OpenSansSemibold" FontSize="14" />
                    </VerticalStackLayout>
                </Grid>
            </VerticalStackLayout>
        </Border>

        <!-- Segmented Tab Bar (Датчики | Реле | Сценарии) -->
        <Border Grid.Row="1"
                Margin="0,16,0,16"
                BackgroundColor="#EDEFFB"
                StrokeShape="RoundRectangle 12"
                Padding="4"
                StrokeThickness="0">
            <Grid ColumnDefinitions="*,*,*">
                <!-- Tab 0: Датчики -->
                <Button Grid.Column="0"
                        Text="Датчики"
                        Command="{Binding SelectTabCommand}"
                        CommandParameter="0"
                        BackgroundColor="{Binding IsSensorsTabSelected, Converter={StaticResource TabActiveBgConverter}}"
                        TextColor="{Binding IsSensorsTabSelected, Converter={StaticResource TabActiveTextConverter}}"
                        CornerRadius="8"
                        HeightRequest="40"
                        FontFamily="OpenSansSemibold"
                        FontSize="13" />

                <!-- Tab 1: Реле -->
                <Button Grid.Column="1"
                        Text="Реле"
                        Command="{Binding SelectTabCommand}"
                        CommandParameter="1"
                        BackgroundColor="{Binding IsRelaysTabSelected, Converter={StaticResource TabActiveBgConverter}}"
                        TextColor="{Binding IsRelaysTabSelected, Converter={StaticResource TabActiveTextConverter}}"
                        CornerRadius="8"
                        HeightRequest="40"
                        FontFamily="OpenSansSemibold"
                        FontSize="13" />

                <!-- Tab 2: Сценарии -->
                <Button Grid.Column="2"
                        Text="Сценарии"
                        Command="{Binding SelectTabCommand}"
                        CommandParameter="2"
                        BackgroundColor="{Binding IsScenariosTabSelected, Converter={StaticResource TabActiveBgConverter}}"
                        TextColor="{Binding IsScenariosTabSelected, Converter={StaticResource TabActiveTextConverter}}"
                        CornerRadius="8"
                        HeightRequest="40"
                        FontFamily="OpenSansSemibold"
                        FontSize="13" />
            </Grid>
        </Border>

        <!-- Tab Content -->
        <ScrollView Grid.Row="2" x:Name="ContentScroll">
            <VerticalStackLayout Spacing="14">

                <!-- Sensors List (Tab 0) -->
                <VerticalStackLayout x:Name="SensorsSection"
                                     Spacing="10"
                                     IsVisible="{Binding IsSensorsTabSelected}">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Подключенные датчики" TextColor="#141414" FontFamily="OpenSansSemibold" FontSize="16" VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="+ Датчик" Command="{Binding AddSensorCommand}" TextColor="#4152B0" BackgroundColor="Transparent" FontFamily="OpenSansSemibold" FontSize="13" />
                    </Grid>

                    <!-- Empty State (Figma: Емкость. Датчики. Пусто) -->
                    <Border IsVisible="{Binding HasNoSensors}"
                            StrokeThickness="1" Stroke="#E1E4F2" StrokeShape="RoundRectangle 12" BackgroundColor="#FFFFFF" Padding="20">
                        <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                            <Label Text="🧪" FontSize="32" HorizontalOptions="Center" />
                            <Label Text="Датчики не привязаны" TextColor="#141414" FontFamily="OpenSansSemibold" FontSize="14" HorizontalTextAlignment="Center" />
                            <Label Text="Добавьте термометр, pH-зонд или оксиметр для сбора телеметрии." TextColor="#6E6E6E" FontSize="12" HorizontalTextAlignment="Center" />
                            <Button Text="+ Добавить датчик" Command="{Binding AddSensorCommand}" BackgroundColor="#EDEFFB" TextColor="#4152B0" CornerRadius="8" HeightRequest="38" FontFamily="OpenSansSemibold" FontSize="13" />
                        </VerticalStackLayout>
                    </Border>

                    <CollectionView ItemsSource="{Binding Sensors}"
                                    IsVisible="{Binding HasNoSensors, Converter={StaticResource InvertedBoolConverter}}"
                                    SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:SensorModel">
                                <Border StrokeThickness="1" Stroke="#E1E4F2" StrokeShape="RoundRectangle 12" BackgroundColor="#FFFFFF" Padding="14" Margin="0,0,0,8">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <Label Grid.Column="0" Text="{Binding Icon}" FontSize="24" VerticalOptions="Center" />
                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                            <Label Text="{Binding Name}" TextColor="#141414" FontFamily="OpenSansSemibold" FontSize="14" />
                                            <Label Text="{Binding StatusText}" TextColor="{Binding StatusColor}" FontSize="12" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="2" Text="{Binding Value, StringFormat='{0} '}" TextColor="#4152B0" FontFamily="OpenSansSemibold" FontSize="18" VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <!-- Relays List (Tab 1) -->
                <VerticalStackLayout x:Name="RelaysSection"
                                     Spacing="10"
                                     IsVisible="{Binding IsRelaysTabSelected}">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Управляемые устройства" TextColor="#141414" FontFamily="OpenSansSemibold" FontSize="16" VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="+ Реле" Command="{Binding AddRelayCommand}" TextColor="#4152B0" BackgroundColor="Transparent" FontFamily="OpenSansSemibold" FontSize="13" />
                    </Grid>

                    <!-- Empty State (Figma: Емкость. Реле. Пусто) -->
                    <Border IsVisible="{Binding HasNoRelays}"
                            StrokeThickness="1" Stroke="#E1E4F2" StrokeShape="RoundRectangle 12" BackgroundColor="#FFFFFF" Padding="20">
                        <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                            <Label Text="⚡" FontSize="32" HorizontalOptions="Center" />
                            <Label Text="Устройства не подключены" TextColor="#141414" FontFamily="OpenSansSemibold" FontSize="14" HorizontalTextAlignment="Center" />
                            <Label Text="Подключите обогреватель, аэратор, фильтр или кормушку." TextColor="#6E6E6E" FontSize="12" HorizontalTextAlignment="Center" />
                            <Button Text="+ Добавить реле" Command="{Binding AddRelayCommand}" BackgroundColor="#EDEFFB" TextColor="#4152B0" CornerRadius="8" HeightRequest="38" FontFamily="OpenSansSemibold" FontSize="13" />
                        </VerticalStackLayout>
                    </Border>

                    <CollectionView ItemsSource="{Binding Relays}"
                                    IsVisible="{Binding HasNoRelays, Converter={StaticResource InvertedBoolConverter}}"
                                    SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:RelayModel">
                                <Border StrokeThickness="1" Stroke="#E1E4F2" StrokeShape="RoundRectangle 12" BackgroundColor="#FFFFFF" Padding="14" Margin="0,0,0,8">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <Label Grid.Column="0" Text="{Binding Icon}" FontSize="24" VerticalOptions="Center" />
                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                            <Label Text="{Binding Name}" TextColor="#141414" FontFamily="OpenSansSemibold" FontSize="14" />
                                            <Label Text="{Binding ScheduleInfo}" TextColor="#6E6E6E" FontSize="12" />
                                        </VerticalStackLayout>
                                        <Switch Grid.Column="2" IsToggled="{Binding IsOn, Mode=TwoWay}" OnColor="#4152B0" VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <!-- Scenarios List (Tab 2) -->
                <VerticalStackLayout x:Name="ScenariosSection"
                                     Spacing="10"
                                     IsVisible="{Binding IsScenariosTabSelected}">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Автоматические сценарии" TextColor="#141414" FontFamily="OpenSansSemibold" FontSize="16" VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="+ Сценарий" Command="{Binding AddScenarioCommand}" TextColor="#4152B0" BackgroundColor="Transparent" FontFamily="OpenSansSemibold" FontSize="13" />
                    </Grid>

                    <!-- Empty State (Figma: Емкость. Сценарии. Пусто) -->
                    <Border IsVisible="{Binding HasNoScenarios}"
                            StrokeThickness="1" Stroke="#E1E4F2" StrokeShape="RoundRectangle 12" BackgroundColor="#FFFFFF" Padding="20">
                        <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                            <Label Text="⚙️" FontSize="32" HorizontalOptions="Center" />
                            <Label Text="Сценарии не настроены" TextColor="#141414" FontFamily="OpenSansSemibold" FontSize="14" HorizontalTextAlignment="Center" />
                            <Label Text="Настройте автоматическое включение нагревателя или освещения по триггеру." TextColor="#6E6E6E" FontSize="12" HorizontalTextAlignment="Center" />
                            <Button Text="+ Создать сценарий" Command="{Binding AddScenarioCommand}" BackgroundColor="#EDEFFB" TextColor="#4152B0" CornerRadius="8" HeightRequest="38" FontFamily="OpenSansSemibold" FontSize="13" />
                        </VerticalStackLayout>
                    </Border>

                    <CollectionView ItemsSource="{Binding Scenarios}"
                                    IsVisible="{Binding HasNoScenarios, Converter={StaticResource InvertedBoolConverter}}"
                                    SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:ScenarioModel">
                                <Border StrokeThickness="1" Stroke="#E1E4F2" StrokeShape="RoundRectangle 12" BackgroundColor="#FFFFFF" Padding="14" Margin="0,0,0,8">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                                            <Label Text="{Binding Name}" TextColor="#141414" FontFamily="OpenSansSemibold" FontSize="14" />
                                            <Label Text="{Binding ConditionText}" TextColor="#4152B0" FontSize="12" />
                                            <Label Text="{Binding ActionText}" TextColor="#6E6E6E" FontSize="12" />
                                        </VerticalStackLayout>
                                        <Switch Grid.Column="1" IsToggled="{Binding IsActive, Mode=TwoWay}" OnColor="#4152B0" VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
