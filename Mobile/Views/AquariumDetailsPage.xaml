<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Mobile.ViewModels"
             xmlns:models="clr-namespace:Mobile.Models"
             xmlns:controls="clr-namespace:Mobile.Views.Controls"
             xmlns:dto="clr-namespace:Mobile.Services.Dto.Notification"
              xmlns:ctrlDto="clr-namespace:Mobile.Services.Dto.Control"
              xmlns:loc="clr-namespace:Mobile.Converters"
              x:Class="Mobile.Views.AquariumDetailsPage"
              x:DataType="vm:AquariumDetailsViewModel"
              BackgroundColor="{AppThemeBinding Light='#FFFFFF', Dark='#12131A'}"
              Shell.NavBarIsVisible="False"
              Title="{Binding Aquarium.Name, FallbackValue='Детали ёмкости'}">

    <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="20,24,20,20">
        <!-- Top Navigation Bar: Back Arrow, Tank Title & Actions (Figma: Емкость) -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8" Margin="0,4,0,14">
            <!-- Back button -->
            <Border WidthRequest="36" HeightRequest="36"
                    StrokeShape="RoundRectangle 10"
                    BackgroundColor="{AppThemeBinding Light='#F6F7FC', Dark='#1E202C'}"
                    StrokeThickness="0"
                    VerticalOptions="Center">
                <ImageButton Source="{AppThemeBinding Light='icon_arrow_left.png', Dark='icon_arrow_left_white.png'}"
                             Command="{Binding GoBackCommand}"
                             BackgroundColor="Transparent"
                             WidthRequest="20" HeightRequest="20"
                             Padding="0"
                             HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>

            <!-- Title & Subtitle -->
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" VerticalOptions="Center">
                    <BoxView Grid.Column="0" WidthRequest="8" HeightRequest="8" CornerRadius="4" Color="#4CAF50" VerticalOptions="Center" />
                    <Label Grid.Column="1"
                           Text="{Binding Aquarium.Name, FallbackValue='Ёмкость'}"
                           TextColor="{AppThemeBinding Light='#141414', Dark='#F4F5FB'}"
                           FontFamily="OpenSansSemibold"
                           FontSize="16"
                           FontAttributes="Bold"
                           LineBreakMode="TailTruncation"
                           VerticalOptions="Center" />
                </Grid>
                <Label Text="{Binding Aquarium.TankTypeSubtitle}"
                       TextColor="#8C93A8"
                       FontSize="12"
                       LineBreakMode="TailTruncation"
                       Margin="14,0,0,0" />
            </VerticalStackLayout>

            <!-- Edit Button -->
            <Border Grid.Column="2"
                    WidthRequest="36" HeightRequest="36"
                    StrokeShape="RoundRectangle 10"
                    BackgroundColor="{AppThemeBinding Light='#F6F7FC', Dark='#1E202C'}"
                    StrokeThickness="0"
                    VerticalOptions="Center">
                <ImageButton Source="{AppThemeBinding Light='icon_edit.png', Dark='icon_edit_white.png'}"
                             Command="{Binding EditCommand}"
                             BackgroundColor="Transparent"
                             WidthRequest="18" HeightRequest="18"
                             Padding="0"
                             HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>

            <!-- Notifications Button -->
            <Border Grid.Column="3"
                    WidthRequest="36" HeightRequest="36"
                    StrokeShape="RoundRectangle 10"
                    BackgroundColor="{AppThemeBinding Light='#F6F7FC', Dark='#1E202C'}"
                    StrokeThickness="0"
                    VerticalOptions="Center">
                <ImageButton Source="{AppThemeBinding Light='icon_bell.png', Dark='icon_bell_white.png'}"
                             Command="{Binding OpenNotificationsCommand}"
                             BackgroundColor="Transparent"
                             WidthRequest="18" HeightRequest="18"
                             Padding="0"
                             HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
        </Grid>

        <!-- Controller Card & Vacation Mode Banner -->
        <VerticalStackLayout Grid.Row="1" Spacing="10" Margin="0,0,0,14">
            <Border x:Name="HeaderCard"
                    StrokeThickness="1"
                    Stroke="{AppThemeBinding Light='#E4E7F4', Dark='#2C2F42'}"
                    StrokeShape="RoundRectangle 16"
                    BackgroundColor="{AppThemeBinding Light='#FFFFFF', Dark='#1E202C'}"
                    Padding="16,14">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="6">
                    <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="2">
                        <Label Text="{Binding Aquarium.ControllerName}"
                               TextColor="{AppThemeBinding Light='#141414', Dark='#F4F5FB'}"
                               FontFamily="OpenSansSemibold"
                               FontSize="15"
                               FontAttributes="Bold" />
                        <Label Text="{Binding Aquarium.SpeciesInfo}"
                               TextColor="#8C93A8"
                               FontSize="12" />
                    </VerticalStackLayout>

                    <!-- Switch on right -->
                    <Switch Grid.Row="0" Grid.Column="1"
                            IsToggled="{Binding Aquarium.IsOnline}"
                            IsEnabled="False"
                            OnColor="#4152B0"
                            ThumbColor="#FFFFFF"
                            VerticalOptions="Center" />

                    <!-- Status pill -->
                    <Border Grid.Row="1" Grid.Column="0"
                            HorizontalOptions="Start"
                            BackgroundColor="{Binding Aquarium.CardThemeColor}"
                            StrokeShape="RoundRectangle 6"
                            Padding="8,3"
                            StrokeThickness="0">
                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                            <BoxView WidthRequest="6" HeightRequest="6" CornerRadius="3" Color="{Binding Aquarium.StatusDotColor}" VerticalOptions="Center" />
                            <Label Text="{Binding Aquarium.StatusSummary}" TextColor="{Binding Aquarium.StatusDotColor}" FontFamily="OpenSansSemibold" FontSize="11" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                </Grid>
            </Border>

            <!-- Vacation Mode Banner Card -->
            <Border StrokeThickness="1"
                    Stroke="{AppThemeBinding Light='#F3E5AB', Dark='#4A4018'}"
                    StrokeShape="RoundRectangle 14"
                    BackgroundColor="{AppThemeBinding Light='#FFFDF5', Dark='#232117'}"
                    Padding="14,10">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10" VerticalOptions="Center">
                    <Label Grid.Column="0" Text="🏖️" FontSize="20" VerticalOptions="Center" />
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                        <Label Text="{loc:Translate Tank_VacationMode}" TextColor="{AppThemeBinding Light='#141414', Dark='#F4F5FB'}" FontFamily="OpenSansSemibold" FontSize="13" FontAttributes="Bold" />
                        <Label Text="{Binding VacationModeText}" TextColor="{AppThemeBinding Light='#8C7A3E', Dark='#D4C07B'}" FontSize="11" LineBreakMode="TailTruncation" />
                    </VerticalStackLayout>
                    <Button Grid.Column="2"
                            Text="{loc:Translate Tank_Configure}"
                            Command="{Binding ConfigureVacationModeCommand}"
                            BackgroundColor="Transparent"
                            TextColor="#4152B0"
                            FontFamily="OpenSansSemibold"
                            FontSize="12"
                            Padding="4,0"
                            VerticalOptions="Center" />
                    <Switch Grid.Column="3"
                            IsToggled="{Binding IsVacationModeActive, Mode=TwoWay}"
                            OnColor="#4152B0"
                            VerticalOptions="Center" />
                </Grid>
            </Border>
        </VerticalStackLayout>

        <!-- Segmented Tab Bar (датчики | реле | сценарии) -->
        <Border Grid.Row="2"
                Margin="0,0,0,16"
                BackgroundColor="{AppThemeBinding Light='#EDEFFB', Dark='#1E202C'}"
                StrokeShape="RoundRectangle 12"
                Padding="4"
                StrokeThickness="0">
            <Grid ColumnDefinitions="*,*,*,*">
                <!-- Tab 0: Датчики -->
                <Button Grid.Column="0"
                        Text="{loc:Translate Tank_Sensors}"
                        Command="{Binding SelectTabCommand}"
                        CommandParameter="0"
                        BackgroundColor="{Binding IsSensorsTabSelected, Converter={StaticResource TabActiveBgConverter}}"
                        TextColor="{Binding IsSensorsTabSelected, Converter={StaticResource TabActiveTextConverter}}"
                        CornerRadius="8"
                        HeightRequest="38"
                        FontFamily="OpenSansSemibold"
                        FontSize="12" />

                <!-- Tab 1: Реле -->
                <Button Grid.Column="1"
                        Text="{loc:Translate Tank_Relays}"
                        Command="{Binding SelectTabCommand}"
                        CommandParameter="1"
                        BackgroundColor="{Binding IsRelaysTabSelected, Converter={StaticResource TabActiveBgConverter}}"
                        TextColor="{Binding IsRelaysTabSelected, Converter={StaticResource TabActiveTextConverter}}"
                        CornerRadius="8"
                        HeightRequest="38"
                        FontFamily="OpenSansSemibold"
                        FontSize="12" />

                <!-- Tab 2: Сценарии -->
                <Button Grid.Column="2"
                        Text="{loc:Translate Tank_Scenarios}"
                        Command="{Binding SelectTabCommand}"
                        CommandParameter="2"
                        BackgroundColor="{Binding IsScenariosTabSelected, Converter={StaticResource TabActiveBgConverter}}"
                        TextColor="{Binding IsScenariosTabSelected, Converter={StaticResource TabActiveTextConverter}}"
                        CornerRadius="8"
                        HeightRequest="38"
                        FontFamily="OpenSansSemibold"
                        FontSize="12" />

                <!-- Tab 3: Журнал -->
                <Button Grid.Column="3"
                        Text="{loc:Translate Tank_Journal}"
                        Command="{Binding SelectTabCommand}"
                        CommandParameter="3"
                        BackgroundColor="{Binding IsLogsTabSelected, Converter={StaticResource TabActiveBgConverter}}"
                        TextColor="{Binding IsLogsTabSelected, Converter={StaticResource TabActiveTextConverter}}"
                        CornerRadius="8"
                        HeightRequest="38"
                        FontFamily="OpenSansSemibold"
                        FontSize="12" />
            </Grid>
        </Border>

        <!-- Tab Content -->
        <ScrollView Grid.Row="3" x:Name="ContentScroll">
            <VerticalStackLayout Spacing="14" Padding="0,0,0,48">

                <!-- Sensors List (Tab 0) -->
                <VerticalStackLayout x:Name="SensorsSection"
                                     Spacing="10"
                                     IsVisible="{Binding IsSensorsTabSelected}">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <Label Grid.Column="0" Text="Датчики" TextColor="{AppThemeBinding Light='#141414', Dark='#F4F5FB'}" FontFamily="OpenSansSemibold" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" />
                        <Border Grid.Column="1"
                                StrokeShape="RoundRectangle 8"
                                StrokeThickness="0"
                                BackgroundColor="{AppThemeBinding Light='#E8F5E9', Dark='#193322'}"
                                Padding="8,3"
                                VerticalOptions="Center"
                                IsVisible="{Binding IsLiveTelemetryActive}">
                            <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                <BoxView WidthRequest="6" HeightRequest="6" CornerRadius="3" Color="#4CAF50" VerticalOptions="Center" />
                                <Label Text="Live SignalR" TextColor="{AppThemeBinding Light='#2E7D32', Dark='#81C784'}" FontFamily="OpenSansSemibold" FontSize="10" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                        <Button Grid.Column="2" Text="+ Добавить" Command="{Binding AddSensorCommand}" TextColor="#4152B0" BackgroundColor="Transparent" FontFamily="OpenSansSemibold" FontSize="13" Padding="4,0" />
                    </Grid>

                    <!-- Empty State (Figma: Емкость. Датчики. Пусто) -->
                    <VerticalStackLayout IsVisible="{Binding HasNoSensors}" Spacing="12" Margin="0,6,0,0">
                        <controls:FishMascotCard HeightOverride="140" BadgeText="🧪" BadgeColor="#7BA028" />
                        <Label Text="Добавьте первый датчик" TextColor="{AppThemeBinding Light='#141414', Dark='#F4F5FB'}" FontFamily="OpenSansSemibold" FontSize="17" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                        <Label Text="Здесь будут отображаться ваши устройства. Добавьте первый датчик, чтобы контролировать параметры системы" TextColor="{AppThemeBinding Light='#6E6E6E', Dark='#9FA3B8'}" FontSize="13" LineHeight="1.3" HorizontalTextAlignment="Center" />
                        <Button Text="Добавить датчик" Command="{Binding AddSensorCommand}" BackgroundColor="#4152B0" TextColor="#FFFFFF" CornerRadius="12" HeightRequest="46" FontFamily="OpenSansSemibold" FontSize="14" Margin="0,4,0,0" />
                    </VerticalStackLayout>

                    <CollectionView ItemsSource="{Binding Sensors}"
                                    IsVisible="{Binding HasNoSensors, Converter={StaticResource InvertedBoolConverter}}"
                                    SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:SensorModel">
                                <Border StrokeThickness="1" Stroke="{AppThemeBinding Light='#E4E7F4', Dark='#2C2F42'}" StrokeShape="RoundRectangle 12" BackgroundColor="{AppThemeBinding Light='#FFFFFF', Dark='#1E202C'}" Padding="14,12" Margin="0,0,0,8">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <Label Grid.Column="0" Text="{Binding Icon}" FontSize="22" VerticalOptions="Center" />
                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                            <Label Text="{Binding Name}" TextColor="{AppThemeBinding Light='#141414', Dark='#F4F5FB'}" FontFamily="OpenSansSemibold" FontSize="14" />
                                            <HorizontalStackLayout Spacing="6">
                                                <Label Text="{Binding StatusText}" TextColor="{Binding StatusColor}" FontSize="11" />
                                                <Label Text="•" TextColor="#8C93A8" FontSize="11" IsVisible="{Binding HasPort}" />
                                                <Label Text="{Binding PortDisplay}" TextColor="#8C93A8" FontSize="11" IsVisible="{Binding HasPort}" />
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>
                                        <Label Grid.Column="2" Text="{Binding Value, StringFormat='{0} '}" TextColor="{AppThemeBinding Light='#141414', Dark='#F4F5FB'}" FontFamily="OpenSansSemibold" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <!-- Relays List (Tab 1) -->
                <VerticalStackLayout x:Name="RelaysSection"
                                     Spacing="10"
                                     IsVisible="{Binding IsRelaysTabSelected}">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="{loc:Translate Tank_Relays}" TextColor="{AppThemeBinding Light='#141414', Dark='#F4F5FB'}" FontFamily="OpenSansSemibold" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="{loc:Translate Common_Add}" Command="{Binding AddRelayCommand}" TextColor="#4152B0" BackgroundColor="Transparent" FontFamily="OpenSansSemibold" FontSize="13" Padding="4,0" />
                    </Grid>

                    <!-- Empty State (Figma: Емкость. Реле. Пусто) -->
                    <VerticalStackLayout IsVisible="{Binding HasNoRelays}" Spacing="12" Margin="0,6,0,0">
                        <controls:FishMascotCard HeightOverride="140" BadgeText="⚡" BadgeColor="#7BA028" />
                        <Label Text="{loc:Translate Tank_AddFirstRelay}" TextColor="{AppThemeBinding Light='#141414', Dark='#F4F5FB'}" FontFamily="OpenSansSemibold" FontSize="17" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                        <Label Text="{loc:Translate Tank_FirstRelayDesc}" TextColor="{AppThemeBinding Light='#6E6E6E', Dark='#9FA3B8'}" FontSize="13" LineHeight="1.3" HorizontalTextAlignment="Center" />
                        <Button Text="{loc:Translate Tank_AddFirstRelay}" Command="{Binding AddRelayCommand}" BackgroundColor="#4152B0" TextColor="#FFFFFF" CornerRadius="12" HeightRequest="46" FontFamily="OpenSansSemibold" FontSize="14" Margin="0,4,0,0" />
                    </VerticalStackLayout>

                    <CollectionView ItemsSource="{Binding Relays}"
                                    IsVisible="{Binding HasNoRelays, Converter={StaticResource InvertedBoolConverter}}"
                                    SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:RelayModel">
                                <Border StrokeThickness="1" Stroke="{AppThemeBinding Light='#E4E7F4', Dark='#2C2F42'}" StrokeShape="RoundRectangle 12" BackgroundColor="{AppThemeBinding Light='#FFFFFF', Dark='#1E202C'}" Padding="14,12" Margin="0,0,0,8">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <Label Grid.Column="0" Text="{Binding Icon}" FontSize="22" VerticalOptions="Center" />
                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                            <Label Text="{Binding Name}" TextColor="{AppThemeBinding Light='#141414', Dark='#F4F5FB'}" FontFamily="OpenSansSemibold" FontSize="14" />
                                            <Label Text="{Binding ScheduleInfo}" TextColor="{AppThemeBinding Light='#8C93A8', Dark='#9FA3B8'}" FontSize="11" />
                                        </VerticalStackLayout>
                                        <Switch Grid.Column="2" IsToggled="{Binding IsOn, Mode=TwoWay}" OnColor="#4152B0" VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- Schedules section -->
                    <VerticalStackLayout Spacing="8" Margin="0,12,0,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="{loc:Translate Tank_TimersAndSchedules}" TextColor="{AppThemeBinding Light='#141414', Dark='#F4F5FB'}" FontFamily="OpenSansSemibold" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                            <Button Grid.Column="1" Text="{loc:Translate Tank_AddTimer}" Command="{Binding AddScheduleCommand}" TextColor="#4152B0" BackgroundColor="Transparent" FontFamily="OpenSansSemibold" FontSize="12" Padding="4,0" />
                        </Grid>

                        <CollectionView ItemsSource="{Binding Schedules}" SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="ctrlDto:ScheduleDto">
                                    <Border StrokeThickness="1" Stroke="{AppThemeBinding Light='#E4E7F4', Dark='#2C2F42'}" StrokeShape="RoundRectangle 12" BackgroundColor="{AppThemeBinding Light='#F8F9FE', Dark='#1A1C27'}" Padding="12,10" Margin="0,0,0,6">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                            <Label Grid.Column="0" Text="⏱️" FontSize="18" VerticalOptions="Center" />
                                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                                <Label Text="{Binding FriendlyDescription}" TextColor="{AppThemeBinding Light='#141414', Dark='#F4F5FB'}" FontFamily="OpenSansSemibold" FontSize="13" />
                                                <Label Text="{Binding CronExpression, StringFormat='Schedule: {0}'}" TextColor="{AppThemeBinding Light='#8C93A8', Dark='#9FA3B8'}" FontSize="11" />
                                            </VerticalStackLayout>
                                            <Switch Grid.Column="2"
                                                    IsToggled="{Binding IsEnabled, Mode=TwoWay}"
                                                    OnColor="#4152B0"
                                                    VerticalOptions="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- Scenarios List (Tab 2) -->
                <VerticalStackLayout x:Name="ScenariosSection"
                                     Spacing="10"
                                     IsVisible="{Binding IsScenariosTabSelected}">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="{loc:Translate Tank_Scenarios}" TextColor="{AppThemeBinding Light='#141414', Dark='#F4F5FB'}" FontFamily="OpenSansSemibold" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="{loc:Translate Common_Add}" Command="{Binding AddScenarioCommand}" TextColor="#4152B0" BackgroundColor="Transparent" FontFamily="OpenSansSemibold" FontSize="13" Padding="4,0" />
                    </Grid>

                    <!-- Empty State (Figma: Емкость. Сценарии. Пусто) -->
                    <VerticalStackLayout IsVisible="{Binding HasNoScenarios}" Spacing="12" Margin="0,6,0,0">
                        <controls:FishMascotCard HeightOverride="140" BadgeText="🎛️" BadgeColor="#7BA028" />
                        <Label Text="{loc:Translate Tank_AddFirstScenario}" TextColor="{AppThemeBinding Light='#141414', Dark='#F4F5FB'}" FontFamily="OpenSansSemibold" FontSize="17" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                        <Label Text="{loc:Translate Tank_FirstScenarioDesc}" TextColor="{AppThemeBinding Light='#6E6E6E', Dark='#9FA3B8'}" FontSize="13" LineHeight="1.3" HorizontalTextAlignment="Center" />
                        <Button Text="{loc:Translate Tank_AddFirstScenario}" Command="{Binding AddScenarioCommand}" BackgroundColor="#4152B0" TextColor="#FFFFFF" CornerRadius="12" HeightRequest="46" FontFamily="OpenSansSemibold" FontSize="14" Margin="0,4,0,0" />
                    </VerticalStackLayout>

                    <CollectionView ItemsSource="{Binding Scenarios}"
                                    IsVisible="{Binding HasNoScenarios, Converter={StaticResource InvertedBoolConverter}}"
                                    SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:ScenarioModel">
                                <Border StrokeThickness="1" Stroke="{AppThemeBinding Light='#E4E7F4', Dark='#2C2F42'}" StrokeShape="RoundRectangle 12" BackgroundColor="{AppThemeBinding Light='#FFFFFF', Dark='#1E202C'}" Padding="14,12" Margin="0,0,0,8">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                                            <Label Text="{Binding Name}" TextColor="{AppThemeBinding Light='#141414', Dark='#F4F5FB'}" FontFamily="OpenSansSemibold" FontSize="14" />
                                            <Label Text="{Binding ConditionText}" TextColor="#4152B0" FontSize="12" />
                                            <Label Text="{Binding ActionText}" TextColor="{AppThemeBinding Light='#8C93A8', Dark='#9FA3B8'}" FontSize="11" />
                                        </VerticalStackLayout>
                                        <Switch Grid.Column="1" IsToggled="{Binding IsActive, Mode=TwoWay}" OnColor="#4152B0" VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <!-- Maintenance Logs List (Tab 3) -->
                <VerticalStackLayout x:Name="LogsSection"
                                     Spacing="12"
                                     IsVisible="{Binding IsLogsTabSelected}">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="{loc:Translate Tank_MaintenanceLog}" TextColor="{AppThemeBinding Light='#141414', Dark='#F4F5FB'}" FontFamily="OpenSansSemibold" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="{loc:Translate Tank_AddRecord}" Command="{Binding QuickLogMaintenanceCommand}" CommandParameter="Запись в журнал" TextColor="#4152B0" BackgroundColor="Transparent" FontFamily="OpenSansSemibold" FontSize="13" Padding="4,0" />
                    </Grid>

                    <!-- Quick Action Chips -->
                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                        <HorizontalStackLayout Spacing="8">
                            <Button Text="{loc:Translate Tank_WaterChange}"
                                    Command="{Binding QuickLogMaintenanceCommand}"
                                    CommandParameter="Подмена воды"
                                    BackgroundColor="{AppThemeBinding Light='#EBF3FF', Dark='#1A2E46'}"
                                    TextColor="{AppThemeBinding Light='#2176FF', Dark='#64B5F6'}"
                                    FontFamily="OpenSansSemibold"
                                    FontSize="12"
                                    CornerRadius="16"
                                    HeightRequest="34"
                                    Padding="12,0" />
                            <Button Text="{loc:Translate Tank_FilterClean}"
                                    Command="{Binding QuickLogMaintenanceCommand}"
                                    CommandParameter="Чистка фильтра"
                                    BackgroundColor="{AppThemeBinding Light='#E8F8F5', Dark='#183D36'}"
                                    TextColor="{AppThemeBinding Light='#16A085', Dark='#48C9B0'}"
                                    FontFamily="OpenSansSemibold"
                                    FontSize="12"
                                    CornerRadius="16"
                                    HeightRequest="34"
                                    Padding="12,0" />
                            <Button Text="{loc:Translate Tank_WaterTests}"
                                    Command="{Binding QuickLogMaintenanceCommand}"
                                    CommandParameter="Тестирование воды"
                                    BackgroundColor="{AppThemeBinding Light='#FFF4E6', Dark='#422D16'}"
                                    TextColor="{AppThemeBinding Light='#E67E22', Dark='#F39C12'}"
                                    FontFamily="OpenSansSemibold"
                                    FontSize="12"
                                    CornerRadius="16"
                                    HeightRequest="34"
                                    Padding="12,0" />
                        </HorizontalStackLayout>
                    </ScrollView>

                    <!-- Empty State -->
                    <VerticalStackLayout IsVisible="{Binding HasNoLogs}" Spacing="12" Margin="0,10,0,0">
                        <controls:FishMascotCard HeightOverride="130" BadgeText="📋" BadgeColor="#2176FF" />
                        <Label Text="{loc:Translate Tank_JournalEmpty}" TextColor="{AppThemeBinding Light='#141414', Dark='#F4F5FB'}" FontFamily="OpenSansSemibold" FontSize="17" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                        <Label Text="{loc:Translate Tank_JournalEmptyDesc}" TextColor="{AppThemeBinding Light='#6E6E6E', Dark='#9FA3B8'}" FontSize="13" LineHeight="1.3" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>

                    <!-- Logs List -->
                    <CollectionView ItemsSource="{Binding MaintenanceLogs}"
                                    IsVisible="{Binding HasNoLogs, Converter={StaticResource InvertedBoolConverter}}"
                                    SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="dto:MaintenanceLogDto">
                                <Border StrokeThickness="1" Stroke="{AppThemeBinding Light='#E4E7F4', Dark='#2C2F42'}" StrokeShape="RoundRectangle 12" BackgroundColor="{AppThemeBinding Light='#FFFFFF', Dark='#1E202C'}" Padding="14,12" Margin="0,0,0,8">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                        <Border Grid.Column="0"
                                                WidthRequest="36" HeightRequest="36"
                                                StrokeShape="RoundRectangle 10"
                                                BackgroundColor="{AppThemeBinding Light='#F4F6FD', Dark='#252837'}"
                                                StrokeThickness="0"
                                                VerticalOptions="Start">
                                            <Label Text="📝" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="3">
                                            <Label Text="{Binding Notes}" TextColor="{AppThemeBinding Light='#141414', Dark='#F4F5FB'}" FontFamily="OpenSansSemibold" FontSize="13" LineBreakMode="WordWrap" />
                                            <Label Text="{Binding ActionDate, StringFormat='{0:dd.MM.yyyy HH:mm}'}" TextColor="{AppThemeBinding Light='#8C93A8', Dark='#9FA3B8'}" FontSize="11" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
