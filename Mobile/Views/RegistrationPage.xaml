<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Mobile.ViewModels"
             xmlns:controls="clr-namespace:Mobile.Views.Controls"
             x:Class="Mobile.Views.RegistrationPage"
             x:DataType="vm:RegistrationViewModel"
             BackgroundColor="#FFFFFF"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout x:Name="RegistrationContainer" Padding="20,24,20,24" Spacing="16">
            <!-- Fish Mascot Card with Clipboard Badge -->
            <controls:FishMascotCard HeightOverride="140"
                                     BadgeText="📋"
                                     BadgeColor="#7BA028" />

            <!-- Title & Subtitle -->
            <VerticalStackLayout Spacing="4">
                <Label Text="Регистрация"
                       TextColor="#141414"
                       FontFamily="OpenSansSemibold"
                       FontSize="22"
                       FontAttributes="Bold" />
                <Label Text="Создайте аккаунт, чтобы начать"
                       TextColor="#6E6E6E"
                       FontFamily="OpenSansRegular"
                       FontSize="13" />
            </VerticalStackLayout>

            <!-- Form fields -->
            <!-- Full Name -->
            <VerticalStackLayout Spacing="4">
                <Label Text="Имя" TextColor="#333333" FontFamily="OpenSansSemibold" FontSize="13" />
                <Border Stroke="#E4E7F4" StrokeThickness="1" StrokeShape="RoundRectangle 10" BackgroundColor="#FFFFFF" Padding="14,0" HeightRequest="48">
                    <Entry Text="{Binding FullName, Mode=TwoWay}" Placeholder="Введите ваше имя" PlaceholderColor="#8C93A8" TextColor="#141414" VerticalOptions="Center" FontSize="14" />
                </Border>
                <Label Text="{Binding FullNameError}"
                       IsVisible="{Binding HasFullNameError}"
                       TextColor="#E53935"
                       FontFamily="OpenSansRegular"
                       FontSize="11"
                       Margin="2,0,0,0" />
            </VerticalStackLayout>

            <!-- Email -->
            <VerticalStackLayout Spacing="4">
                <Label Text="Почта" TextColor="#333333" FontFamily="OpenSansSemibold" FontSize="13" />
                <Border Stroke="#E4E7F4" StrokeThickness="1" StrokeShape="RoundRectangle 10" BackgroundColor="#FFFFFF" Padding="14,0" HeightRequest="48">
                    <Entry Text="{Binding Email, Mode=TwoWay}" Placeholder="Введите вашу почту" PlaceholderColor="#8C93A8" TextColor="#141414" Keyboard="Email" VerticalOptions="Center" FontSize="14" />
                </Border>
                <Label Text="{Binding EmailError}"
                       IsVisible="{Binding HasEmailError}"
                       TextColor="#E53935"
                       FontFamily="OpenSansRegular"
                       FontSize="11"
                       Margin="2,0,0,0" />
            </VerticalStackLayout>

            <!-- Phone -->
            <VerticalStackLayout Spacing="4">
                <Label Text="Телефон" TextColor="#333333" FontFamily="OpenSansSemibold" FontSize="13" />
                <Border Stroke="#E4E7F4" StrokeThickness="1" StrokeShape="RoundRectangle 10" BackgroundColor="#FFFFFF" Padding="14,0" HeightRequest="48">
                    <Entry Text="{Binding Phone, Mode=TwoWay}" Placeholder="Введите ваш телефон" PlaceholderColor="#8C93A8" TextColor="#141414" Keyboard="Telephone" VerticalOptions="Center" FontSize="14" />
                </Border>
                <Label Text="{Binding PhoneError}"
                       IsVisible="{Binding HasPhoneError}"
                       TextColor="#E53935"
                       FontFamily="OpenSansRegular"
                       FontSize="11"
                       Margin="2,0,0,0" />
            </VerticalStackLayout>

            <!-- Password -->
            <VerticalStackLayout Spacing="4">
                <Label Text="Пароль" TextColor="#333333" FontFamily="OpenSansSemibold" FontSize="13" />
                <Border Stroke="#E4E7F4" StrokeThickness="1" StrokeShape="RoundRectangle 10" BackgroundColor="#FFFFFF" Padding="14,0" HeightRequest="48">
                    <Grid ColumnDefinitions="*,Auto">
                        <Entry Grid.Column="0" Text="{Binding Password, Mode=TwoWay}" Placeholder="Придумайте пароль" PlaceholderColor="#8C93A8" TextColor="#141414" IsPassword="{Binding IsPasswordHidden}" VerticalOptions="Center" FontSize="14" />
                        <ImageButton Grid.Column="1" Source="icon_eye.png" Command="{Binding TogglePasswordCommand}" BackgroundColor="Transparent" WidthRequest="22" HeightRequest="22" Padding="0" VerticalOptions="Center" />
                    </Grid>
                </Border>
                <Label Text="{Binding PasswordError}"
                       IsVisible="{Binding HasPasswordError}"
                       TextColor="#E53935"
                       FontFamily="OpenSansRegular"
                       FontSize="11"
                       Margin="2,0,0,0" />
            </VerticalStackLayout>

            <!-- Confirm Password -->
            <VerticalStackLayout Spacing="4">
                <Label Text="Повторите пароль" TextColor="#333333" FontFamily="OpenSansSemibold" FontSize="13" />
                <Border Stroke="#E4E7F4" StrokeThickness="1" StrokeShape="RoundRectangle 10" BackgroundColor="#FFFFFF" Padding="14,0" HeightRequest="48">
                    <Grid ColumnDefinitions="*,Auto">
                        <Entry Grid.Column="0" Text="{Binding ConfirmPassword, Mode=TwoWay}" Placeholder="Повторите пароль" PlaceholderColor="#8C93A8" TextColor="#141414" IsPassword="{Binding IsConfirmPasswordHidden}" VerticalOptions="Center" FontSize="14" />
                        <ImageButton Grid.Column="1" Source="icon_eye.png" Command="{Binding ToggleConfirmPasswordCommand}" BackgroundColor="Transparent" WidthRequest="22" HeightRequest="22" Padding="0" VerticalOptions="Center" />
                    </Grid>
                </Border>
                <Label Text="{Binding ConfirmPasswordError}"
                       IsVisible="{Binding HasConfirmPasswordError}"
                       TextColor="#E53935"
                       FontFamily="OpenSansRegular"
                       FontSize="11"
                       Margin="2,0,0,0" />
            </VerticalStackLayout>

            <!-- Checkbox Terms & Agreement -->
            <VerticalStackLayout Spacing="4" Margin="0,4,0,0">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <CheckBox Grid.Column="0" IsChecked="{Binding AgreeToTerms, Mode=TwoWay}" Color="#4152B0" VerticalOptions="Start" />
                    <Label Grid.Column="1"
                           Text="Я ознакомился с Условиями использования и Политикой конфиденциальности и согласен с ними."
                           TextColor="#6E6E6E"
                           FontFamily="OpenSansRegular"
                           FontSize="12"
                           LineHeight="1.25"
                           VerticalOptions="Center" />
                </Grid>
                <Label Text="{Binding TermsError}"
                       IsVisible="{Binding HasTermsError}"
                       TextColor="#E53935"
                       FontFamily="OpenSansRegular"
                       FontSize="11"
                       Margin="2,0,0,0" />
            </VerticalStackLayout>

            <!-- General Error Message (Server / Network error) -->
            <Label Text="{Binding ErrorMessage}"
                   IsVisible="{Binding HasError}"
                   TextColor="#E53935"
                   FontFamily="OpenSansRegular"
                   FontSize="12"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center" />

            <!-- Register Button -->
            <Button Text="Зарегистрироваться"
                    Command="{Binding RegisterCommand}"
                    BackgroundColor="#4152B0"
                    TextColor="#FFFFFF"
                    FontFamily="OpenSansSemibold"
                    FontSize="15"
                    CornerRadius="12"
                    HeightRequest="48"
                    Margin="0,8,0,0">
                <Button.Shadow>
                    <Shadow Brush="#254152B0" Offset="0,4" Radius="8" Opacity="0.6" />
                </Button.Shadow>
            </Button>

            <!-- Footer: Return to Login -->
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="4" Margin="0,4,0,8">
                <Label Text="У вас уже есть аккаунт?"
                       TextColor="#6E6E6E"
                       VerticalOptions="Center"
                       FontFamily="OpenSansRegular"
                       FontSize="13" />
                <Button Text="Войти"
                        Command="{Binding GoToLoginCommand}"
                        TextColor="#4152B0"
                        BackgroundColor="Transparent"
                        FontFamily="OpenSansSemibold"
                        FontSize="13"
                        Padding="0" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
