<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Mobile.ViewModels"
             xmlns:controls="clr-namespace:Mobile.Views.Controls"
             x:Class="Mobile.Views.AddRelayPage"
             x:DataType="vm:AddRelayViewModel"
             BackgroundColor="{AppThemeBinding Light='#FFFFFF', Dark='#12131A'}"
             Shell.NavBarIsVisible="False"
             Title="Добавление реле">

    <Grid>
        <!-- 1. MAIN FORM (Figma: 1. Добавление реле) -->
        <ScrollView IsVisible="{Binding IsFormVisible}">
            <VerticalStackLayout Spacing="16" Padding="20,16,20,30">
                <!-- Top Navigation Bar (< Добавление реле   X) -->
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,4,0,10">
                    <Border WidthRequest="36" HeightRequest="36"
                            StrokeShape="RoundRectangle 10"
                            BackgroundColor="{AppThemeBinding Light='#F6F7FC', Dark='#1E202C'}"
                            StrokeThickness="0"
                            VerticalOptions="Center">
                        <ImageButton Source="{AppThemeBinding Light='icon_arrow_left.png', Dark='icon_arrow_left_white.png'}"
                                     Command="{Binding PromptCancelCommand}"
                                     BackgroundColor="Transparent"
                                     WidthRequest="20" HeightRequest="20"
                                     Padding="0"
                                     HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>

                    <Label Grid.Column="1"
                           Text="Добавление реле"
                           TextColor="{AppThemeBinding Light='#141414', Dark='#FFFFFF'}"
                           FontFamily="OpenSansSemibold"
                           FontSize="18"
                           FontAttributes="Bold"
                           VerticalOptions="Center"
                           Margin="12,0,0,0" />

                    <Border Grid.Column="2"
                            WidthRequest="36" HeightRequest="36"
                            StrokeShape="RoundRectangle 10"
                            BackgroundColor="{AppThemeBinding Light='#F6F7FC', Dark='#1E202C'}"
                            StrokeThickness="0"
                            VerticalOptions="Center">
                        <ImageButton Source="{AppThemeBinding Light='icon_close.png', Dark='icon_close_white.png'}"
                                     Command="{Binding PromptCancelCommand}"
                                     BackgroundColor="Transparent"
                                     WidthRequest="18" HeightRequest="18"
                                     Padding="0"
                                     HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                </Grid>

                <!-- Relay Name -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Название реле" TextColor="#141414" FontFamily="OpenSansSemibold" FontSize="14" />
                    <Border StrokeThickness="1" Stroke="#E4E7F4" StrokeShape="RoundRectangle 12" BackgroundColor="#FFFFFF" HeightRequest="50" Padding="14,0">
                        <Entry Text="{Binding RelayName}"
                               Placeholder="Например, Основной фильтр"
                               PlaceholderColor="#8C93A8"
                               TextColor="#141414"
                               VerticalOptions="Center" />
                    </Border>
                </VerticalStackLayout>

                <!-- Device Type Picker -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Тип оборудования" TextColor="#141414" FontFamily="OpenSansSemibold" FontSize="14" />
                    <Border StrokeThickness="1" Stroke="#E4E7F4" StrokeShape="RoundRectangle 12" BackgroundColor="#FFFFFF" HeightRequest="50" Padding="14,0">
                        <Picker SelectedIndex="{Binding DeviceTypeIndex}"
                                TextColor="#141414"
                                Title="Выберите тип оборудования"
                                TitleColor="#8C93A8"
                                VerticalOptions="Center">
                            <Picker.ItemsSource>
                                <x:Array Type="{x:Type x:String}">
                                    <x:String>Фильтр / Помпа течения</x:String>
                                    <x:String>Термонагреватель (Heater)</x:String>
                                    <x:String>Аэратор / Компрессор</x:String>
                                    <x:String>Освещение / Фитолампа</x:String>
                                    <x:String>Автокормушка (Auto Feeder)</x:String>
                                </x:Array>
                            </Picker.ItemsSource>
                        </Picker>
                    </Border>
                </VerticalStackLayout>

                <!-- Connection Protocol Picker -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Протокол подключения" TextColor="#141414" FontFamily="OpenSansSemibold" FontSize="14" />
                    <Border StrokeThickness="1" Stroke="#E4E7F4" StrokeShape="RoundRectangle 12" BackgroundColor="#FFFFFF" HeightRequest="50" Padding="14,0">
                        <Picker SelectedIndex="{Binding ProtocolIndex}"
                                TextColor="#141414"
                                Title="Выберите протокол подключения"
                                TitleColor="#8C93A8"
                                VerticalOptions="Center">
                            <Picker.ItemsSource>
                                <x:Array Type="{x:Type x:String}">
                                    <x:String>Digital (GPIO)</x:String>
                                    <x:String>Analog (ADC)</x:String>
                                    <x:String>I2C</x:String>
                                    <x:String>OneWire</x:String>
                                </x:Array>
                            </Picker.ItemsSource>
                        </Picker>
                    </Border>
                </VerticalStackLayout>

                <!-- Connection Address -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Адрес подключения" TextColor="#141414" FontFamily="OpenSansSemibold" FontSize="14" />
                    <Border StrokeThickness="1" Stroke="#E4E7F4" StrokeShape="RoundRectangle 12" BackgroundColor="#FFFFFF" HeightRequest="50" Padding="14,0">
                        <Entry Text="{Binding Address}"
                               Placeholder="Например, GPIO 12"
                               PlaceholderColor="#8C93A8"
                               TextColor="#141414"
                               VerticalOptions="Center" />
                    </Border>
                    <!-- Quick Preset Badges -->
                    <HorizontalStackLayout Spacing="8" Margin="0,2,0,0">
                        <Button Text="GPIO 12"
                                Command="{Binding SelectAddressPresetCommand}"
                                CommandParameter="GPIO 12"
                                BackgroundColor="#EDEFFB"
                                TextColor="#4152B0"
                                FontSize="12"
                                HeightRequest="32"
                                Padding="10,0"
                                CornerRadius="8" />
                        <Button Text="GPIO 14"
                                Command="{Binding SelectAddressPresetCommand}"
                                CommandParameter="GPIO 14"
                                BackgroundColor="#EDEFFB"
                                TextColor="#4152B0"
                                FontSize="12"
                                HeightRequest="32"
                                Padding="10,0"
                                CornerRadius="8" />
                        <Button Text="ADC1_CH15"
                                Command="{Binding SelectAddressPresetCommand}"
                                CommandParameter="ADC1_CH15"
                                BackgroundColor="#EDEFFB"
                                TextColor="#4152B0"
                                FontSize="12"
                                HeightRequest="32"
                                Padding="10,0"
                                CornerRadius="8" />
                        <Button Text="1"
                                Command="{Binding SelectAddressPresetCommand}"
                                CommandParameter="1"
                                BackgroundColor="#EDEFFB"
                                TextColor="#4152B0"
                                FontSize="12"
                                HeightRequest="32"
                                Padding="10,0"
                                CornerRadius="8" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>

                <!-- Switches: Ручное управление & Тип контакта реле matching Figma -->
                <Border StrokeThickness="1" Stroke="#E4E7F4" StrokeShape="RoundRectangle 14" BackgroundColor="#FFFFFF" Padding="16,12" Margin="0,4,0,0">
                    <VerticalStackLayout Spacing="12">
                        <!-- Manual Control Switch -->
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                                <Label Text="Ручное" TextColor="#141414" FontFamily="OpenSansSemibold" FontSize="15" />
                                <Label Text="Управление" TextColor="#8C93A8" FontSize="12" />
                            </VerticalStackLayout>
                            <Switch Grid.Column="1" IsToggled="{Binding IsManualControl}" OnColor="#4152B0" ThumbColor="#FFFFFF" VerticalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="#F0F2F9" />

                        <!-- Contact Type Switch (Open/Closed) -->
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                                <Label Text="Открытый" TextColor="#141414" FontFamily="OpenSansSemibold" FontSize="15" />
                                <Label Text="Тип контакта реле (NO / NC)" TextColor="#8C93A8" FontSize="12" />
                            </VerticalStackLayout>
                            <Switch Grid.Column="1" IsToggled="{Binding IsOpenContact}" OnColor="#4152B0" ThumbColor="#FFFFFF" VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Single wide "Добавить реле" Button as in Figma -->
                <Button Text="Добавить реле"
                        Command="{Binding SaveCommand}"
                        BackgroundColor="#4152B0"
                        TextColor="#FFFFFF"
                        CornerRadius="14"
                        HeightRequest="52"
                        FontFamily="OpenSansSemibold"
                        FontSize="15"
                        Margin="0,8,0,0" />
            </VerticalStackLayout>
        </ScrollView>

        <!-- 2. SUCCESS SCREEN (Figma: Добавление реле. Успешно) -->
        <ScrollView IsVisible="{Binding IsSuccessOpen}">
            <VerticalStackLayout Spacing="20" Padding="24,30,24,30" VerticalOptions="Center">
                <!-- Fish Mascot Card with Checkmark badge -->
                <controls:FishMascotCard HeightOverride="220" BadgeText="✓" BadgeColor="#7BA028" />

                <!-- Created Relay Summary Card -->
                <Border StrokeThickness="1"
                        Stroke="#E4E7F4"
                        StrokeShape="RoundRectangle 14"
                        BackgroundColor="#FFFFFF"
                        Padding="16,14"
                        Margin="0,6,0,0">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Label Grid.Column="0" Text="{Binding CreatedRelayIcon}" FontSize="24" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label Text="{Binding CreatedRelayName}"
                                   TextColor="#141414"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="15"
                                   FontAttributes="Bold" />
                            <Label Text="{Binding CreatedRelaySubtitle}"
                                   TextColor="#8C93A8"
                                   FontSize="12" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="{Binding CreatedRelayStatus}" TextColor="#4CAF50" FontFamily="OpenSansSemibold" FontSize="12" VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- Success Header & Description -->
                <VerticalStackLayout Spacing="8" Margin="0,4,0,10">
                    <Label Text="Реле добавлено!"
                           TextColor="#141414"
                           FontFamily="OpenSansSemibold"
                           FontSize="22"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center" />
                    <Label Text="Связь с реле установлена. Перейдите в настройки сценариев, чтобы связать его с датчиками для автоматической работы"
                           TextColor="#6E6E6E"
                           FontSize="14"
                           LineHeight="1.3"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <!-- Action Buttons: "Вернуться к ёмкости" & "Добавить ещё реле" -->
                <VerticalStackLayout Spacing="10">
                    <Button Text="Вернуться к ёмкости"
                            Command="{Binding ReturnToAquariumCommand}"
                            BackgroundColor="#4152B0"
                            TextColor="#FFFFFF"
                            CornerRadius="14"
                            HeightRequest="52"
                            FontFamily="OpenSansSemibold"
                            FontSize="15" />

                    <Button Text="Добавить ещё реле"
                            Command="{Binding AddAnotherRelayCommand}"
                            BackgroundColor="#FFFFFF"
                            BorderColor="#4152B0"
                            BorderWidth="1.5"
                            TextColor="#4152B0"
                            CornerRadius="14"
                            HeightRequest="52"
                            FontFamily="OpenSansSemibold"
                            FontSize="15" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- 3. CANCEL CONFIRMATION MODAL (Figma: Добавление реле. Отмена) -->
        <Grid BackgroundColor="#80000000" IsVisible="{Binding IsCancelDialogOpen}">
            <Border VerticalOptions="End"
                    StrokeShape="RoundRectangle 24 24 0 0"
                    BackgroundColor="#FFFFFF"
                    StrokeThickness="0"
                    Padding="24,24,24,32">
                <VerticalStackLayout Spacing="18">
                    <!-- Fish Mascot Card with Question badge -->
                    <controls:FishMascotCard HeightOverride="180" BadgeText="?" BadgeColor="#7BA028" />

                    <!-- Titles -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Отменить добавление?"
                               TextColor="#141414"
                               FontFamily="OpenSansSemibold"
                               FontSize="20"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center" />
                        <Label Text="Все введённые данные будут потеряны"
                               TextColor="#6E6E6E"
                               FontSize="14"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>

                    <!-- Buttons: "Продолжить заполнение" & "Да, отменить" -->
                    <VerticalStackLayout Spacing="10" Margin="0,6,0,0">
                        <Button Text="Продолжить заполнение"
                                Command="{Binding ResumeEditingCommand}"
                                BackgroundColor="#4152B0"
                                TextColor="#FFFFFF"
                                CornerRadius="14"
                                HeightRequest="50"
                                FontFamily="OpenSansSemibold"
                                FontSize="15" />

                        <Button Text="Да, отменить"
                                Command="{Binding ConfirmCancelCommand}"
                                BackgroundColor="#FFFFFF"
                                BorderColor="#E4E7F4"
                                BorderWidth="1"
                                TextColor="#6A738A"
                                CornerRadius="14"
                                HeightRequest="50"
                                FontFamily="OpenSansSemibold"
                                FontSize="15" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
