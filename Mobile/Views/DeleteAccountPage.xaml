<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Mobile.ViewModels"
             x:Class="Mobile.Views.DeleteAccountPage"
             x:DataType="vm:DeleteAccountViewModel"
             BackgroundColor="#FFFFFF"
             Shell.NavBarIsVisible="False"
             Title="Удаление аккаунта">

    <Grid RowDefinitions="Auto,*,Auto" Padding="20,16,20,20">
        <!-- Back button header -->
        <Grid Grid.Row="0" Margin="0,4,0,10">
            <Border WidthRequest="38" HeightRequest="38"
                    StrokeShape="RoundRectangle 10"
                    BackgroundColor="#F6F7FC"
                    StrokeThickness="0"
                    HorizontalOptions="Start">
                <ImageButton Source="icon_chevron_left.png"
                             Command="{Binding CancelCommand}"
                             BackgroundColor="Transparent"
                             WidthRequest="20" HeightRequest="20"
                             Padding="0"
                             HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
        </Grid>

        <!-- Main Content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="16" VerticalOptions="Center">
                <!-- Mascot Illustration Container matching Figma 794:13332 -->
                <Border StrokeThickness="0"
                        StrokeShape="RoundRectangle 24"
                        BackgroundColor="#DDE4F8"
                        HeightRequest="280"
                        Margin="0,0,0,16">
                    <Grid HorizontalOptions="Center" VerticalOptions="Center">
                        <!-- Fish Mascot -->
                        <Image Source="fish_mascot.png"
                               WidthRequest="160"
                               HeightRequest="120"
                               Aspect="AspectFit"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />

                        <!-- Question badge -->
                        <Border WidthRequest="36" HeightRequest="36"
                                StrokeShape="RoundRectangle 10"
                                BackgroundColor="#7BA028"
                                StrokeThickness="0"
                                TranslationX="50"
                                TranslationY="-35"
                                HorizontalOptions="Center"
                                VerticalOptions="Center">
                            <Label Text="?"
                                   TextColor="#FFFFFF"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Warning Title -->
                <Label Text="Вы уверены, что хотите&#10;удалить аккаунт?"
                       TextColor="#141414"
                       FontFamily="OpenSansSemibold"
                       FontSize="22"
                       FontAttributes="Bold"
                       LineBreakMode="WordWrap" />

                <!-- Description -->
                <Label Text="Это действие нельзя отменить. Все ваши подключенные датчики, реле, настроенные сценарии автоматизации и история показаний будут безвозвратно удалены с сервера."
                       TextColor="#6E6E6E"
                       FontSize="14"
                       LineHeight="1.3"
                       LineBreakMode="WordWrap" />
            </VerticalStackLayout>
        </ScrollView>

        <!-- Action Buttons matching Figma -->
        <VerticalStackLayout Grid.Row="2" Spacing="12">
            <!-- Red Confirm Button -->
            <Button Text="Да, удалить аккаунт"
                    Command="{Binding ConfirmDeleteCommand}"
                    BackgroundColor="#B72B2B"
                    TextColor="#FFFFFF"
                    FontFamily="OpenSansSemibold"
                    FontSize="15"
                    HeightRequest="52"
                    CornerRadius="12" />

            <!-- Outline Cancel Button -->
            <Button Text="Нет, отменить"
                    Command="{Binding CancelCommand}"
                    BackgroundColor="Transparent"
                    TextColor="#4152B0"
                    BorderColor="#4152B0"
                    BorderWidth="1.5"
                    FontFamily="OpenSansSemibold"
                    FontSize="15"
                    HeightRequest="52"
                    CornerRadius="12" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
