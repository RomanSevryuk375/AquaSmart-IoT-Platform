<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Mobile.ViewModels"
             x:Class="Mobile.Views.EditProfilePage"
             x:DataType="vm:EditProfileViewModel"
             BackgroundColor="#FFFFFF"
             Shell.NavBarIsVisible="False"
             Title="Редактирование профиля">

    <Grid RowDefinitions="Auto,*,Auto" Padding="20,16,20,20">
        <!-- Top Bar: Back Button & Title matching Figma 742:11630 -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="0,4,0,20">
            <Border Grid.Column="0"
                    WidthRequest="38" HeightRequest="38"
                    StrokeShape="RoundRectangle 10"
                    BackgroundColor="#F6F7FC"
                    StrokeThickness="0">
                <ImageButton Source="icon_chevron_left.png"
                             Command="{Binding GoBackCommand}"
                             BackgroundColor="Transparent"
                             WidthRequest="20" HeightRequest="20"
                             Padding="0"
                             HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>

            <Label Grid.Column="1"
                   Text="Редактирование профиля"
                   TextColor="#141414"
                   FontFamily="OpenSansSemibold"
                   FontSize="18"
                   FontAttributes="Bold"
                   VerticalOptions="Center" />
        </Grid>

        <!-- Scrollable Inputs Form -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="20" Padding="0,0,0,20">
                <!-- Avatar with edit badge -->
                <VerticalStackLayout Spacing="8" HorizontalOptions="Center" Margin="0,0,0,10">
                    <Grid WidthRequest="90" HeightRequest="90" HorizontalOptions="Center">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ChangePhotoCommand}" />
                        </Grid.GestureRecognizers>

                        <!-- Avatar Circle -->
                        <Border StrokeThickness="0"
                                StrokeShape="RoundRectangle 45"
                                BackgroundColor="#DDE4F8"
                                HeightRequest="90"
                                WidthRequest="90">
                            <Grid>
                                <Image Source="{Binding AvatarPath}"
                                       Aspect="AspectFill"
                                       IsVisible="{Binding HasAvatar}"
                                       HorizontalOptions="Fill"
                                       VerticalOptions="Fill" />
                                <Label Text="{Binding Initials}"
                                       IsVisible="{Binding HasAvatar, Converter={StaticResource InverseBoolConverter}}"
                                       TextColor="#4152B0"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="32"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <!-- Edit Pencil Badge -->
                        <Border WidthRequest="28" HeightRequest="28"
                                StrokeShape="RoundRectangle 14"
                                BackgroundColor="#4152B0"
                                StrokeThickness="2"
                                Stroke="#FFFFFF"
                                HorizontalOptions="End"
                                VerticalOptions="End">
                            <Image Source="icon_edit.png"
                                   WidthRequest="14" HeightRequest="14"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                    </Grid>

                    <Label Text="{Binding FullName}"
                           TextColor="#141414"
                           FontFamily="OpenSansSemibold"
                           FontSize="18"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center" />

                    <Label Text="{Binding Email}"
                           TextColor="#6E6E6E"
                           FontSize="13"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <!-- Input: Имя -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Имя"
                           TextColor="#141414"
                           FontFamily="OpenSansSemibold"
                           FontSize="14" />
                    <Border StrokeThickness="1"
                            Stroke="#E4E7F4"
                            StrokeShape="RoundRectangle 12"
                            BackgroundColor="#FFFFFF"
                            HeightRequest="48"
                            Padding="14,0">
                        <Entry Text="{Binding FullName}"
                               TextColor="#141414"
                               VerticalOptions="Center" />
                    </Border>
                </VerticalStackLayout>

                <!-- Input: Почта -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Почта"
                           TextColor="#141414"
                           FontFamily="OpenSansSemibold"
                           FontSize="14" />
                    <Border StrokeThickness="1"
                            Stroke="#E4E7F4"
                            StrokeShape="RoundRectangle 12"
                            BackgroundColor="#FFFFFF"
                            HeightRequest="48"
                            Padding="14,0">
                        <Entry Text="{Binding Email}"
                               TextColor="#141414"
                               Keyboard="Email"
                               VerticalOptions="Center" />
                    </Border>
                </VerticalStackLayout>

                <!-- Input: Телефон -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Телефон"
                           TextColor="#141414"
                           FontFamily="OpenSansSemibold"
                           FontSize="14" />
                    <Border StrokeThickness="1"
                            Stroke="#E4E7F4"
                            StrokeShape="RoundRectangle 12"
                            BackgroundColor="#FFFFFF"
                            HeightRequest="48"
                            Padding="14,0">
                        <Entry Text="{Binding Phone}"
                               TextColor="#141414"
                               Keyboard="Telephone"
                               VerticalOptions="Center" />
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Save Button matching Figma -->
        <Button Grid.Row="2"
                Text="Сохранить изменения"
                Command="{Binding SaveProfileCommand}"
                BackgroundColor="#4152B0"
                TextColor="#FFFFFF"
                FontFamily="OpenSansSemibold"
                FontSize="15"
                HeightRequest="50"
                CornerRadius="12" />
    </Grid>
</ContentPage>
